<%# back_link: optional back link text + path
    title: page title
    subtitle: optional subtitle
    actions: optional block for action buttons %>

<% if defined?(back_link) && back_link %>
  <div class="mb-2">
    <%= link_to back_link[:label], back_link[:path], class: "text-sm font-semibold text-gray-500 hover:text-gray-900" %>
  </div>
<% end %>

<div class="flex flex-wrap items-end justify-between gap-4 mb-6">
  <div>
    <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= title %></h1>
    <% if defined?(subtitle) && subtitle %>
      <p class="mt-1 text-sm text-gray-500"><%= subtitle %></p>
    <% end %>
  </div>
  <% if defined?(actions) && actions %>
    <div class="flex items-center gap-3">
      <%= actions %>
    </div>
  <% end %>
</div>
