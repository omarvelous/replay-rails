<% if notice %>
  <div class="mb-4 rounded-md bg-green-50 p-4" data-controller="dismissable" data-dismissable-delay-value="4000">
    <div class="flex">
      <div class="shrink-0">
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5 text-green-400">
          <path d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" fill-rule="evenodd" />
        </svg>
      </div>
      <div class="ml-3">
        <p class="text-sm font-medium text-green-800"><%= notice %></p>
      </div>
      <div class="ml-auto pl-3">
        <button type="button" class="-mx-1.5 -my-1.5 inline-flex rounded-md bg-green-50 p-1.5 text-green-500 hover:bg-green-100" data-action="click->dismissable#dismiss">
          <span class="sr-only">Dismiss</span>
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5"><path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" /></svg>
        </button>
      </div>
    </div>
  </div>
<% end %>

<% if alert %>
  <div class="mb-4 rounded-md bg-red-50 p-4" data-controller="dismissable" data-dismissable-delay-value="8000">
    <div class="flex">
      <div class="shrink-0">
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5 text-red-400">
          <path d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM8.28 7.22a.75.75 0 0 0-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 1 0 1.06 1.06L10 11.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L11.06 10l1.72-1.72a.75.75 0 0 0-1.06-1.06L10 8.94 8.28 7.22Z" clip-rule="evenodd" fill-rule="evenodd" />
        </svg>
      </div>
      <div class="ml-3">
        <p class="text-sm font-medium text-red-800"><%= alert %></p>
      </div>
      <div class="ml-auto pl-3">
        <button type="button" class="-mx-1.5 -my-1.5 inline-flex rounded-md bg-red-50 p-1.5 text-red-500 hover:bg-red-100" data-action="click->dismissable#dismiss">
          <span class="sr-only">Dismiss</span>
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5"><path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" /></svg>
        </button>
      </div>
    </div>
  </div>
<% end %>
