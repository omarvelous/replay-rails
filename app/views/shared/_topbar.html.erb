<header class="navbar bg-base-100/85 backdrop-blur-lg border-b border-base-300 sticky top-0 z-20 px-6 min-h-[60px]">
  <div class="flex-1 flex items-baseline gap-3 min-w-0">
    <%# Mobile hamburger %>
    <label for="app-drawer" class="btn btn-ghost btn-square btn-sm lg:hidden">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/></svg>
    </label>

    <h1 class="text-lg font-semibold tracking-tight m-0 whitespace-nowrap">
      <%= content_for?(:page_title) ? yield(:page_title) : controller_name.titleize %>
    </h1>
    <% if content_for?(:page_subtitle) %>
      <span class="text-sm text-base-content/40 whitespace-nowrap overflow-hidden text-ellipsis hidden md:inline">
        <%= yield(:page_subtitle) %>
      </span>
    <% end %>
  </div>

  <div class="flex-none flex items-center gap-2.5">
    <% if content_for?(:page_actions) %>
      <%= yield(:page_actions) %>
    <% end %>
  </div>
</header>
