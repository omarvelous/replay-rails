<div class="mx-auto md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">Sign up</h1>

  <%= form_with model: @user, url: accounts_path, class: "contents" do |form| %>
    <% if @user.errors.any? %>
      <div id="error_explanation" class="alert alert-error my-4">
        <div>
          <ul class="list-disc list-inside text-sm">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <fieldset class="fieldset my-5">
      <%= form.label :first_name, "First name", class: "fieldset-label" %>
      <%= form.text_field :first_name, required: true, autofocus: true,
          class: "input input-bordered w-full" %>
    </fieldset>

    <fieldset class="fieldset my-5">
      <%= form.label :last_name, "Last name", class: "fieldset-label" %>
      <%= form.text_field :last_name, required: true,
          class: "input input-bordered w-full" %>
    </fieldset>

    <fieldset class="fieldset my-5">
      <%= form.label :email_address, "Email address", class: "fieldset-label" %>
      <%= form.email_field :email_address, required: true, autocomplete: "username",
          class: "input input-bordered w-full" %>
    </fieldset>

    <fieldset class="fieldset my-5">
      <%= form.label :phone, "Phone", class: "fieldset-label" %>
      <%= form.telephone_field :phone,
          class: "input input-bordered w-full" %>
    </fieldset>

    <fieldset class="fieldset my-5">
      <%= form.label :password, "Password", class: "fieldset-label" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password",
          class: "input input-bordered w-full" %>
    </fieldset>

    <fieldset class="fieldset my-5">
      <%= form.label :password_confirmation, "Password confirmation", class: "fieldset-label" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password",
          class: "input input-bordered w-full" %>
    </fieldset>

    <div class="flex items-center gap-4">
      <%= form.submit "Sign up", class: "btn btn-primary" %>
      <%= link_to "Already have an account? Sign in", new_session_path, class: "link link-hover text-sm" %>
    </div>
  <% end %>
</div>
