<% if listing.photos.any? %>
  <div class="photo-gallery -mx-4 mb-6 relative">
    <div class="flex overflow-x-auto snap-x snap-mandatory scroll-smooth" style="scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch;">
      <% listing.photos.each do |photo| %>
        <div class="flex-none w-full snap-center">
          <%= image_tag photo, class: "w-full aspect-video object-cover" %>
        </div>
      <% end %>
    </div>
    <% if listing.photos.size > 1 %>
      <div class="absolute bottom-3 right-3 px-2.5 py-1 rounded-full text-xs font-semibold text-white" style="background: rgba(0,0,0,0.5); backdrop-filter: blur(4px);">
        1 / <%= listing.photos.size %>
      </div>
    <% end %>
  </div>
<% else %>
  <% tone = %w[#2f6bff #0fb5a6 #7c5cff #e8990f #1f9d57][listing.id % 5] %>
  <div class="w-full aspect-video rounded-xl mb-6" style="background: linear-gradient(135deg, #0b0d12, <%= tone %>40);"></div>
<% end %>
