<%# Agent profile %>
<div class="flex items-center gap-5 mb-6">
  <div class="w-20 h-20 rounded-full bg-indigo-50 grid place-items-center text-xl font-bold text-indigo-600 shrink-0 overflow-hidden">
    <% if @agent.photo.attached? %>
      <%= image_tag @agent.photo, class: "w-full h-full object-cover" %>
    <% else %>
      <%= @agent.name.split.map(&:first).join.first(2).upcase %>
    <% end %>
  </div>
  <div>
    <h1 class="text-2xl font-extrabold tracking-tight"><%= @agent.name %></h1>
    <div class="flex flex-wrap gap-3 mt-1">
      <% if @agent.phone.present? %>
        <a href="tel:<%= @agent.phone %>" class="text-sm text-indigo-600 font-semibold hover:text-indigo-500"><%= @agent.phone %></a>
      <% end %>
      <a href="mailto:<%= @agent.email %>" class="text-sm text-indigo-600 font-semibold hover:text-indigo-500"><%= @agent.email %></a>
    </div>
  </div>
</div>

<%# Active listings %>
<% if @listings.any? %>
  <div class="border-t border-gray-200 pt-6 mb-6">
    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">Active Listings</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <% @listings.each do |listing| %>
        <%= link_to go_listing_path(listing), class: "rounded-lg bg-white ring-1 ring-gray-200 p-4 hover:shadow-md transition-shadow" do %>
          <% if listing.photos.any? %>
            <%= image_tag listing.photos.first.variant(:thumb), class: "w-full aspect-video object-cover rounded-md mb-3" %>
          <% else %>
            <div class="w-full aspect-video rounded-md mb-3 bg-gray-100"></div>
          <% end %>
          <p class="font-semibold text-sm"><%= number_to_currency(listing.price, precision: 0) %></p>
          <p class="text-xs text-gray-500 mt-0.5"><%= listing.address %></p>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>

<%# Lead form %>
<div class="border-t border-gray-200 pt-6">
  <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">Get in touch</h2>
  <%= render "go/leads/form",
      agent: @agent,
      scan_id: params[:scan_id] %>
</div>
