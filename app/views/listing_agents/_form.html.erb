<%= form_with model: listing_agent, url: (listing_agent.persisted? ? listing_agent_path(listing_agent) : listing_agents_path), class: "contents" do |form| %>
  <% if listing_agent.errors.any? %>
    <div id="error_explanation" class="alert alert-error my-4">
      <div>
        <ul class="list-disc list-inside text-sm">
          <% listing_agent.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <% if listing_agent.listing_id %>
    <%= form.hidden_field :listing_id %>
    <fieldset class="fieldset my-5">
      <%= form.label :agent_id, "Agent", class: "fieldset-label" %>
      <%= form.select :agent_id,
          Current.user.account.agents.order(:name).map { |a| [a.name, a.id] },
          { include_blank: "Select an agent" },
          required: true, class: "select select-bordered w-full" %>
    </fieldset>
  <% else %>
    <%= form.hidden_field :agent_id %>
    <fieldset class="fieldset my-5">
      <%= form.label :listing_id, "Listing", class: "fieldset-label" %>
      <%= form.select :listing_id,
          Current.user.account.listings.order(:address).map { |l| [l.address, l.id] },
          { include_blank: "Select a listing" },
          required: true, class: "select select-bordered w-full" %>
    </fieldset>
  <% end %>

  <fieldset class="fieldset my-5">
    <%= form.label :role, class: "fieldset-label" %>
    <%= form.select :role, [["Listing Agent", "listing_agent"], ["Selling Agent", "selling_agent"]],
        {}, class: "select select-bordered w-full" %>
  </fieldset>

  <div class="flex items-center gap-4">
    <%= form.submit class: "btn btn-primary" %>
    <button type="button" class="link link-hover text-sm" data-action="click->modal#close">Cancel</button>
  </div>
<% end %>
