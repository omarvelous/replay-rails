<div id="<%= dom_id(la) %>" class="flex items-center gap-3 px-4 py-3 hover:bg-gray-50 transition-colors">
  <div class="w-10 h-10 rounded-full flex-none grid place-items-center text-sm font-bold bg-indigo-50 text-indigo-600">
    <%= la.agent.name.split.map(&:first).join.first(2).upcase %>
  </div>
  <div class="flex-1 min-w-0">
    <%= link_to agent_path(la.agent), class: "hover:underline" do %>
      <p class="text-sm font-medium truncate"><%= la.agent.name %></p>
    <% end %>
    <p class="text-xs text-gray-400"><%= la.role.titleize %></p>
  </div>
  <div class="flex items-center gap-0.5 shrink-0">
    <%= link_to edit_listing_listing_agent_path(la.listing, la), class: "text-gray-400 hover:text-gray-600 p-1", data: { turbo_frame: "modal" }, title: "Edit" do %>
      <svg viewBox="0 0 20 20" fill="currentColor" class="size-4"><path d="m5.433 13.917 1.262-3.155A4 4 0 0 1 7.58 9.42l6.92-6.918a2.121 2.121 0 0 1 3 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 0 1-.65-.65Z"/><path d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0 0 10 3H4.75A2.75 2.75 0 0 0 2 5.75v9.5A2.75 2.75 0 0 0 4.75 18h9.5A2.75 2.75 0 0 0 17 15.25V10a.75.75 0 0 0-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5Z"/></svg>
    <% end %>
    <%= button_to listing_listing_agent_path(la.listing, la), method: :delete, class: "text-gray-400 hover:text-red-500 p-1", title: "Remove", data: { turbo_confirm: "Remove this agent?" } do %>
      <svg viewBox="0 0 20 20" fill="currentColor" class="size-4"><path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"/></svg>
    <% end %>
  </div>
</div>
