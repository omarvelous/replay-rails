<div class="flex justify-between items-center mb-3 mt-8">
  <h2 class="font-bold text-2xl"><%= listing ? "Agents" : "Listings" %></h2>
  <% if listing %>
    <%= link_to "Add Agent", new_listing_agent_path(listing_id: listing.id), class: "btn btn-primary btn-sm", data: { turbo_frame: "modal" } %>
  <% end %>
</div>

<% if listing_agents.any? %>
  <div class="overflow-x-auto">
    <table class="table">
      <thead>
        <tr>
          <% if listing %>
            <th>Agent</th>
          <% else %>
            <th>Listing</th>
          <% end %>
          <th>Role</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% listing_agents.each do |la| %>
          <tr>
            <% if listing %>
              <td><%= link_to la.agent.name, agent_path(la.agent), class: "link", data: { turbo_frame: "_top" } %></td>
            <% else %>
              <td><%= link_to la.listing.address, listing_path(la.listing), class: "link", data: { turbo_frame: "_top" } %></td>
            <% end %>
            <td><%= la.role.titleize %></td>
            <td class="text-right">
              <% if listing %>
                <%= link_to "Edit", edit_listing_agent_path(la), class: "link link-hover text-sm mr-2", data: { turbo_frame: "modal" } %>
              <% end %>
              <%= button_to "Remove", listing_agent_path(la), method: :delete,
                  class: "btn btn-error btn-xs",
                  data: { turbo_confirm: "Remove this association?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-base-content/60">
    <%= listing ? "No agents assigned to this listing yet." : "No listings assigned to this agent yet." %>
  </p>
<% end %>
