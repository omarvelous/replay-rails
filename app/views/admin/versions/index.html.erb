<header class="main-content__header">
  <h1 class="main-content__page-title">Activity Log</h1>
</header>

<section class="main-content__body">
  <%# Filters %>
  <div style="display: flex; gap: 12px; margin-bottom: 20px; flex-wrap: wrap;">
    <%= form_with url: admin_versions_path, method: :get, style: "display: flex; gap: 8px; flex-wrap: wrap;" do |f| %>
      <%= f.select :item_type,
          options_for_select(
            [["All types", ""]] + PaperTrail::Version.distinct.pluck(:item_type).sort.map { |t| [t.demodulize.underscore.humanize, t] },
            params[:item_type]
          ),
          {},
          style: "padding: 6px 10px; border: 1px solid #ddd; border-radius: 4px; font-size: 13px;",
          onchange: "this.form.requestSubmit()" %>

      <%= f.select :event,
          options_for_select(
            [["All events", ""], ["Create", "create"], ["Update", "update"], ["Destroy", "destroy"]],
            params[:event]
          ),
          {},
          style: "padding: 6px 10px; border: 1px solid #ddd; border-radius: 4px; font-size: 13px;",
          onchange: "this.form.requestSubmit()" %>

      <% if params[:item_type].present? || params[:event].present? || params[:account_id].present? %>
        <%= link_to "Clear", admin_versions_path, style: "padding: 6px 10px; font-size: 13px; color: #666; text-decoration: none;" %>
      <% end %>
    <% end %>
  </div>

  <%# Results %>
  <div style="background: #fff; border: 1px solid #e8e8e8; border-radius: 6px;">
    <table style="width: 100%; border-collapse: collapse;">
      <thead>
        <tr style="border-bottom: 2px solid #eee;">
          <th style="padding: 10px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #888; text-transform: uppercase;">When</th>
          <th style="padding: 10px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #888; text-transform: uppercase;">Event</th>
          <th style="padding: 10px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #888; text-transform: uppercase;">Type</th>
          <th style="padding: 10px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #888; text-transform: uppercase;">ID</th>
          <th style="padding: 10px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #888; text-transform: uppercase;">Who</th>
          <th style="padding: 10px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #888; text-transform: uppercase;">Changes</th>
          <th style="padding: 10px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #888; text-transform: uppercase;">Account</th>
        </tr>
      </thead>
      <tbody>
        <% @versions.each do |version| %>
          <tr style="border-bottom: 1px solid #f0f0f0;">
            <td style="padding: 10px 16px; font-size: 13px; color: #666; white-space: nowrap;">
              <%= version.created_at.strftime("%b %-d, %-I:%M %p") %>
            </td>
            <td style="padding: 10px 16px; font-size: 13px;">
              <% color = { "create" => "#22c55e", "update" => "#3b82f6", "destroy" => "#ef4444" }[version.event] %>
              <span style="display: inline-flex; align-items: center; gap: 6px;">
                <span style="width: 7px; height: 7px; border-radius: 50%; background: <%= color %>;"></span>
                <%= version.event.capitalize %>
              </span>
            </td>
            <td style="padding: 10px 16px; font-size: 13px; font-weight: 500;">
              <%= version.item_type.demodulize.underscore.humanize %>
            </td>
            <td style="padding: 10px 16px; font-size: 13px; font-family: monospace; color: #888;">
              <%= version.item_id %>
            </td>
            <td style="padding: 10px 16px; font-size: 13px;">
              <% who = version.whodunnit.present? ? User.find_by(id: version.whodunnit) : nil %>
              <%= who ? "#{who.first_name} #{who.last_name}" : "System" %>
            </td>
            <td style="padding: 10px 16px; font-size: 12px; color: #999; max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
              <% if version.object_changes.present? %>
                <%= version.object_changes.keys.reject { |k| k == "updated_at" }.join(", ") %>
              <% else %>
                —
              <% end %>
            </td>
            <td style="padding: 10px 16px; font-size: 12px; color: #aaa;">
              <% if version.account_id %>
                #<%= version.account_id %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# Pagination %>
  <% if @pagy.pages > 1 %>
    <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 16px;">
      <span style="font-size: 13px; color: #888;">
        Showing <%= @pagy.from %>–<%= @pagy.to %> of <%= @pagy.count %>
      </span>
      <div style="display: flex; gap: 4px;">
        <% if @pagy.prev %>
          <%= link_to "← Prev", url_for(page: @pagy.prev), style: "padding: 6px 12px; border: 1px solid #ddd; border-radius: 4px; font-size: 13px; color: #333; text-decoration: none;" %>
        <% end %>
        <% if @pagy.next %>
          <%= link_to "Next →", url_for(page: @pagy.next), style: "padding: 6px 12px; border: 1px solid #ddd; border-radius: 4px; font-size: 13px; color: #333; text-decoration: none;" %>
        <% end %>
      </div>
    </div>
  <% end %>
</section>
