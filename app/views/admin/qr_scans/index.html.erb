<h1 class="text-2xl font-bold text-gray-900 mb-6">QR Scans</h1>

<div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 overflow-x-auto">
  <table class="min-w-full divide-y divide-gray-300">
    <thead>
      <tr>
        <th class="px-4 py-3 text-left text-sm font-semibold text-gray-900">ID</th>
        <th class="px-4 py-3 text-left text-sm font-semibold text-gray-900">QR Code</th>
        <th class="px-4 py-3 text-left text-sm font-semibold text-gray-900">Account</th>
        <th class="px-4 py-3 text-left text-sm font-semibold text-gray-900">Ad</th>
        <th class="px-4 py-3 text-left text-sm font-semibold text-gray-900">Screen</th>
        <th class="px-4 py-3 text-left text-sm font-semibold text-gray-900">Qualified</th>
        <th class="px-4 py-3 text-left text-sm font-semibold text-gray-900">IP</th>
        <th class="px-4 py-3 text-left text-sm font-semibold text-gray-900">Scanned at</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      <% @qr_scans.each do |scan| %>
        <tr>
          <td class="px-4 py-3 text-sm text-gray-500">
            <%= link_to scan.id, admin_qr_scan_path(scan), class: "text-indigo-600 hover:text-indigo-900" %>
          </td>
          <td class="px-4 py-3 text-sm text-gray-500 font-mono">
            <%= link_to scan.qr_code.token, admin_qr_code_path(scan.qr_code), class: "text-indigo-600 hover:text-indigo-900" %>
          </td>
          <td class="px-4 py-3 text-sm text-gray-500">
            <%= link_to "Account ##{scan.account_id}", admin_account_path(scan.account), class: "text-indigo-600 hover:text-indigo-900" %>
          </td>
          <td class="px-4 py-3 text-sm text-gray-500"><%= scan.ad&.headline || "—" %></td>
          <td class="px-4 py-3 text-sm text-gray-500"><%= scan.screen&.name || "—" %></td>
          <td class="px-4 py-3 text-sm">
            <% if scan.ad_id.present? && scan.screen_id.present? %>
              <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">Yes</span>
            <% else %>
              <span class="inline-flex items-center rounded-full bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/10">No</span>
            <% end %>
          </td>
          <td class="px-4 py-3 text-sm text-gray-500"><%= scan.ip_address || "—" %></td>
          <td class="px-4 py-3 text-sm text-gray-500"><%= time_ago_in_words(scan.created_at) %> ago</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
