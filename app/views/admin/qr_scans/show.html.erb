<%= link_to "← Back to QR scans", admin_qr_scans_path, class: "text-sm text-gray-500 hover:text-gray-700 mb-4 inline-block" %>

<h1 class="text-2xl font-bold text-gray-900 mb-6">QR Scan #<%= @qr_scan.id %></h1>

<div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
  <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4">
    <div>
      <dt class="text-sm font-semibold text-gray-900">QR Code</dt>
      <dd class="text-sm text-gray-500 font-mono">
        <%= link_to @qr_scan.qr_code.token, admin_qr_code_path(@qr_scan.qr_code), class: "text-indigo-600 hover:text-indigo-900" %>
      </dd>
    </div>
    <div>
      <dt class="text-sm font-semibold text-gray-900">Account</dt>
      <dd class="text-sm text-gray-500">
        <%= link_to "Account ##{@qr_scan.account_id}", admin_account_path(@qr_scan.account), class: "text-indigo-600 hover:text-indigo-900" %>
      </dd>
    </div>
    <div>
      <dt class="text-sm font-semibold text-gray-900">Ad</dt>
      <dd class="text-sm text-gray-500"><%= @qr_scan.ad&.headline || "—" %></dd>
    </div>
    <div>
      <dt class="text-sm font-semibold text-gray-900">Screen</dt>
      <dd class="text-sm text-gray-500"><%= @qr_scan.screen&.name || "—" %></dd>
    </div>
    <div>
      <dt class="text-sm font-semibold text-gray-900">Qualified</dt>
      <dd class="text-sm">
        <% if @qr_scan.ad_id.present? && @qr_scan.screen_id.present? %>
          <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">Yes</span>
        <% else %>
          <span class="inline-flex items-center rounded-full bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/10">No</span>
        <% end %>
      </dd>
    </div>
    <div>
      <dt class="text-sm font-semibold text-gray-900">IP</dt>
      <dd class="text-sm text-gray-500"><%= @qr_scan.ip_address || "—" %></dd>
    </div>
    <div>
      <dt class="text-sm font-semibold text-gray-900">User agent</dt>
      <dd class="text-sm text-gray-500 break-all"><%= @qr_scan.user_agent || "—" %></dd>
    </div>
    <div>
      <dt class="text-sm font-semibold text-gray-900">Context</dt>
      <dd class="text-sm text-gray-500 font-mono">
        <% if @qr_scan.context.present? %>
          <pre class="whitespace-pre-wrap text-xs"><%= JSON.pretty_generate(@qr_scan.context) %></pre>
        <% else %>
          &mdash;
        <% end %>
      </dd>
    </div>
    <div>
      <dt class="text-sm font-semibold text-gray-900">Scanned at</dt>
      <dd class="text-sm text-gray-500"><%= @qr_scan.created_at.strftime("%B %d, %Y at %l:%M %p") %></dd>
    </div>
  </dl>
</div>
