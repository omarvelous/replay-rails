<%= link_to "← Back to accounts", admin_accounts_path, class: "text-sm text-gray-500 hover:text-gray-700 mb-4 inline-block" %>

<h1 class="text-2xl font-bold text-gray-900 mb-6">Account #<%= @account.id %></h1>

<div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
  <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4">
    <div>
      <dt class="text-sm font-semibold text-gray-900">Users</dt>
      <dd class="text-sm text-gray-500"><%= @account.users.size %></dd>
    </div>
    <div>
      <dt class="text-sm font-semibold text-gray-900">Sites</dt>
      <dd class="text-sm text-gray-500"><%= @account.sites.size %></dd>
    </div>
    <div>
      <dt class="text-sm font-semibold text-gray-900">Screens</dt>
      <dd class="text-sm text-gray-500"><%= @account.screens.size %></dd>
    </div>
    <div>
      <dt class="text-sm font-semibold text-gray-900">Ads</dt>
      <dd class="text-sm text-gray-500"><%= @account.ads.size %></dd>
    </div>
    <div>
      <dt class="text-sm font-semibold text-gray-900">QR Codes</dt>
      <dd class="text-sm text-gray-500"><%= @account.qr_codes.size %></dd>
    </div>
    <div>
      <dt class="text-sm font-semibold text-gray-900">Created</dt>
      <dd class="text-sm text-gray-500"><%= @account.created_at.strftime("%B %d, %Y at %l:%M %p") %></dd>
    </div>
  </dl>
</div>
