<h1 class="text-2xl font-bold text-gray-900 mb-6">QR Codes</h1>

<div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 overflow-x-auto">
  <table class="min-w-full divide-y divide-gray-300">
    <thead>
      <tr>
        <th class="px-4 py-3 text-left text-sm font-semibold text-gray-900">Token</th>
        <th class="px-4 py-3 text-left text-sm font-semibold text-gray-900">Account</th>
        <th class="px-4 py-3 text-left text-sm font-semibold text-gray-900">Destination</th>
        <th class="px-4 py-3 text-left text-sm font-semibold text-gray-900">Scans</th>
        <th class="px-4 py-3 text-left text-sm font-semibold text-gray-900">Active</th>
        <th class="px-4 py-3 text-left text-sm font-semibold text-gray-900">Created</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      <% @qr_codes.each do |qr_code| %>
        <tr>
          <td class="px-4 py-3 text-sm text-gray-500 font-mono">
            <%= link_to qr_code.token, admin_qr_code_path(qr_code), class: "text-indigo-600 hover:text-indigo-900" %>
          </td>
          <td class="px-4 py-3 text-sm text-gray-500">
            <%= link_to "Account ##{qr_code.account_id}", admin_account_path(qr_code.account), class: "text-indigo-600 hover:text-indigo-900" %>
          </td>
          <td class="px-4 py-3 text-sm text-gray-500">
            <% if qr_code.destination_record %>
              <%= qr_code.destination_record_type %> &mdash; <%= qr_code.destination_record.try(:address) || qr_code.destination_record.try(:name) %>
            <% elsif qr_code.destination_url.present? %>
              <%= truncate(qr_code.destination_url, length: 40) %>
            <% else %>
              &mdash;
            <% end %>
          </td>
          <td class="px-4 py-3 text-sm text-gray-500"><%= qr_code.scans.qualified.count %></td>
          <td class="px-4 py-3 text-sm">
            <% if qr_code.active? %>
              <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">Yes</span>
            <% else %>
              <span class="inline-flex items-center rounded-full bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/10">No</span>
            <% end %>
          </td>
          <td class="px-4 py-3 text-sm text-gray-500"><%= time_ago_in_words(qr_code.created_at) %> ago</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
