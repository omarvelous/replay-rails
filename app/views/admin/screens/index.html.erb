<h1 class="text-2xl font-bold text-gray-900 mb-6">Screens</h1>

<div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 overflow-x-auto">
  <table class="min-w-full divide-y divide-gray-300">
    <thead>
      <tr>
        <th class="px-4 py-3 text-left text-sm font-semibold text-gray-900">Name</th>
        <th class="px-4 py-3 text-left text-sm font-semibold text-gray-900">Account</th>
        <th class="px-4 py-3 text-left text-sm font-semibold text-gray-900">Site</th>
        <th class="px-4 py-3 text-left text-sm font-semibold text-gray-900">Player status</th>
        <th class="px-4 py-3 text-left text-sm font-semibold text-gray-900">Orientation</th>
        <th class="px-4 py-3 text-left text-sm font-semibold text-gray-900">Created</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      <% @screens.each do |screen| %>
        <tr>
          <td class="px-4 py-3 text-sm text-gray-500">
            <%= link_to screen.name, admin_screen_path(screen), class: "text-indigo-600 hover:text-indigo-900" %>
          </td>
          <td class="px-4 py-3 text-sm text-gray-500">Account #<%= screen.site.account_id %></td>
          <td class="px-4 py-3 text-sm text-gray-500"><%= screen.site.name %></td>
          <td class="px-4 py-3 text-sm">
            <% if screen.online? %>
              <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">Online</span>
            <% elsif screen.paired? %>
              <span class="inline-flex items-center rounded-full bg-red-50 px-2 py-1 text-xs font-medium text-red-700 ring-1 ring-inset ring-red-600/20">Offline</span>
            <% else %>
              <span class="inline-flex items-center rounded-full bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/10">Unpaired</span>
            <% end %>
          </td>
          <td class="px-4 py-3 text-sm text-gray-500 capitalize"><%= screen.orientation %></td>
          <td class="px-4 py-3 text-sm text-gray-500"><%= time_ago_in_words(screen.created_at) %> ago</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
