<header class="main-content__header">
  <h1 class="main-content__page-title">Platform Dashboard</h1>
</header>

<section class="main-content__body">
  <h2 style="font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #999; margin-bottom: 12px;">Infrastructure</h2>
  <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 32px;">
    <div style="background: #fff; border: 1px solid #e8e8e8; border-radius: 6px; padding: 20px;">
      <div style="font-size: 32px; font-weight: 700; font-variant-numeric: tabular-nums;"><%= @total_accounts %></div>
      <div style="font-size: 13px; color: #888;">Accounts</div>
    </div>
    <div style="background: #fff; border: 1px solid #e8e8e8; border-radius: 6px; padding: 20px;">
      <div style="font-size: 32px; font-weight: 700; font-variant-numeric: tabular-nums;">
        <span style="color: #22c55e;"><%= @players_online %></span>
        <span style="color: #ccc; font-size: 18px; font-weight: 500;">/ <%= @total_players %></span>
      </div>
      <div style="font-size: 13px; color: #888;">Players online</div>
    </div>
    <div style="background: #fff; border: 1px solid #e8e8e8; border-radius: 6px; padding: 20px;">
      <div style="font-size: 32px; font-weight: 700; font-variant-numeric: tabular-nums;"><%= @total_screens %></div>
      <div style="font-size: 13px; color: #888;">Screens</div>
    </div>
    <div style="background: #fff; border: 1px solid #e8e8e8; border-radius: 6px; padding: 20px;">
      <div style="font-size: 32px; font-weight: 700; font-variant-numeric: tabular-nums;"><%= @total_qr_codes %></div>
      <div style="font-size: 13px; color: #888;">QR Codes</div>
    </div>
  </div>

  <h2 style="font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #999; margin-bottom: 12px;">Funnel</h2>
  <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 16px;">
    <div style="background: #fff; border: 1px solid #e8e8e8; border-radius: 6px; padding: 20px;">
      <div style="font-size: 13px; color: #888; margin-bottom: 4px;">Impressions</div>
      <div style="font-size: 32px; font-weight: 700; font-variant-numeric: tabular-nums;"><%= number_with_delimiter(@total_impressions) %></div>
      <div style="font-size: 12px; color: #aaa; margin-top: 4px;"><%= number_with_delimiter(@impressions_today) %> today</div>
    </div>
    <div style="background: #fff; border: 1px solid #e8e8e8; border-radius: 6px; padding: 20px;">
      <div style="font-size: 13px; color: #888; margin-bottom: 4px;">Scans</div>
      <div style="font-size: 32px; font-weight: 700; font-variant-numeric: tabular-nums;"><%= number_with_delimiter(@total_scans) %></div>
      <div style="font-size: 12px; color: #aaa; margin-top: 4px;"><%= @scans_today %> today</div>
    </div>
    <div style="background: #fff; border: 1px solid #e8e8e8; border-radius: 6px; padding: 20px;">
      <div style="font-size: 13px; color: #888; margin-bottom: 4px;">Leads</div>
      <div style="font-size: 32px; font-weight: 700; font-variant-numeric: tabular-nums;"><%= @total_leads %></div>
      <div style="font-size: 12px; color: #aaa; margin-top: 4px;">
        <%= @leads_this_week %> this week
        <% if @leads_unread > 0 %>
          <span style="background: #ef4444; color: #fff; font-size: 10px; padding: 1px 5px; border-radius: 8px; margin-left: 4px;"><%= @leads_unread %> new</span>
        <% end %>
      </div>
    </div>
    <div style="background: #fff; border: 1px solid #e8e8e8; border-radius: 6px; padding: 20px;">
      <div style="font-size: 13px; color: #888; margin-bottom: 4px;">Conversion</div>
      <div style="font-size: 32px; font-weight: 700; font-variant-numeric: tabular-nums;"><%= @total_scans > 0 ? number_to_percentage(@total_leads.to_f / @total_scans * 100, precision: 1) : "—" %></div>
      <div style="font-size: 12px; color: #aaa; margin-top: 4px;">scan &rarr; lead</div>
    </div>
  </div>

  <div style="background: #fff; border: 1px solid #e8e8e8; border-radius: 6px; padding: 20px; margin-bottom: 32px;">
    <div style="font-size: 14px; font-weight: 600; color: #333; margin-bottom: 12px;">Platform activity (30 days)</div>
    <%= line_chart [
      { name: "Impressions", data: Impression.where("created_at > ?", 30.days.ago).group_by_day(:created_at).count },
      { name: "Scans", data: QrScan.qualified.where("created_at > ?", 30.days.ago).group_by_day(:created_at).count },
      { name: "Leads", data: Lead.where("created_at > ?", 30.days.ago).group_by_day(:created_at).count }
    ], library: { scales: { y: { beginAtZero: true } } } %>
  </div>

  <h2 style="font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #999; margin-bottom: 12px;">Content</h2>
  <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;">
    <div style="background: #fff; border: 1px solid #e8e8e8; border-radius: 6px; padding: 20px;">
      <div style="font-size: 13px; color: #888; margin-bottom: 4px;">Listings</div>
      <div style="font-size: 32px; font-weight: 700; font-variant-numeric: tabular-nums;"><%= @total_listings %></div>
    </div>
    <div style="background: #fff; border: 1px solid #e8e8e8; border-radius: 6px; padding: 20px;">
      <div style="font-size: 13px; color: #888; margin-bottom: 4px;">Ads</div>
      <div style="font-size: 32px; font-weight: 700; font-variant-numeric: tabular-nums;"><%= @total_ads %></div>
    </div>
    <div style="background: #fff; border: 1px solid #e8e8e8; border-radius: 6px; padding: 20px;">
      <div style="font-size: 13px; color: #888; margin-bottom: 4px;">Playlists</div>
      <div style="font-size: 32px; font-weight: 700; font-variant-numeric: tabular-nums;"><%= @total_playlists %></div>
    </div>
    <div style="background: #fff; border: 1px solid #e8e8e8; border-radius: 6px; padding: 20px;">
      <div style="font-size: 13px; color: #888; margin-bottom: 4px;">Agents</div>
      <div style="font-size: 32px; font-weight: 700; font-variant-numeric: tabular-nums;"><%= Agent.count %></div>
    </div>
  </div>

  <h2 style="font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #999; margin-bottom: 12px; margin-top: 32px;">Recent Activity</h2>
  <div style="background: #fff; border: 1px solid #e8e8e8; border-radius: 6px;">
    <% if @recent_versions.any? %>
      <% @recent_versions.each_with_index do |version, i| %>
        <div style="padding: 12px 20px; display: flex; align-items: flex-start; gap: 10px; <%= i < @recent_versions.size - 1 ? 'border-bottom: 1px solid #f0f0f0;' : '' %>">
          <% color = version.event == 'create' ? '#22c55e' : version.event == 'destroy' ? '#ef4444' : '#3b82f6' %>
          <span style="width: 8px; height: 8px; border-radius: 50%; background: <%= color %>; margin-top: 5px; flex-shrink: 0;"></span>
          <div style="flex: 1; min-width: 0;">
            <div style="font-size: 13px; color: #333;">
              <% who = version.whodunnit.present? ? User.find_by(id: version.whodunnit) : nil %>
              <strong><%= who ? "#{who.first_name} #{who.last_name}" : "System" %></strong>
              <%= version.event %>d
              <span style="color: #666;"><%= version.item_type.demodulize.underscore.humanize.downcase %></span>
              <span style="color: #aaa;">#<%= version.item_id %></span>
            </div>
            <% if version.event == 'update' && version.object_changes.present? %>
              <div style="font-size: 11px; color: #aaa; margin-top: 2px;">
                Changed: <%= version.object_changes.keys.reject { |k| k == 'updated_at' }.join(', ') %>
              </div>
            <% end %>
            <div style="font-size: 11px; color: #bbb; margin-top: 2px;"><%= time_ago_in_words(version.created_at) %> ago</div>
          </div>
          <% if version.account_id %>
            <span style="font-size: 10px; color: #aaa; background: #f5f5f5; padding: 1px 6px; border-radius: 4px;">Acct #<%= version.account_id %></span>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div style="padding: 20px; text-align: center; color: #999; font-size: 13px;">No activity yet.</div>
    <% end %>
  </div>
</section>
