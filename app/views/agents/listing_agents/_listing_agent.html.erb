<tr id="<%= dom_id(la) %>">
  <td class="px-3 py-4"><%= link_to la.listing.address, listing_path(la.listing), class: "font-semibold text-indigo-600 hover:text-indigo-500", data: { turbo_frame: "_top" } %></td>
  <td class="px-3 py-4"><%= la.role.titleize %></td>
  <td class="px-3 py-4 text-right">
    <%= button_to "Remove", agent_listing_agent_path(la.agent, la), method: :delete,
        class: "rounded-md bg-white px-2 py-1 text-xs font-semibold text-red-600 shadow-xs ring-1 ring-red-300 ring-inset hover:bg-red-50",
        data: { turbo_confirm: "Remove this listing?" } %>
  </td>
</tr>
