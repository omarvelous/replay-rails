<tr id="<%= dom_id(la) %>">
  <td><%= link_to la.listing.address, listing_path(la.listing), class: "link", data: { turbo_frame: "_top" } %></td>
  <td><%= la.role.titleize %></td>
  <td class="text-right">
    <%= link_to "Edit", edit_agent_listing_agent_path(la.agent, la), class: "link link-hover text-sm mr-2", data: { turbo_frame: "modal" } %>
    <%= button_to "Remove", agent_listing_agent_path(la.agent, la), method: :delete,
        class: "btn btn-error btn-xs",
        data: { turbo_confirm: "Remove this listing?" } %>
  </td>
</tr>
