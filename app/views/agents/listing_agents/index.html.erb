<%= turbo_frame_tag "listing_agents" do %>
  <div class="flex justify-between items-center mb-3 mt-8">
    <h2 class="font-bold text-2xl">Listings</h2>
  </div>

  <% if @listing_agents.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-300">
        <thead>
          <tr>
            <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Listing</th>
            <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Role</th>
            <th class="px-3 py-3.5 text-right text-sm font-semibold text-gray-900"></th>
          </tr>
        </thead>
        <tbody id="listing_agents_rows" class="divide-y divide-gray-200">
          <% @listing_agents.each do |la| %>
            <%= render "agents/listing_agents/listing_agent", la: la %>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-gray-500">No listings assigned to this agent yet.</p>
  <% end %>
<% end %>
