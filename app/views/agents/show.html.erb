<% actions = capture do %>
  <%= link_to edit_agent_path(@agent), class: "rounded-md bg-white px-2.5 py-1.5 text-sm font-semibold text-gray-900 shadow-xs ring-1 ring-gray-300 ring-inset hover:bg-gray-50 inline-flex items-center gap-1.5" do %>
    Edit
  <% end %>
<% end %>
<%= render "shared/page_header", title: @agent.name, subtitle: "Agent", actions: actions, back_link: { label: "← Agents", path: agents_path } %>

<div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-5 items-start">
  <%# Main column %>
  <div class="flex flex-col gap-5">
    <%# Profile card %>
    <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-6">
      <div class="flex items-start gap-4">
        <div class="size-16 rounded-full bg-indigo-50 grid place-items-center text-xl font-bold text-indigo-600 shrink-0">
          <%= @agent.name.split.map(&:first).join.first(2).upcase %>
        </div>
        <div class="flex-1 min-w-0">
          <h2 class="text-xl font-bold tracking-tight"><%= @agent.name %></h2>
          <p class="text-sm text-gray-500 mt-0.5">Real Estate Agent</p>

          <div class="flex flex-wrap gap-x-5 gap-y-2 mt-4 text-sm text-gray-600">
            <div class="flex items-center gap-2">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-4 text-gray-400"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
              <%= @agent.email %>
            </div>
            <% if @agent.phone.present? %>
              <div class="flex items-center gap-2">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-4 text-gray-400"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
                <%= @agent.phone %>
              </div>
            <% end %>
          </div>

          <% if @agent.user %>
            <div class="flex items-center gap-2 mt-3 text-sm">
              <span class="inline-flex items-center rounded-full bg-indigo-50 px-2.5 py-0.5 text-xs font-medium text-indigo-700 ring-1 ring-indigo-600/20 ring-inset">
                Linked to <%= @agent.user.first_name %> <%= @agent.user.last_name %>
              </span>
            </div>
          <% end %>
        </div>
      </div>

      <div class="flex gap-3 mt-5 pt-5 border-t border-gray-100">
        <button class="rounded-md bg-white px-3 py-1.5 text-sm font-semibold text-gray-900 shadow-xs ring-1 ring-gray-300 ring-inset hover:bg-gray-50 flex-1">Message</button>
        <button class="rounded-md bg-white px-3 py-1.5 text-sm font-semibold text-gray-900 shadow-xs ring-1 ring-gray-300 ring-inset hover:bg-gray-50 flex-1">Call</button>
      </div>
    </div>

    <%# Listings section %>
    <% listings = @agent.listings.distinct %>
    <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5">
      <div class="p-4 border-b border-gray-200">
        <h3 class="text-sm font-semibold">Listings</h3>
      </div>
      <% if listings.any? %>
        <div class="divide-y divide-gray-100">
          <% listings.each do |listing| %>
            <% tone = %w[#2f6bff #0fb5a6 #7c5cff #e8990f #1f9d57 #e5484d][listing.id % 6] %>
            <%= link_to listing_path(listing), class: "flex items-center gap-3 px-4 py-3 hover:bg-gray-50 transition-colors" do %>
              <div class="w-12 h-9 rounded flex-none" style="background: <%= tone %>22;"></div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium truncate"><%= listing.address %></p>
                <p class="text-xs text-gray-400"><%= number_to_currency(listing.price, precision: 0) %> · <%= listing.beds %> bd · <%= listing.baths %> ba</p>
              </div>
              <% if listing.status == "active" %>
                <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-0.5 text-xs font-medium text-green-700 ring-1 ring-green-600/20 ring-inset"><%= listing.status.capitalize %></span>
              <% elsif listing.status == "pending" %>
                <span class="inline-flex items-center rounded-full bg-yellow-50 px-2 py-0.5 text-xs font-medium text-yellow-800 ring-1 ring-yellow-600/20 ring-inset"><%= listing.status.capitalize %></span>
              <% else %>
                <span class="inline-flex items-center rounded-full bg-gray-50 px-2 py-0.5 text-xs font-medium text-gray-600 ring-1 ring-gray-500/10 ring-inset"><%= listing.status.capitalize %></span>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="p-6 text-center">
          <p class="text-sm text-gray-500">No listings assigned yet.</p>
        </div>
      <% end %>
    </div>
  </div>

  <%# Sidebar %>
  <div class="flex flex-col gap-5">
    <%# Performance (stubbed) %>
    <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
      <h3 class="text-sm font-semibold mb-3">Performance</h3>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <p class="text-2xl font-bold tabular-nums"><%= @agent.listing_agents.count %></p>
          <p class="text-xs text-gray-400">Active listings</p>
        </div>
        <div>
          <p class="text-2xl font-bold tabular-nums">0</p>
          <p class="text-xs text-gray-400">QR scans (30d)</p>
        </div>
      </div>
      <div class="h-10 bg-gray-100 rounded mt-3"></div>
      <div class="flex gap-4 pt-3 mt-3 border-t border-gray-100">
        <div class="flex-1 text-center">
          <p class="font-bold text-sm font-mono tabular-nums">0</p>
          <p class="text-xs text-gray-400">Ads</p>
        </div>
        <div class="flex-1 text-center">
          <p class="font-bold text-sm font-mono tabular-nums">0</p>
          <p class="text-xs text-gray-400">On screens</p>
        </div>
      </div>
    </div>

    <%# Details %>
    <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
      <h3 class="text-sm font-semibold mb-3">Details</h3>
      <div class="divide-y divide-gray-100">
        <div class="flex justify-between py-2 text-sm">
          <span class="text-gray-500">Email</span>
          <span class="font-medium truncate ml-3"><%= @agent.email %></span>
        </div>
        <% if @agent.phone.present? %>
          <div class="flex justify-between py-2 text-sm">
            <span class="text-gray-500">Phone</span>
            <span class="font-medium font-mono"><%= @agent.phone %></span>
          </div>
        <% end %>
        <div class="flex justify-between py-2 text-sm">
          <span class="text-gray-500">Listings</span>
          <span class="font-medium"><%= @agent.listing_agents.count %></span>
        </div>
        <div class="flex justify-between py-2 text-sm">
          <span class="text-gray-500">Linked user</span>
          <span class="font-medium"><%= @agent.user ? "#{@agent.user.first_name} #{@agent.user.last_name}" : "—" %></span>
        </div>
        <div class="flex justify-between py-2 text-sm">
          <span class="text-gray-500">Agent ID</span>
          <span class="font-medium font-mono text-xs">RP-<%= @agent.id.to_s.rjust(5, "0") %></span>
        </div>
      </div>
    </div>

    <%# Note %>
    <div class="rounded-lg bg-gray-50 p-4 text-sm text-gray-600 leading-relaxed">
      <strong class="text-gray-800">Agent profiles</strong> appear on signage and QR landing pages alongside their listings. Keep contact info current so prospective buyers can reach out.
    </div>
  </div>
</div>

<%# Danger zone %>
<div class="mt-8 pt-4 border-t border-gray-200">
  <%= button_to "Delete agent", @agent, method: :delete,
      class: "rounded-md bg-white px-2.5 py-1.5 text-sm font-semibold text-red-600 shadow-xs ring-1 ring-red-300 ring-inset hover:bg-red-50",
      data: { turbo_confirm: "Are you sure you want to delete this agent?" } %>
</div>
