<% actions = capture do %>
  <%= link_to new_agent_path, class: "rounded-md bg-indigo-600 px-2.5 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
    New agent
  <% end %>
<% end %>
<%= render "shared/page_header", title: "Agents", subtitle: "#{@agents.size} agents", actions: actions %>

<% if @agents.any? %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <% @agents.each do |agent| %>
      <%= link_to agent_path(agent), class: "rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 hover:shadow-md transition-shadow cursor-pointer", data: { turbo_frame: "_top" } do %>
        <div class="p-4 flex flex-row items-center gap-3">
          <div class="w-10 h-10 rounded-full flex-none grid place-items-center text-sm font-bold bg-indigo-50 text-indigo-600">
            <%= agent.name.split.map(&:first).join.first(2).upcase %>
          </div>
          <div class="flex-1 min-w-0">
            <p class="font-semibold text-sm truncate"><%= agent.name %></p>
            <p class="text-xs text-gray-400 truncate"><%= agent.email %></p>
            <% if agent.phone.present? %>
              <p class="text-xs text-gray-400"><%= agent.phone %></p>
            <% end %>
          </div>
          <div class="text-right">
            <p class="font-bold text-sm tabular-nums"><%= agent.listing_agents.count %></p>
            <p class="text-xs text-gray-400">Listings</p>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 border-2 border-dashed border-gray-200 p-10 text-center">
    <div class="flex flex-col items-center gap-3">
      <div class="w-12 h-12 rounded-xl bg-indigo-50 grid place-items-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
      </div>
      <p class="font-semibold">No agents yet</p>
      <p class="text-sm text-gray-500">Add your first agent to get started.</p>
      <%= link_to "New agent", new_agent_path, class: "rounded-md bg-indigo-600 px-2.5 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500" %>
    </div>
  </div>
<% end %>
