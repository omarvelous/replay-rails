<% content_for(:page_title) { "Agents" } %>
<% content_for(:page_subtitle) { "#{@agents.size} agents" } %>
<% content_for(:page_actions) do %>
  <%= link_to new_agent_path, class: "btn btn-primary btn-sm" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
    New agent
  <% end %>
<% end %>

<% if @agents.any? %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <% @agents.each do |agent| %>
      <%= link_to agent_path(agent), class: "card bg-base-100 shadow-sm hover:shadow-md transition-shadow cursor-pointer", data: { turbo_frame: "_top" } do %>
        <div class="card-body p-4 flex-row items-center gap-3">
          <div class="w-10 h-10 rounded-full flex-none grid place-items-center text-sm font-bold bg-primary/10 text-primary">
            <%= agent.name.split.map(&:first).join.first(2).upcase %>
          </div>
          <div class="flex-1 min-w-0">
            <p class="font-semibold text-sm truncate"><%= agent.name %></p>
            <p class="text-xs text-base-content/40 truncate"><%= agent.email %></p>
            <% if agent.phone.present? %>
              <p class="text-xs text-base-content/40"><%= agent.phone %></p>
            <% end %>
          </div>
          <div class="text-right">
            <p class="font-bold text-sm tabular-nums"><%= agent.listing_agents.count %></p>
            <p class="text-xs text-base-content/40">Listings</p>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="card bg-base-100 border-2 border-dashed border-base-300 p-10 text-center">
    <div class="flex flex-col items-center gap-3">
      <div class="w-12 h-12 rounded-xl bg-primary/10 grid place-items-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
      </div>
      <p class="font-semibold">No agents yet</p>
      <p class="text-sm text-base-content/50">Add your first agent to get started.</p>
      <%= link_to "New agent", new_agent_path, class: "btn btn-primary btn-sm" %>
    </div>
  </div>
<% end %>
