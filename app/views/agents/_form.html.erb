<%= form_with model: agent do |form| %>
  <% if agent.errors.any? %>
    <div class="rounded-md bg-red-50 p-4 mb-4">
      <div class="flex">
        <div class="shrink-0">
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5 text-red-400"><path d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM8.28 7.22a.75.75 0 0 0-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 1 0 1.06 1.06L10 11.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L11.06 10l1.72-1.72a.75.75 0 0 0-1.06-1.06L10 8.94 8.28 7.22Z" clip-rule="evenodd" fill-rule="evenodd" /></svg>
        </div>
        <div class="ml-3">
          <ul class="list-disc list-inside text-sm text-red-700">
            <% agent.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :name, required: true, autofocus: true, placeholder: "e.g. Jane Smith",
        class: "block w-full rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" %>
  </div>

  <div class="mb-3">
    <%= form.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.email_field :email, required: true, placeholder: "jane@example.com",
        class: "block w-full rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" %>
  </div>

  <div class="mb-3">
    <%= form.label :phone, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.telephone_field :phone, placeholder: "(555) 555-1234",
        class: "block w-full rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" %>
  </div>

  <div class="mb-4">
    <%= form.label :user_id, "Linked user (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.select :user_id,
        Current.account.users.order(:first_name).map { |u| ["#{u.first_name} #{u.last_name}", u.id] },
        { include_blank: "None" },
        class: "block w-full rounded-md bg-white py-2 pl-3 pr-8 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" %>
  </div>

  <div class="flex items-center justify-between pt-4 border-t border-gray-200">
    <button type="button" class="text-sm font-semibold text-gray-600 hover:text-gray-900" data-action="click->modal#close">Cancel</button>
    <%= form.submit agent.persisted? ? "Save changes" : "Create agent",
        class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500" %>
  </div>
<% end %>
