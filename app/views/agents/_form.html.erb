<%= form_with model: agent, class: "contents" do |form| %>
  <% if agent.errors.any? %>
    <div id="error_explanation" class="alert alert-error my-4">
      <div>
        <ul class="list-disc list-inside text-sm">
          <% agent.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <fieldset class="fieldset my-5">
    <%= form.label :name, class: "fieldset-label" %>
    <%= form.text_field :name, required: true, autofocus: true,
        class: "input input-bordered w-full" %>
  </fieldset>

  <fieldset class="fieldset my-5">
    <%= form.label :email, class: "fieldset-label" %>
    <%= form.email_field :email, required: true,
        class: "input input-bordered w-full" %>
  </fieldset>

  <fieldset class="fieldset my-5">
    <%= form.label :phone, class: "fieldset-label" %>
    <%= form.telephone_field :phone, class: "input input-bordered w-full" %>
  </fieldset>

  <fieldset class="fieldset my-5">
    <%= form.label :user_id, "Linked user (optional)", class: "fieldset-label" %>
    <%= form.select :user_id,
        Current.account.users.order(:first_name).map { |u| ["#{u.first_name} #{u.last_name}", u.id] },
        { include_blank: "None" },
        class: "select select-bordered w-full" %>
  </fieldset>

  <div class="flex items-center gap-4">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", agents_path, class: "link link-hover text-sm" %>
  </div>
<% end %>
