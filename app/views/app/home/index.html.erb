<div class="min-h-[60vh] flex items-center justify-center">
  <div class="text-center">
    <div class="max-w-md">
      <h1 class="text-5xl font-bold">Welcome</h1>
      <p class="py-6 text-gray-600">Your application is ready.</p>
      <% if authenticated? %>
        <p class="text-sm text-gray-500">You are signed in.</p>
      <% else %>
        <%= link_to "Sign In", new_session_path, class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500" %>
      <% end %>
    </div>
  </div>
</div>
