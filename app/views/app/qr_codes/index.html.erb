<%= render "app/shared/page_header", title: "QR Codes", subtitle: "#{@qr_codes.size} codes" %>

<% if @qr_codes.any? %>
  <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-300">
        <thead>
          <tr>
            <th class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900">QR Code</th>
            <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Destination</th>
            <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Scans</th>
            <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Status</th>
            <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Created</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @qr_codes.each do |qr| %>
            <tr class="hover:bg-gray-50 cursor-pointer" onclick="Turbo.visit('<%= qr_code_path(qr) %>')">
              <td class="py-4 pl-4 pr-3">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-lg bg-gray-100 grid place-items-center shrink-0 overflow-hidden p-1">
                    <%= qr_svg(qr) %>
                  </div>
                  <div>
                    <p class="font-semibold text-sm"><%= qr.label || "Untitled" %></p>
                    <p class="text-xs font-mono text-gray-400"><%= qr.token %></p>
                  </div>
                </div>
              </td>
              <td class="px-3 py-4 text-sm text-gray-500">
                <% if qr.destination_record %>
                  <span class="inline-flex items-center rounded-md bg-gray-50 px-1.5 py-0.5 text-[10.5px] font-medium text-gray-500 ring-1 ring-gray-500/10 ring-inset"><%= qr.destination_record_type %></span>
                  <span class="ml-1"><%= qr.destination_record.try(:address) || qr.destination_record.try(:name) || "##{qr.destination_record_id}" %></span>
                <% elsif qr.destination_url.present? %>
                  <span class="text-xs font-mono text-gray-400 truncate max-w-48 inline-block"><%= qr.destination_url.truncate(40) %></span>
                <% else %>
                  <span class="text-gray-400">Not configured</span>
                <% end %>
              </td>
              <td class="px-3 py-4 text-sm font-semibold tabular-nums"><%= qr.scans.count %></td>
              <td class="px-3 py-4">
                <% if qr.active? %>
                  <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-0.5 text-xs font-medium text-green-700 ring-1 ring-green-600/20 ring-inset">Active</span>
                <% else %>
                  <span class="inline-flex items-center rounded-full bg-gray-50 px-2 py-0.5 text-xs font-medium text-gray-600 ring-1 ring-gray-500/10 ring-inset">Inactive</span>
                <% end %>
              </td>
              <td class="px-3 py-4 text-xs text-gray-400"><%= time_ago_in_words(qr.created_at) %> ago</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <div class="rounded-lg border-2 border-dashed border-gray-200 p-10 text-center">
    <div class="flex flex-col items-center gap-3">
      <div class="w-12 h-12 rounded-xl bg-indigo-50 grid place-items-center">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-6 h-6 text-indigo-600"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 013.75 9.375v-4.5zM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 01-1.125-1.125v-4.5zM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0113.5 9.375v-4.5z"/></svg>
      </div>
      <p class="font-semibold">No QR codes yet</p>
      <p class="text-sm text-gray-500">QR codes are created automatically when listings are displayed in ads.</p>
    </div>
  </div>
<% end %>
