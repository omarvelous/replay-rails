<div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
  <%= form_with model: experience, url: experience.persisted? ? experience_path(experience) : experiences_path do |form| %>
    <% if experience.errors.any? %>
      <div class="rounded-md bg-red-50 p-4 mb-4">
        <ul class="list-disc list-inside text-sm text-red-700">
          <% experience.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-4">
      <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :name, required: true, placeholder: "e.g., 123 Main St Open House",
          class: "block w-full rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" %>
    </div>

    <% unless experience.persisted? %>
      <div class="mb-4">
        <%= form.label :listing_id, "Listing", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.select :listing_id,
            Current.account.listings.where(status: "active").order(:address).map { |l| ["#{l.address} — #{number_to_currency(l.price, precision: 0)}", l.id] },
            { include_blank: "Select a listing", selected: experience.experienceable&.listing_id },
            required: true,
            class: "block w-full rounded-md bg-white py-2 pl-3 pr-8 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" %>
      </div>

      <div class="mb-4">
        <%= form.label :agent_id, "Agent (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.select :agent_id,
            Current.account.agents.order(:name).map { |a| [a.name, a.id] },
            { include_blank: "Use listing's default agent" },
            class: "block w-full rounded-md bg-white py-2 pl-3 pr-8 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" %>
      </div>
    <% end %>

    <div class="flex items-center gap-3 pt-4 border-t border-gray-200">
      <%= form.submit experience.persisted? ? "Update experience" : "Create experience",
          class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 cursor-pointer" %>
      <% if experience.persisted? %>
        <%= link_to "Cancel", experience_path(experience), class: "text-sm font-semibold text-gray-600 hover:text-gray-900" %>
      <% else %>
        <%= link_to "Cancel", experiences_path, class: "text-sm font-semibold text-gray-600 hover:text-gray-900" %>
      <% end %>
    </div>
  <% end %>
</div>
