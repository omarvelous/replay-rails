<% actions = capture do %>
  <%= link_to go_experience_url(@experience, subdomain: ""), target: "_blank", class: "rounded-md bg-white px-2.5 py-1.5 text-sm font-semibold text-gray-900 shadow-xs ring-1 ring-gray-300 ring-inset hover:bg-gray-50 inline-flex items-center gap-1.5" do %>
    <svg viewBox="0 0 20 20" fill="currentColor" class="size-4"><path d="M10 12.5a2.5 2.5 0 100-5 2.5 2.5 0 000 5z"/><path fill-rule="evenodd" d="M.664 10.59a1.651 1.651 0 010-1.186A10.004 10.004 0 0110 3c4.257 0 7.893 2.66 9.336 6.41.147.381.146.804 0 1.186A10.004 10.004 0 0110 17c-4.257 0-7.893-2.66-9.336-6.41zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/></svg>
    Preview
  <% end %>
  <%= link_to edit_experience_path(@experience), class: "rounded-md bg-white px-2.5 py-1.5 text-sm font-semibold text-gray-900 shadow-xs ring-1 ring-gray-300 ring-inset hover:bg-gray-50" do %>Edit<% end %>
<% end %>
<%= render "app/shared/page_header", title: @experience.name, subtitle: "Experience", actions: actions, back_link: { label: "← Experiences", path: experiences_path } %>

<div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-5 items-start">
  <div class="flex flex-col gap-5">
    <%# Listing info %>
    <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
      <h3 class="text-sm font-semibold mb-3">Listing</h3>
      <% if @experience.listing %>
        <%= link_to listing_path(@experience.listing), class: "flex items-center gap-3 p-3 -mx-1 rounded-lg border border-gray-200 hover:bg-gray-50 transition-colors" do %>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium"><%= @experience.listing.address %></p>
            <p class="text-xs text-gray-400"><%= number_to_currency(@experience.listing.price, precision: 0) %> · <%= @experience.listing.beds %> bd · <%= @experience.listing.baths %> ba</p>
          </div>
        <% end %>
      <% end %>
    </div>

    <%# Config %>
    <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
      <h3 class="text-sm font-semibold mb-3">Sections</h3>
      <div class="space-y-2">
        <% (@experience.config["sections"] || {}).each do |section, enabled| %>
          <div class="flex items-center justify-between text-sm">
            <span><%= section.humanize %></span>
            <% if enabled %>
              <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-0.5 text-xs font-medium text-green-700 ring-1 ring-green-600/20 ring-inset">On</span>
            <% else %>
              <span class="inline-flex items-center rounded-full bg-gray-50 px-2 py-0.5 text-xs font-medium text-gray-600 ring-1 ring-gray-500/10 ring-inset">Off</span>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="flex flex-col gap-5">
    <%# Details %>
    <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
      <h3 class="text-sm font-semibold mb-3">Details</h3>
      <div class="divide-y divide-gray-100">
        <div class="flex justify-between py-2 text-sm">
          <span class="text-gray-500">Type</span>
          <span class="font-medium"><%= @experience.experienceable_type.demodulize.titleize %></span>
        </div>
        <% if @experience.default_agent %>
          <div class="flex justify-between py-2 text-sm">
            <span class="text-gray-500">Agent</span>
            <span class="font-medium"><%= @experience.default_agent.name %></span>
          </div>
        <% end %>
        <div class="flex justify-between py-2 text-sm">
          <span class="text-gray-500">Screens</span>
          <span class="font-medium"><%= @experience.screen_contents.where(active: true).count %></span>
        </div>
        <div class="flex justify-between py-2 text-sm">
          <span class="text-gray-500">Created</span>
          <span><%= @experience.created_at.strftime("%b %-d, %Y") %></span>
        </div>
      </div>
    </div>
  </div>
</div>

<%# Danger zone %>
<div class="mt-8 pt-4 border-t border-gray-200">
  <%= button_to "Delete experience", @experience, method: :delete,
      class: "rounded-md bg-white px-2.5 py-1.5 text-sm font-semibold text-red-600 shadow-xs ring-1 ring-red-300 ring-inset hover:bg-red-50",
      data: { turbo_confirm: "Are you sure you want to delete this experience?" } %>
</div>
