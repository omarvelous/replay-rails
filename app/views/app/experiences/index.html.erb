<% actions = capture do %>
  <%= link_to new_experience_path, class: "rounded-md bg-indigo-600 px-2.5 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 inline-flex items-center gap-1.5" do %>
    <svg viewBox="0 0 20 20" fill="currentColor" class="size-4"><path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z"/></svg>
    New experience
  <% end %>
<% end %>
<%= render "app/shared/page_header", title: "Experiences", subtitle: "#{@experiences.size} experiences", actions: actions %>

<% if @experiences.any? %>
  <div class="space-y-2">
    <% @experiences.each do |experience| %>
      <%= link_to experience_path(experience), class: "block rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-4 hover:shadow-md transition-shadow" do %>
        <div class="flex items-center justify-between">
          <div>
            <p class="font-semibold text-sm"><%= experience.name %></p>
            <p class="text-xs text-gray-500 mt-0.5">
              <%= experience.listing&.address || "No listing" %>
            </p>
          </div>
          <span class="inline-flex items-center rounded-md bg-indigo-50 px-2 py-0.5 text-xs font-medium text-indigo-700 ring-1 ring-indigo-600/20 ring-inset">
            <%= experience.experienceable_type.demodulize.titleize %>
          </span>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="rounded-lg border-2 border-dashed border-gray-200 p-10 text-center">
    <p class="font-semibold">No experiences yet</p>
    <p class="text-sm text-gray-500 mt-1">Create an interactive experience for an open house or showing.</p>
    <%= link_to "New experience", new_experience_path, class: "rounded-md bg-indigo-600 px-2.5 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 mt-3 inline-block" %>
  </div>
<% end %>
