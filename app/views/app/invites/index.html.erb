<% actions = capture do %>
  <%= link_to new_invite_path, class: "rounded-md bg-indigo-600 px-2.5 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 inline-flex items-center gap-1.5" do %>
    <svg viewBox="0 0 20 20" fill="currentColor" class="size-4"><path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z"/></svg>
    Invite user
  <% end %>
<% end %>

<% pending = @invites.select(&:pending?) %>
<%= render "app/shared/page_header", title: "Invites", subtitle: "#{pending.size} pending", actions: actions %>

<% if @invites.any? %>
  <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5">
    <div class="divide-y divide-gray-100">
      <% @invites.each do |invite| %>
        <div class="flex items-center justify-between p-4">
          <div class="flex items-center gap-3">
            <% if invite.accepted? %>
              <span class="w-2.5 h-2.5 rounded-full bg-green-500 shrink-0"></span>
            <% elsif invite.expired? %>
              <span class="w-2.5 h-2.5 rounded-full bg-gray-300 shrink-0"></span>
            <% else %>
              <span class="w-2.5 h-2.5 rounded-full bg-amber-500 shrink-0"></span>
            <% end %>
            <div>
              <p class="text-sm font-semibold"><%= invite.email %></p>
              <p class="text-xs text-gray-500">
                <%= invite.role.capitalize %> &middot;
                <% if invite.accepted? %>
                  accepted <%= time_ago_in_words(invite.accepted_at) %> ago
                <% elsif invite.expired? %>
                  expired
                <% else %>
                  sent <%= time_ago_in_words(invite.created_at) %> ago
                <% end %>
              </p>
            </div>
          </div>
          <% if invite.pending? %>
            <%= button_to "Revoke", invite_path(token: invite.token), method: :delete,
                class: "text-sm font-semibold text-red-600 hover:text-red-500",
                data: { turbo_confirm: "Revoke this invite?" } %>
          <% else %>
            <span class="inline-flex items-center rounded-md bg-gray-50 px-1.5 py-0.5 text-[10.5px] font-medium text-gray-500 ring-1 ring-gray-500/10 ring-inset">
              <%= invite.accepted? ? "Accepted" : "Expired" %>
            </span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% else %>
  <div class="rounded-lg border-2 border-dashed border-gray-200 p-10 text-center">
    <p class="font-semibold">No invites yet</p>
    <p class="text-sm text-gray-500 mt-1">Invite a team member to get started.</p>
    <%= link_to "Invite user", new_invite_path, class: "rounded-md bg-indigo-600 px-2.5 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 mt-3 inline-block" %>
  </div>
<% end %>

<%= render "app/shared/pagination", pagy: @pagy %>
