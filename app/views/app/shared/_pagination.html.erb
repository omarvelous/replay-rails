<% if pagy.pages > 1 %>
  <div class="flex items-center justify-between mt-6">
    <p class="text-sm text-gray-500">
      Showing <span class="font-medium"><%= pagy.from %></span>–<span class="font-medium"><%= pagy.to %></span>
      of <span class="font-medium"><%= pagy.count %></span>
    </p>
    <nav class="flex items-center gap-1" aria-label="Pagination">
      <% if pagy.previous %>
        <%= link_to url_for(page: pagy.previous), class: "relative inline-flex items-center rounded-md px-2.5 py-1.5 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50", aria: { label: "Previous" } do %>
          <svg viewBox="0 0 20 20" fill="currentColor" class="size-4"><path fill-rule="evenodd" d="M11.78 5.22a.75.75 0 0 1 0 1.06L8.06 10l3.72 3.72a.75.75 0 1 1-1.06 1.06l-4.25-4.25a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 0Z" clip-rule="evenodd"/></svg>
        <% end %>
      <% else %>
        <span class="relative inline-flex items-center rounded-md px-2.5 py-1.5 text-sm text-gray-300 ring-1 ring-inset ring-gray-200 cursor-not-allowed">
          <svg viewBox="0 0 20 20" fill="currentColor" class="size-4"><path fill-rule="evenodd" d="M11.78 5.22a.75.75 0 0 1 0 1.06L8.06 10l3.72 3.72a.75.75 0 1 1-1.06 1.06l-4.25-4.25a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 0Z" clip-rule="evenodd"/></svg>
        </span>
      <% end %>

      <% pagy.send(:series).each do |item| %>
        <% if item == :gap %>
          <span class="px-2 text-sm text-gray-400">&hellip;</span>
        <% elsif item.to_s == pagy.page.to_s %>
          <span class="relative inline-flex items-center rounded-md px-3.5 py-1.5 text-sm font-semibold bg-indigo-600 text-white shadow-sm"><%= item %></span>
        <% else %>
          <%= link_to item, url_for(page: item), class: "relative inline-flex items-center rounded-md px-3.5 py-1.5 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
        <% end %>
      <% end %>

      <% if pagy.next %>
        <%= link_to url_for(page: pagy.next), class: "relative inline-flex items-center rounded-md px-2.5 py-1.5 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50", aria: { label: "Next" } do %>
          <svg viewBox="0 0 20 20" fill="currentColor" class="size-4"><path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"/></svg>
        <% end %>
      <% else %>
        <span class="relative inline-flex items-center rounded-md px-2.5 py-1.5 text-sm text-gray-300 ring-1 ring-inset ring-gray-200 cursor-not-allowed">
          <svg viewBox="0 0 20 20" fill="currentColor" class="size-4"><path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"/></svg>
        </span>
      <% end %>
    </nav>
  </div>
<% end %>
