<%= render "app/shared/page_header", title: @lead.name, subtitle: @lead.lead_type.humanize %>

<div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-6">
  <%# Left — Lead detail %>
  <div class="space-y-6">
    <%# Contact info %>
    <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
      <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-4">Contact</h3>
      <dl class="space-y-3">
        <div>
          <dt class="text-xs text-gray-500">Name</dt>
          <dd class="text-sm font-semibold"><%= @lead.name %></dd>
        </div>
        <% if @lead.email.present? %>
          <div>
            <dt class="text-xs text-gray-500">Email</dt>
            <dd class="text-sm"><a href="mailto:<%= @lead.email %>" class="text-indigo-600 font-semibold hover:text-indigo-500"><%= @lead.email %></a></dd>
          </div>
        <% end %>
        <% if @lead.phone.present? %>
          <div>
            <dt class="text-xs text-gray-500">Phone</dt>
            <dd class="text-sm"><a href="tel:<%= @lead.phone %>" class="text-indigo-600 font-semibold hover:text-indigo-500"><%= @lead.phone %></a></dd>
          </div>
        <% end %>
      </dl>
    </div>

    <%# Message %>
    <% if @lead.message.present? %>
      <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
        <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-4">Message</h3>
        <p class="text-sm text-gray-700 whitespace-pre-wrap"><%= @lead.message %></p>
      </div>
    <% end %>

    <%# Attribution %>
    <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
      <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-4">Attribution</h3>
      <dl class="space-y-3 text-sm">
        <% if @lead.listing %>
          <div>
            <dt class="text-xs text-gray-500">Listing</dt>
            <dd><%= @lead.listing.address %></dd>
          </div>
        <% end %>
        <% if @lead.qr_scan %>
          <div>
            <dt class="text-xs text-gray-500">QR Code</dt>
            <dd><%= @lead.qr_scan.qr_code.label || @lead.qr_scan.qr_code.token %></dd>
          </div>
          <% if @lead.qr_scan.ad %>
            <div>
              <dt class="text-xs text-gray-500">Ad</dt>
              <dd><%= @lead.qr_scan.ad.headline %></dd>
            </div>
          <% end %>
          <% if @lead.qr_scan.screen %>
            <div>
              <dt class="text-xs text-gray-500">Screen</dt>
              <dd><%= @lead.qr_scan.screen.name %></dd>
            </div>
          <% end %>
        <% end %>
        <div>
          <dt class="text-xs text-gray-500">Submitted</dt>
          <dd><%= @lead.created_at.strftime("%b %-d, %Y at %-I:%M %p") %></dd>
        </div>
      </dl>
    </div>

    <%# Assignment history %>
    <% if @lead.lead_agents.any? %>
      <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
        <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-4">Assignment History</h3>
        <div class="space-y-2">
          <% @lead.lead_agents.includes(:agent).order(created_at: :desc).each do |la| %>
            <div class="flex items-center justify-between text-sm">
              <span class="font-medium"><%= la.agent.name %></span>
              <span class="text-xs text-gray-400"><%= time_ago_in_words(la.created_at) %> ago</span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <%# Right — Status + agent %>
  <div class="space-y-5">
    <%= form_with model: @lead, url: lead_path(@lead), method: :patch do |f| %>
      <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5 space-y-4">
        <div>
          <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Status</h3>
          <%= f.select :status,
              [["New", "new"], ["Contacted", "contacted"], ["Qualified", "qualified"], ["Closed", "closed"]],
              {},
              class: "block w-full rounded-md bg-white py-2 pl-3 pr-8 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" %>
        </div>

        <div>
          <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Assign Agent</h3>
          <%= f.select :agent_id,
              Current.account.agents.order(:name).map { |a| [a.name, a.id] },
              { include_blank: "Select agent…", selected: @lead.current_agent&.id },
              class: "block w-full rounded-md bg-white py-2 pl-3 pr-8 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" %>
        </div>

        <%= f.submit "Update",
            class: "w-full rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
