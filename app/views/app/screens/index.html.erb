<% actions = capture do %>
  <%= link_to new_screen_path, class: "rounded-md bg-indigo-600 px-2.5 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 inline-flex items-center gap-1.5" do %>
    <svg viewBox="0 0 20 20" fill="currentColor" class="size-4"><path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z"/></svg>
    Add screen
  <% end %>
<% end %>
<%= render "app/shared/page_header", title: "Screens", subtitle: "#{@pagy.count} screens", actions: actions %>

<div data-controller="view-toggle">
  <%= form_with url: screens_path, method: :get do |f| %>
    <div class="flex flex-wrap items-center gap-3 mb-5">
      <div class="flex-1 min-w-50 max-w-xs">
        <%= f.search_field :q, value: params[:q], placeholder: "Search screens…",
            class: "block w-full rounded-md bg-white px-3 py-1.5 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600",
            oninput: "if (this.value === '') this.form.requestSubmit()" %>
      </div>

      <div class="grid grid-cols-1">
        <%= f.select :status,
            [["All screens", ""], ["Live", "live"], ["Idle", "idle"]],
            { selected: params[:status].to_s },
            class: "col-start-1 row-start-1 w-full appearance-none rounded-md bg-white py-1.5 pr-8 pl-3 text-sm/6 text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-indigo-600",
            onchange: "this.form.requestSubmit()" %>
        <svg viewBox="0 0 16 16" fill="currentColor" data-slot="icon" aria-hidden="true" class="pointer-events-none col-start-1 row-start-1 mr-2 size-4 self-center justify-self-end text-gray-500">
          <path d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" fill-rule="evenodd" />
        </svg>
      </div>

      <span class="ml-auto isolate inline-flex rounded-md shadow-xs">
        <button class="relative inline-flex items-center rounded-l-md bg-white px-2 py-1.5 text-gray-400 ring-1 ring-gray-300 ring-inset hover:bg-gray-50" data-view-btn data-view="grid" data-action="click->view-toggle#switch">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"/></svg>
        </button>
        <button class="relative -ml-px inline-flex items-center rounded-r-md bg-white px-2 py-1.5 text-gray-400 ring-1 ring-gray-300 ring-inset hover:bg-gray-50" data-view-btn data-view="table" data-action="click->view-toggle#switch">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 5.25h16.5m-16.5 4.5h16.5m-16.5 4.5h16.5m-16.5 4.5h16.5"/></svg>
        </button>
      </span>
    </div>
  <% end %>

  <%# Grid view %>
  <div data-view-toggle-target="view" data-view="grid">
    <% if @screens.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        <% @screens.each do |screen| %>
            <% active_playlist = screen.screen_playlists.find { |sp| sp.active }&.playlist %>
            <% status = screen_status(screen, active_playlist: active_playlist) %>
            <% is_live = status == :live %>
            <% tone = is_live ? %w[#2f6bff #0fb5a6 #7c5cff #e8990f #1f9d57][screen.id % 5] : nil %>
            <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 hover:shadow-md transition-shadow overflow-visible">
              <%# Preview — tinted gradient or idle/offline %>
              <%= link_to screen_path(screen), class: "block aspect-video rounded-t-lg relative overflow-hidden cursor-pointer", style: is_live ? "background: linear-gradient(135deg, #14171f, #{tone}33);" : "background: #0b0d12;" do %>
                <% if is_live %>
                  <%# HeroMini stub %>
                  <div class="absolute inset-0 flex flex-col justify-end p-3 text-white">
                    <div class="text-[10px] font-bold opacity-80" style="color: <%= tone %>cc;">FOR SALE</div>
                    <div class="text-lg font-bold tracking-tight leading-tight">$1.25M</div>
                    <div class="text-[11px] opacity-80">124 Maple Ave</div>
                  </div>
                  <div class="absolute right-3 bottom-3 w-6 h-6 bg-white rounded"></div>
                <% else %>
                  <div class="absolute inset-0 grid place-items-center text-gray-600 text-xl">—</div>
                <% end %>
                <div class="absolute top-2 right-2">
                  <%= screen_status_badge(status) %>
                </div>
              <% end %>

              <%# Metadata %>
              <div class="p-3">
                <div class="flex items-center justify-between">
                  <%= link_to screen.name, screen_path(screen), class: "font-semibold text-sm truncate hover:text-indigo-600 cursor-pointer" %>
                  <span class="inline-flex items-center rounded-md bg-gray-50 px-1.5 py-0.5 text-[10.5px] font-medium text-gray-500 ring-1 ring-gray-500/10 ring-inset ml-2 shrink-0"><%= screen.orientation.capitalize %></span>
                </div>
                <p class="text-xs text-gray-400 mt-0.5"><%= screen.site.name %></p>

                <%# Playlist row %>
                <div class="flex items-center gap-1.5 mt-2.5 text-xs text-gray-500">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-3.5 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 010 3.75H5.625a1.875 1.875 0 010-3.75z"/></svg>
                  <span class="truncate"><%= active_playlist&.name || "No playlist" %></span>
                </div>

                <%# Heartbeat row %>
                <div class="flex items-center gap-1.5 mt-1.5 text-[11.5px] text-gray-400">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-3.5 shrink-0 <%= screen_heartbeat_icon_color(status) %>"><path stroke-linecap="round" stroke-linejoin="round" d="M8.288 15.038a5.25 5.25 0 017.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M1.924 8.674c5.565-5.565 14.587-5.565 20.152 0M12.53 18.22l-.53.53-.53-.53a.75.75 0 011.06 0z"/></svg>
                  <span><%= screen_heartbeat_text(screen, status) %></span>
                </div>

                <%# Change content button %>
                <div class="mt-3">
                  <%= link_to new_screen_screen_playlist_path(screen), class: "flex items-center justify-center gap-1.5 w-full rounded-md bg-white px-2.5 py-1.5 text-sm font-semibold text-gray-700 shadow-xs ring-1 ring-gray-300 ring-inset hover:bg-gray-50" do %>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 010 3.75H5.625a1.875 1.875 0 010-3.75z"/></svg>
                    Change content
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="rounded-lg border-2 border-dashed border-gray-200 p-10 text-center">
          <div class="flex flex-col items-center gap-3">
            <div class="w-12 h-12 rounded-xl bg-indigo-50 grid place-items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
            </div>
            <p class="font-semibold">No screens yet</p>
            <p class="text-sm text-gray-500">Add a screen to start displaying content.</p>
            <%= link_to "Add screen", new_screen_path, class: "rounded-md bg-indigo-600 px-2.5 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500" %>
          </div>
        </div>
      <% end %>
    </div>

    <%# Table view %>
    <div data-view-toggle-target="view" data-view="table" class="hidden">
      <% if @screens.any? %>
        <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5">
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-300">
              <thead>
                <tr>
                  <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Screen</th>
                  <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Site</th>
                  <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Player</th>
                  <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Playlist</th>
                  <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Status</th>
                  <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Heartbeat</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200">
                <% @screens.each do |screen| %>
                  <% active_playlist = screen.screen_playlists.find { |sp| sp.active }&.playlist %>
                  <% status = screen_status(screen, active_playlist: active_playlist) %>
                  <% is_live = status == :live %>
                  <% tone = is_live ? %w[#2f6bff #0fb5a6 #7c5cff #e8990f #1f9d57][screen.id % 5] : nil %>
                  <tr class="hover:bg-gray-50">
                    <td class="px-3 py-4">
                      <div class="flex items-center gap-3">
                        <%# Mini preview — 48×30 %>
                        <div class="w-12 h-7.5 rounded flex-none relative overflow-hidden" style="background: <%= is_live ? "linear-gradient(135deg, #14171f, #{tone}33)" : '#0b0d12' %>;">
                          <% if is_live %>
                            <div class="absolute inset-0 flex flex-col justify-end p-1 text-white">
                              <div class="text-[6px] font-bold leading-none">$1.25M</div>
                            </div>
                          <% else %>
                            <div class="absolute inset-0 grid place-items-center text-gray-600 text-[8px]">—</div>
                          <% end %>
                        </div>
                        <%= link_to screen.name, screen_path(screen), class: "font-semibold text-sm text-gray-900 hover:text-indigo-600" %>
                      </div>
                    </td>
                    <td class="px-3 py-4 text-sm text-gray-500"><%= screen.site.name %></td>
                    <td class="px-3 py-4 text-xs text-gray-400"><%= screen.paired? ? "Paired" : "—" %></td>
                    <td class="px-3 py-4 text-sm text-gray-500"><%= active_playlist&.name || "—" %></td>
                    <td class="px-3 py-4"><%= screen_status_badge(status) %></td>
                    <td class="px-3 py-4 text-xs text-gray-400"><%= screen_heartbeat_text(screen, status) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%= render "app/shared/pagination", pagy: @pagy %>
