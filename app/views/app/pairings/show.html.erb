<%= render "app/shared/page_header", title: "Pair a Player", subtitle: "Connect a player device to a screen" %>

<div class="max-w-lg mx-auto mt-8">
  <% if flash[:alert] %>
    <div class="mb-4 rounded-md bg-red-50 p-4">
      <p class="text-sm font-medium text-red-800"><%= flash[:alert] %></p>
    </div>
  <% end %>

  <%= form_with url: pair_path, method: :post, class: "space-y-6" do |f| %>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Pairing code</label>
      <%= f.text_field :code, value: @code, placeholder: "Enter 6-character code",
          class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-center text-2xl font-mono tracking-widest uppercase",
          maxlength: 6, autofocus: @code.blank?, autocomplete: "off" %>
      <p class="mt-1 text-sm text-gray-500">The code shown on the TV screen</p>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-2">Select a screen</label>
      <div class="space-y-2">
        <% @screens.each do |screen| %>
          <label class="flex items-center gap-3 p-3 rounded-lg border border-gray-200 hover:border-indigo-300 hover:bg-indigo-50/50 cursor-pointer transition">
            <%= f.radio_button :screen_id, screen.id, class: "text-indigo-600 focus:ring-indigo-500" %>
            <div>
              <div class="font-medium text-sm text-gray-900"><%= screen.name %></div>
              <div class="text-xs text-gray-500"><%= screen.site.name %></div>
            </div>
            <% if screen.paired? %>
              <span class="ml-auto text-xs text-amber-600 bg-amber-50 px-2 py-0.5 rounded-full">Has player</span>
            <% end %>
          </label>
        <% end %>
      </div>
      <% if @screens.empty? %>
        <p class="text-sm text-gray-500">No screens found. <%= link_to "Create a screen first.", new_screen_path, class: "text-indigo-600 font-medium" %></p>
      <% end %>
    </div>

    <div>
      <%= f.submit "Pair Device", class: "w-full rounded-md bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600", disabled: @screens.empty? %>
    </div>
  <% end %>
</div>
