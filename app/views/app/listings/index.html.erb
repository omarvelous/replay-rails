<% actions = capture do %>
  <%= link_to new_listing_path, class: "rounded-md bg-indigo-600 px-2.5 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 inline-flex items-center gap-1.5" do %>
    <svg viewBox="0 0 20 20" fill="currentColor" class="size-4"><path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z"/></svg>
    New listing
  <% end %>
<% end %>
<%= render "app/shared/page_header", title: "Listings", subtitle: "#{@pagy.count} properties", actions: actions %>

<div data-controller="view-toggle">
  <%= form_with url: listings_path, method: :get do |f| %>
    <div class="flex flex-wrap items-center gap-3 mb-5">
      <div class="flex-1 min-w-50 max-w-xs">
        <%= f.search_field :q, value: params[:q], placeholder: "Search by address…",
            class: "block w-full rounded-md bg-white px-3 py-1.5 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600",
            oninput: "if (this.value === '') this.form.requestSubmit()" %>
      </div>

      <div class="grid grid-cols-1">
        <%= f.select :status,
            [["All statuses", ""], ["Active", "active"], ["Pending", "pending"], ["Sold", "sold"]],
            { selected: params[:status].to_s },
            class: "col-start-1 row-start-1 w-full appearance-none rounded-md bg-white py-1.5 pr-8 pl-3 text-sm/6 text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-indigo-600",
            onchange: "this.form.requestSubmit()" %>
        <svg viewBox="0 0 16 16" fill="currentColor" data-slot="icon" aria-hidden="true" class="pointer-events-none col-start-1 row-start-1 mr-2 size-4 self-center justify-self-end text-gray-500">
          <path d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" fill-rule="evenodd" />
        </svg>
      </div>

      <span class="ml-auto isolate inline-flex rounded-md shadow-xs">
      <button type="button" class="relative inline-flex items-center rounded-l-md bg-white px-2 py-1.5 text-gray-400 ring-1 ring-gray-300 ring-inset hover:bg-gray-50" data-view-btn data-view="grid" data-action="click->view-toggle#switch">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"/></svg>
      </button>
      <button type="button" class="relative -ml-px inline-flex items-center rounded-r-md bg-white px-2 py-1.5 text-gray-400 ring-1 ring-gray-300 ring-inset hover:bg-gray-50" data-view-btn data-view="table" data-action="click->view-toggle#switch">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 5.25h16.5m-16.5 4.5h16.5m-16.5 4.5h16.5m-16.5 4.5h16.5"/></svg>
      </button>
      </span>
    </div>
  <% end %>

  <%# Gallery view %>
  <div data-view-toggle-target="view" data-view="grid">
    <% if @listings.any? %>
      <div id="listings_grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        <% @listings.each do |listing| %>
          <%= render "app/listings/listing_card", listing: listing %>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-lg border-2 border-dashed border-gray-200 p-10 text-center">
        <div class="flex flex-col items-center gap-3">
          <div class="w-12 h-12 rounded-xl bg-indigo-50 grid place-items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
          </div>
          <p class="font-semibold">No listings yet</p>
          <p class="text-sm text-gray-500">Add your first property to get started.</p>
          <%= link_to "New listing", new_listing_path, class: "rounded-md bg-indigo-600 px-2.5 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500" %>
        </div>
      </div>
    <% end %>
  </div>

  <%# Table view %>
  <div data-view-toggle-target="view" data-view="table" class="hidden">
    <% if @listings.any? %>
      <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-300">
            <thead>
              <tr>
                <th class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900">Property</th>
                <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Type</th>
                <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Price</th>
                <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Beds</th>
                <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Baths</th>
                <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Sq ft</th>
                <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <% @listings.each do |listing| %>
                <% tone = %w[#2f6bff #0fb5a6 #7c5cff #e8990f #1f9d57 #e5484d][listing.id % 6] %>
                <tr class="hover:bg-gray-50 cursor-pointer" onclick="Turbo.visit('<%= listing_path(listing) %>')">
                  <td class="py-4 pl-4 pr-3">
                    <div class="flex items-center gap-3">
                      <div class="w-12 h-9 rounded flex-none" style="background: <%= tone %>22;"></div>
                      <span class="font-semibold text-sm text-gray-900"><%= listing.address %></span>
                    </div>
                  </td>
                  <td class="px-3 py-4 text-sm text-gray-500">
                    <div><%= listing.property_type.humanize %></div>
                    <div class="text-xs text-gray-400"><%= listing.listing_type.humanize %></div>
                  </td>
                  <td class="px-3 py-4 text-sm font-semibold font-mono"><%= number_to_currency(listing.price, precision: 0) %></td>
                  <td class="px-3 py-4 text-sm font-mono text-gray-500"><%= listing.beds %></td>
                  <td class="px-3 py-4 text-sm font-mono text-gray-500"><%= listing.baths %></td>
                  <td class="px-3 py-4 text-sm font-mono text-gray-500"><%= number_with_delimiter(listing.sqft) %></td>
                  <td class="px-3 py-4">
                    <% if listing.status == 'active' %>
                      <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-0.5 text-xs font-medium text-green-700 ring-1 ring-green-600/20 ring-inset"><%= listing.status.capitalize %></span>
                    <% elsif listing.status == 'pending' %>
                      <span class="inline-flex items-center rounded-full bg-yellow-50 px-2 py-0.5 text-xs font-medium text-yellow-800 ring-1 ring-yellow-600/20 ring-inset"><%= listing.status.capitalize %></span>
                    <% else %>
                      <span class="inline-flex items-center rounded-full bg-gray-50 px-2 py-0.5 text-xs font-medium text-gray-600 ring-1 ring-gray-500/10 ring-inset"><%= listing.status.capitalize %></span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  </div>
</div>

<%= render "app/shared/pagination", pagy: @pagy %>
