<% actions = capture do %>
  <%= link_to edit_listing_path(@listing), class: "rounded-md bg-white px-2.5 py-1.5 text-sm font-semibold text-gray-900 shadow-xs ring-1 ring-gray-300 ring-inset hover:bg-gray-50" do %>Edit listing<% end %>
  <%= link_to new_ad_path(listing_id: @listing.id), class: "rounded-md bg-indigo-600 px-2.5 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500" do %>Use in ad<% end %>
<% end %>
<%= render "app/shared/page_header", title: @listing.address, subtitle: "Listing", actions: actions, back_link: { label: "← Listings", path: listings_path } %>

<% tone = %w[#2f6bff #0fb5a6 #7c5cff #e8990f #1f9d57 #e5484d][@listing.id % 6] %>
<% is_rental = @listing.price && @listing.price < 100_000 %>

<%# Photo gallery %>
<% photos = @listing.photos.to_a %>
<% if photos.any? %>
  <div class="grid gap-2.5 mb-5" style="grid-template-columns: 2.1fr 1fr 1fr; grid-template-rows: 1fr 1fr;">
    <%# Hero photo — large, spans 2 rows %>
    <div class="row-span-2 rounded-xl relative overflow-hidden min-h-56" style="background: <%= tone %>22;">
      <%= image_tag photos.first, class: "absolute inset-0 w-full h-full object-cover" %>
      <div class="absolute bottom-3 left-3 flex items-center gap-1.5 text-white text-xs font-semibold px-2.5 py-1.5 rounded-full" style="background: rgba(11,13,18,.62); backdrop-filter: blur(4px);">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"/></svg>
        <%= photos.size %> photo<%= photos.size == 1 ? "" : "s" %>
      </div>
    </div>
    <%# Secondary photos — fill remaining grid slots %>
    <% photos.drop(1).first(4).each_with_index do |photo, i| %>
      <div class="rounded-xl min-h-28 relative overflow-hidden" style="background: <%= tone %>1c;">
        <%= image_tag photo, class: "absolute inset-0 w-full h-full object-cover" %>
        <% if i == 3 && photos.size > 5 %>
          <div class="absolute inset-0 grid place-items-center text-white text-sm font-semibold" style="background: rgba(11,13,18,.42);">
            + <%= photos.size - 5 %> more
          </div>
        <% end %>
      </div>
    <% end %>
    <%# Empty slots if fewer than 5 photos %>
    <% (4 - [photos.size - 1, 4].min).times do %>
      <div class="rounded-xl min-h-28" style="background: <%= tone %>1c;"></div>
    <% end %>
  </div>
<% else %>
  <div class="grid gap-2.5 mb-5" style="grid-template-columns: 2.1fr 1fr 1fr; grid-template-rows: 1fr 1fr;">
    <div class="row-span-2 rounded-xl relative overflow-hidden min-h-56" style="background: <%= tone %>22;">
      <div class="absolute inset-0" style="background: linear-gradient(150deg, <%= tone %>40, transparent 65%);"></div>
      <div class="absolute bottom-3 left-3 flex items-center gap-1.5 text-white text-xs font-semibold px-2.5 py-1.5 rounded-full" style="background: rgba(11,13,18,.62); backdrop-filter: blur(4px);">
        No photos
      </div>
    </div>
    <div class="rounded-xl min-h-28" style="background: <%= tone %>1c;"></div>
    <div class="rounded-xl min-h-28" style="background: <%= tone %>1c;"></div>
    <div class="rounded-xl min-h-28" style="background: <%= tone %>1c;"></div>
    <div class="rounded-xl min-h-28" style="background: <%= tone %>1c;"></div>
  </div>
<% end %>

<%# Spec strip %>
<div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 mb-5 p-0 overflow-hidden">
  <div class="flex">
    <div class="flex-1 p-4 bg-gray-50" style="flex: 1.3;">
      <p class="text-2xl font-bold tabular-nums text-indigo-600"><%= number_to_currency(@listing.price, precision: 0) %></p>
      <p class="text-xs text-gray-400 mt-1"><%= is_rental ? "Asking rent" : "List price" %></p>
    </div>
    <div class="flex-1 p-4 border-l border-gray-200">
      <p class="text-xl font-bold tabular-nums"><%= @listing.beds || "—" %></p>
      <p class="text-xs text-gray-400 mt-1">Bedrooms</p>
    </div>
    <div class="flex-1 p-4 border-l border-gray-200">
      <p class="text-xl font-bold tabular-nums"><%= @listing.baths || "—" %></p>
      <p class="text-xs text-gray-400 mt-1">Bathrooms</p>
    </div>
    <div class="flex-1 p-4 border-l border-gray-200">
      <p class="text-xl font-bold tabular-nums"><%= @listing.sqft ? number_with_delimiter(@listing.sqft) : "—" %></p>
      <p class="text-xs text-gray-400 mt-1">Interior sq ft</p>
    </div>
    <div class="flex-1 p-4 border-l border-gray-200">
      <% if is_rental %>
        <p class="text-xl font-bold tabular-nums">12 mo</p>
        <p class="text-xs text-gray-400 mt-1">Lease term</p>
      <% else %>
        <p class="text-xl font-bold tabular-nums"><%= @listing.sqft && @listing.sqft > 0 ? number_to_currency(@listing.price / @listing.sqft, precision: 0) : "—" %></p>
        <p class="text-xs text-gray-400 mt-1">Price / sq ft</p>
      <% end %>
    </div>
  </div>
</div>

<%# Body grid: main + sidebar %>
<div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-5 items-start">
  <%# Main column %>
  <div class="flex flex-col gap-4">
    <%# Ads from this listing — lazy-loaded %>
    <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5">
      <div class="p-5">
        <div class="flex justify-between items-center mb-3">
          <h3 class="font-semibold text-base">Ads built from this listing</h3>
        </div>
        <% if @listing.ads.any? %>
          <div class="flex flex-col gap-2">
            <% @listing.ads.each do |ad| %>
              <% ad_tone = %w[#2f6bff #0fb5a6 #7c5cff #e8990f #1f9d57 #e5484d][ad.id % 6] %>
              <%= link_to ad_path(ad), class: "flex items-center gap-3 p-2.5 rounded-lg border border-gray-200 hover:bg-gray-50 transition-colors" do %>
                <div class="w-16 h-10 rounded flex-none flex items-end p-1"
                    style="background: linear-gradient(135deg, #0b0d12, <%= ad_tone %>cc);">
                  <span class="text-white text-[7px] font-bold leading-none truncate"><%= ad.headline %></span>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium truncate"><%= ad.headline %></p>
                  <p class="text-xs text-gray-400">Ad</p>
                </div>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <div class="border-2 border-dashed border-gray-200 rounded-lg p-6 text-center">
            <div class="flex flex-col items-center gap-2">
              <div class="w-10 h-10 rounded-lg bg-indigo-50 grid place-items-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5a2.25 2.25 0 002.25-2.25V5.25a2.25 2.25 0 00-2.25-2.25H3.75a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 003.75 21z"/></svg>
              </div>
              <p class="text-sm font-semibold">No ads yet</p>
              <p class="text-xs text-gray-500">Turn this listing into signage in one step.</p>
              <%= link_to "Create ad", new_ad_path(listing_id: @listing.id), class: "rounded-md bg-indigo-600 px-2.5 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 mt-1" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# Sidebar column %>
  <div class="flex flex-col gap-4">
    <%# Signage performance %>
    <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5">
      <div class="p-5">
        <p class="text-3xl font-bold tabular-nums"><%= number_with_delimiter(@impressions_count) %></p>
        <p class="text-xs text-gray-400">Impressions</p>
        <div class="flex gap-4 pt-3 mt-3 border-t border-gray-200">
          <div class="flex-1 text-center">
            <p class="font-bold text-sm font-mono tabular-nums"><%= @scans_count %></p>
            <p class="text-xs text-gray-400">QR scans</p>
          </div>
          <div class="flex-1 text-center">
            <p class="font-bold text-sm font-mono tabular-nums"><%= @impressions_count > 0 ? number_to_percentage(@scans_count.to_f / @impressions_count * 100, precision: 1) : "—" %></p>
            <p class="text-xs text-gray-400">Scan-through</p>
          </div>
          <div class="flex-1 text-center">
            <p class="font-bold text-sm font-mono tabular-nums"><%= @listing.ads.count %></p>
            <p class="text-xs text-gray-400">Active ads</p>
          </div>
          <div class="flex-1 text-center">
            <p class="font-bold text-sm font-mono tabular-nums"><%= @listing.leads.count %></p>
            <p class="text-xs text-gray-400">Leads</p>
          </div>
        </div>
      </div>
    </div>

    <%# Listing agents%>
    <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5">
      <div class="flex items-center justify-between p-4 border-b border-gray-200">
        <h3 class="font-semibold text-base">Listing agents</h3>
        <%= link_to new_listing_listing_agent_path(@listing), class: "rounded-md bg-indigo-600 px-2.5 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 inline-flex items-center gap-1.5" do %>
          <svg viewBox="0 0 20 20" fill="currentColor" class="size-4"><path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z"/></svg>
          Add agent
        <% end %>
      </div>

      <div id="listing_agents_rows" class="divide-y divide-gray-100">
        <% @listing.listing_agents.each do |la| %>
          <%= render "app/listing_agents/listing_agent_row", la: la %>
        <% end %>
      </div>

      <% unless @listing.listing_agents.any? %>
        <div id="listing_agents_empty" class="p-6 text-center">
          <p class="text-sm text-gray-500">No agents assigned yet.</p>
        </div>
      <% end %>
    </div>

    <%# Note %>
    <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5">
      <div class="p-5 text-sm text-gray-500">
        <strong class="text-gray-700">Synced from MLS.</strong> Property facts update automatically on the next sync — edits here only affect how the listing appears in RePlay signage.
      </div>
    </div>
  </div>
</div>

<%# Delete action %>
<div class="mt-8 pt-4 border-t border-gray-200">
  <%= button_to "Delete listing", @listing, method: :delete, class: "rounded-md bg-white px-2.5 py-1.5 text-sm font-semibold text-red-600 shadow-xs ring-1 ring-red-300 ring-inset hover:bg-red-50",
      data: { turbo_confirm: "Are you sure you want to delete this listing?" } %>
</div>
