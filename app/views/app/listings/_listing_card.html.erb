<% tone = %w[#2f6bff #0fb5a6 #7c5cff #e8990f #1f9d57 #e5484d][listing.id % 6] %>
<div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 hover:shadow-md transition-shadow cursor-pointer group overflow-hidden">
  <%# Photo %>
  <%= link_to listing_path(listing) do %>
    <div class="h-36 relative overflow-hidden" style="background: <%= tone %>22;">
      <% if listing.photos.any? %>
        <%= image_tag listing.photos.first, class: "absolute inset-0 w-full h-full object-cover" %>
      <% else %>
        <div class="absolute inset-0" style="background: linear-gradient(160deg, <%= tone %>33, transparent 70%);"></div>
      <% end %>
      <div class="absolute top-3 right-3">
        <% if listing.status == 'active' %>
          <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-0.5 text-xs font-medium text-green-700 ring-1 ring-green-600/20 ring-inset"><%= listing.status.capitalize %></span>
        <% elsif listing.status == 'pending' %>
          <span class="inline-flex items-center rounded-full bg-yellow-50 px-2 py-0.5 text-xs font-medium text-yellow-800 ring-1 ring-yellow-600/20 ring-inset"><%= listing.status.capitalize %></span>
        <% else %>
          <span class="inline-flex items-center rounded-full bg-gray-50 px-2 py-0.5 text-xs font-medium text-gray-600 ring-1 ring-gray-500/10 ring-inset"><%= listing.status.capitalize %></span>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="p-4">
    <%= link_to listing_path(listing), class: "block" do %>
      <p class="text-lg font-bold tabular-nums"><%= number_to_currency(listing.price, precision: 0) %></p>
      <p class="text-sm text-gray-700 truncate"><%= listing.address %></p>
      <p class="text-xs text-gray-400 mt-0.5">Apartment</p>

      <%# Specs row %>
      <div class="flex items-center gap-3 mt-2 text-sm text-gray-500">
        <% if listing.beds %>
          <span class="flex items-center gap-1">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/></svg>
            <%= listing.beds %> bd
          </span>
        <% end %>
        <% if listing.baths %>
          <span class="flex items-center gap-1">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <%= listing.baths %> ba
          </span>
        <% end %>
        <% if listing.sqft %>
          <span class="flex items-center gap-1">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15"/></svg>
            <%= number_with_delimiter(listing.sqft) %>
          </span>
        <% end %>
      </div>
    <% end %>

    <%# Use in ad button %>
    <%= link_to new_ad_path(listing_id: listing.id), class: "flex items-center justify-center gap-1.5 w-full mt-3 rounded-md bg-white px-2.5 py-1.5 text-sm font-semibold text-gray-700 shadow-xs ring-1 ring-gray-300 ring-inset hover:bg-gray-50" do %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5a2.25 2.25 0 002.25-2.25V5.25a2.25 2.25 0 00-2.25-2.25H3.75a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 003.75 21z"/></svg>
      Use in ad
    <% end %>
  </div>
</div>
