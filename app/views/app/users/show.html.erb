<%= render "app/shared/page_header",
    title: "#{@user.first_name} #{@user.last_name}",
    subtitle: @user.email_address,
    back_link: { label: "← Team", path: users_path } %>

<div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-6">
  <%# Left — details %>
  <div class="space-y-6">
    <%# Contact %>
    <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
      <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-4">Contact</h3>
      <dl class="space-y-3">
        <div>
          <dt class="text-xs text-gray-500">Email</dt>
          <dd class="text-sm"><a href="mailto:<%= @user.email_address %>" class="text-indigo-600 font-semibold hover:text-indigo-500"><%= @user.email_address %></a></dd>
        </div>
        <% if @user.phone.present? %>
          <div>
            <dt class="text-xs text-gray-500">Phone</dt>
            <dd class="text-sm"><a href="tel:<%= @user.phone %>" class="text-indigo-600 font-semibold hover:text-indigo-500"><%= @user.phone %></a></dd>
          </div>
        <% end %>
      </dl>
    </div>

    <%# Agent profile %>
    <% if @agent_profile %>
      <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
        <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-4">Agent Profile</h3>
        <%= link_to agent_path(@agent_profile), class: "flex items-center gap-3 p-3 -m-1 rounded-lg hover:bg-gray-50 transition-colors" do %>
          <div class="w-10 h-10 rounded-full bg-indigo-50 grid place-items-center text-xs font-bold text-indigo-600 shrink-0 overflow-hidden">
            <% if @agent_profile.photo.attached? %>
              <%= image_tag @agent_profile.photo, class: "w-full h-full object-cover" %>
            <% else %>
              <%= @agent_profile.name.split.map(&:first).join.first(2).upcase %>
            <% end %>
          </div>
          <div>
            <p class="text-sm font-semibold"><%= @agent_profile.name %></p>
            <p class="text-xs text-gray-500"><%= @agent_profile.email %></p>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# Right — roles + meta %>
  <div class="space-y-5">
    <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
      <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">Roles</h3>
      <div class="flex flex-wrap gap-2">
        <% @roles.each do |au| %>
          <span class="inline-flex items-center rounded-md bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-gray-500/10 ring-inset"><%= au.role.capitalize %></span>
        <% end %>
      </div>
    </div>

    <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
      <p class="text-xs text-gray-400">Member since <%= @roles.minimum(:created_at)&.strftime("%b %-d, %Y") %></p>
    </div>
  </div>
</div>
