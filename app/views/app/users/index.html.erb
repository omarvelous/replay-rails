<% actions = capture do %>
  <%= link_to new_invite_path, class: "rounded-md bg-indigo-600 px-2.5 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 inline-flex items-center gap-1.5" do %>
    <svg viewBox="0 0 20 20" fill="currentColor" class="size-4"><path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z"/></svg>
    Invite user
  <% end %>
<% end %>
<%= render "app/shared/page_header", title: "Team", subtitle: "#{@users.size} members", actions: actions %>

<div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5">
  <div class="divide-y divide-gray-100">
    <% @users.each do |member| %>
      <% roles = member.account_users.select { |au| au.account_id == Current.account.id } %>
      <%= link_to user_path(member), class: "flex items-center justify-between p-4 hover:bg-gray-50 transition-colors" do %>
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-full bg-indigo-50 grid place-items-center text-xs font-bold text-indigo-600 shrink-0">
            <%= member.first_name&.first %><%= member.last_name&.first %>
          </div>
          <div>
            <p class="text-sm font-semibold"><%= member.first_name %> <%= member.last_name %></p>
            <p class="text-xs text-gray-500"><%= member.email_address %></p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <div class="flex gap-1.5">
            <% roles.each do |au| %>
              <span class="inline-flex items-center rounded-md bg-gray-50 px-1.5 py-0.5 text-[10.5px] font-medium text-gray-500 ring-1 ring-gray-500/10 ring-inset"><%= au.role.capitalize %></span>
            <% end %>
          </div>
          <svg viewBox="0 0 20 20" fill="currentColor" class="size-4 text-gray-400"><path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"/></svg>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
