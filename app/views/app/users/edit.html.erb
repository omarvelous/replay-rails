<%= render "app/shared/page_header", title: "Edit profile", subtitle: "Update your personal details." %>

<div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
  <%= form_with model: @user, url: user_path(@user), method: :patch do |form| %>
    <% if @user.errors.any? %>
      <div class="rounded-md bg-red-50 p-4 mb-4">
        <ul class="list-disc list-inside text-sm text-red-700">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-3">Personal info</p>

    <div class="grid grid-cols-2 gap-3 mb-3">
      <div>
        <%= form.label :first_name, class: "block text-sm/6 font-medium text-gray-900" %>
        <%= form.text_field :first_name, required: true,
            class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
      </div>
      <div>
        <%= form.label :last_name, class: "block text-sm/6 font-medium text-gray-900" %>
        <%= form.text_field :last_name, required: true,
            class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
      </div>
    </div>

    <div class="mb-3">
      <%= form.label :email_address, class: "block text-sm/6 font-medium text-gray-900" %>
      <%= form.email_field :email_address, required: true,
          class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
    </div>

    <div class="mb-5">
      <%= form.label :phone, class: "block text-sm/6 font-medium text-gray-900" %>
      <%= form.telephone_field :phone,
          class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
    </div>

    <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-3">Change password</p>
    <p class="text-sm text-gray-500 mb-3">Leave blank to keep your current password.</p>

    <div class="grid grid-cols-2 gap-3 mb-5">
      <div>
        <%= form.label :password, "New password", class: "block text-sm/6 font-medium text-gray-900" %>
        <%= form.password_field :password, autocomplete: "new-password",
            class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
      </div>
      <div>
        <%= form.label :password_confirmation, "Confirm password", class: "block text-sm/6 font-medium text-gray-900" %>
        <%= form.password_field :password_confirmation, autocomplete: "new-password",
            class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
      </div>
    </div>

    <div class="flex items-center justify-between pt-4 border-t border-gray-200">
      <%= link_to "Cancel", user_path(@user), class: "text-sm font-semibold text-gray-600 hover:text-gray-900" %>
      <%= form.submit "Save changes", class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
    </div>
  <% end %>
</div>
