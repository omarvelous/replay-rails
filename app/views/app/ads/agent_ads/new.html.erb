<%= render "app/shared/page_header", title: "New Agent Ad", back_link: { label: "← Ads", path: ads_path } %>

<div data-controller="ad-builder" data-ad-builder-preview-url-value="<%= preview_ads_agent_ads_path %>">
  <%= form_with model: @ad, url: ads_agent_ads_path, data: { ad_builder_target: "form" } do |form| %>
    <%= render "app/ads/agent_ads/form", form: form %>
  <% end %>
</div>
