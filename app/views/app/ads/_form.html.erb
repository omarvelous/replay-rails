<% tone = ad.persisted? ? %w[#2f6bff #0fb5a6 #7c5cff #e8990f #1f9d57 #e5484d][ad.id % 6] : "#2f6bff" %>

<%= form_with model: ad, data: { controller: "ad-preview" } do |form| %>
  <% if ad.errors.any? %>
    <div class="rounded-md bg-red-50 p-4 mb-5">
      <div class="flex">
        <div class="shrink-0">
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5 text-red-400"><path d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM8.28 7.22a.75.75 0 0 0-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 1 0 1.06 1.06L10 11.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L11.06 10l1.72-1.72a.75.75 0 0 0-1.06-1.06L10 8.94 8.28 7.22Z" clip-rule="evenodd" fill-rule="evenodd" /></svg>
        </div>
        <div class="ml-3">
          <ul class="list-disc list-inside text-sm text-red-700">
            <% ad.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-[1fr_380px] gap-6 items-start">
    <%# Left — Live preview canvas %>
    <div>
      <div class="rounded-lg overflow-hidden shadow-sm ring-1 ring-gray-900/5">
        <%# Preview stage %>
        <div class="bg-gray-100 p-8 flex items-center justify-center">
          <div class="w-full aspect-video rounded-lg overflow-hidden relative flex flex-col justify-end p-6"
               style="background: linear-gradient(135deg, #0b0d12, <%= tone %>);"
               data-ad-preview-target="canvas">
            <div class="text-white">
              <div class="text-xs font-bold tracking-wider mb-1" style="color: <%= tone %>cc;">FOR SALE</div>
              <div class="text-3xl font-extrabold tracking-tight leading-tight" data-ad-preview-target="previewHeadline"><%= ad.headline.presence || "Your headline here" %></div>
              <div class="text-sm opacity-80 mt-2 max-w-lg" data-ad-preview-target="previewBody"><%= ad.body.presence || "Add a subheadline or description" %></div>
            </div>
            <div class="absolute right-6 bottom-6 w-14 h-14 bg-white rounded-lg"></div>
          </div>
        </div>
        <div class="px-5 py-3 flex items-center justify-between bg-white border-t border-gray-100">
          <span class="inline-flex items-center rounded-md bg-gray-50 px-1.5 py-0.5 text-xs font-medium text-gray-500 ring-1 ring-gray-500/10 ring-inset">16:9 · 1920×1080</span>
          <span class="text-xs text-gray-400">Live preview — edits apply instantly</span>
        </div>
      </div>
    </div>

    <%# Right — Form fields %>
    <div class="flex flex-col gap-5">
      <%# Content section %>
      <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
        <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-4">Content</h3>

        <div class="mb-4">
          <%= form.label :headline, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.text_field :headline, required: true, autofocus: true, placeholder: "e.g. Just Listed in Bushwick",
              class: "block w-full rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600",
              data: { action: "input->ad-preview#updateHeadline" } %>
        </div>

        <div class="mb-4">
          <%= form.label :body, "Subheadline", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.text_area :body, rows: 2, placeholder: "Sun-filled 3-bedroom with private garden",
              class: "block w-full rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600",
              data: { action: "input->ad-preview#updateBody" } %>
        </div>
      </div>

      <%# Linked listing section %>
      <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
        <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-4">Linked listing</h3>

        <div class="mb-3">
          <%= form.select :listing_id,
              Current.account.listings.order(:address).map { |l| ["#{l.address} — #{number_to_currency(l.price, precision: 0)}", l.id] },
              { include_blank: "None — standalone ad" },
              class: "block w-full rounded-md bg-white py-2 pl-3 pr-8 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" %>
        </div>

        <div class="flex gap-3 p-3 rounded-lg bg-indigo-50">
          <div class="w-7 h-7 bg-white rounded-md shrink-0 grid place-items-center">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-3.5 text-indigo-600"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 013.75 9.375v-4.5z"/></svg>
          </div>
          <p class="text-xs text-indigo-800 leading-relaxed">A tracked <strong>QR code</strong> is auto-generated and links to this listing's mobile page.</p>
        </div>
      </div>

      <%# Actions %>
      <div class="flex items-center justify-between pt-2">
        <%= link_to "Cancel", (ad.persisted? ? ad_path(ad) : ads_path), class: "text-sm font-semibold text-gray-600 hover:text-gray-900" %>
        <div class="flex gap-3">
          <% if ad.persisted? %>
            <button class="rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-xs ring-1 ring-gray-300 ring-inset hover:bg-gray-50" title="Duplicate" type="button">Duplicate</button>
          <% end %>
          <%= form.submit ad.persisted? ? "Save changes" : "Publish ad",
              class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500" %>
        </div>
      </div>
    </div>
  </div>
<% end %>
