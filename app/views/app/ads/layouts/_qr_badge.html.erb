<% qr = ad.listing&.qr_code %>
<div class="absolute bg-white flex items-center justify-center"
     style="right: var(--s-pad-lg); bottom: var(--s-pad-lg); width: var(--s-qr); aspect-ratio: 1; padding: var(--s-xs); border-radius: var(--s-xs);">
  <% if qr %>
    <div class="w-full h-full" style="line-height: 0;">
      <%= qr_svg(qr, ad: ad, screen: defined?(@screen) ? @screen : nil) %>
    </div>
  <% else %>
    <span class="grid place-items-center w-full h-full"
          style="font-size: var(--s-sm); color: #999;">QR</span>
  <% end %>
</div>
