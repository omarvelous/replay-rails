<div class="ad-canvas aspect-video flex"
     style="background: var(--ad-bg); color: var(--ad-text); <%= ad_theme_style(ad.theme) %>">
  <%# Left: image/gradient area %>
  <div class="w-1/2 relative overflow-hidden" style="background: linear-gradient(135deg, var(--ad-bg), color-mix(in srgb, var(--ad-accent) 20%, transparent));">
    <% if ad.image.attached? %>
      <%= image_tag ad.image.variant(:preview), class: "absolute inset-0 w-full h-full object-cover" %>
    <% end %>
    <% qr = ad.listing&.qr_code %>
    <% if qr %>
      <div class="absolute rounded-xl overflow-hidden bg-white"
           style="bottom: var(--s-pad); left: var(--s-pad); width: var(--s-qr); height: var(--s-qr); padding: var(--s-xs);">
        <%= qr_svg(qr, ad: ad, screen: defined?(@screen) ? @screen : nil) %>
      </div>
    <% end %>
  </div>
  <%# Right: content %>
  <div class="w-1/2 flex flex-col justify-center" style="padding: var(--s-pad-lg);">
    <%= render "app/ads/#{ad.adable_name.pluralize}/content", ad: ad %>
  </div>
</div>
