<%# Layout picker %>
<div class="mb-4">
  <%= form.label :layout, class: "block text-sm font-medium text-gray-700 mb-2" %>
  <div class="flex flex-wrap gap-2">
    <% layouts.each do |layout_name| %>
      <label class="cursor-pointer">
        <%= form.radio_button :layout, layout_name, class: "peer sr-only" %>
        <span class="peer-checked:ring-2 peer-checked:ring-indigo-600 peer-checked:bg-indigo-50 peer-checked:text-indigo-700 inline-flex items-center rounded-md bg-white px-3 py-1.5 text-sm font-medium text-gray-600 ring-1 ring-gray-300 ring-inset hover:bg-gray-50 transition-colors">
          <%= layout_name.humanize %>
        </span>
      </label>
    <% end %>
  </div>
</div>

<%# Theme picker %>
<div class="mb-4">
  <%= form.label :theme, class: "block text-sm font-medium text-gray-700 mb-2" %>
  <div class="flex gap-3">
    <% Ad::THEMES.each do |theme_name| %>
      <label class="cursor-pointer">
        <%= form.radio_button :theme, theme_name, class: "peer sr-only" %>
        <span class="peer-checked:ring-2 peer-checked:ring-indigo-600 flex items-center gap-2 rounded-lg px-3 py-2 ring-1 ring-gray-200 hover:bg-gray-50 transition-colors">
          <% bg = { "dark" => "#0b0d12", "light" => "#f9fafb", "brand" => "#2f6bff" }[theme_name] %>
          <span class="w-5 h-5 rounded-full border border-gray-300" style="background: <%= bg %>;"></span>
          <span class="text-sm font-medium text-gray-700"><%= theme_name.capitalize %></span>
        </span>
        <% if theme_name == "light" %>
          <span class="text-[10px] text-amber-600 block mt-0.5">May be hard to read in sunlight</span>
        <% end %>
      </label>
    <% end %>
  </div>
</div>
