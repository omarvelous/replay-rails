<%= render "app/ads/shared/errors", ad: @ad %>

<div class="grid grid-cols-1 lg:grid-cols-[1fr_380px] gap-6 items-start">
  <%# Left — Live preview %>
  <div>
    <%= render "app/ads/shared/preview_canvas", ad: @ad %>
  </div>

  <%# Right — Form fields %>
  <div class="flex flex-col gap-5">
    <%# Content fields %>
    <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
      <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-4">Content</h3>
      <%= render "app/ads/shared/content_fields", form: form %>
    </div>

    <%# Image %>
    <%= render "app/ads/shared/image_field", form: form, ad: @ad %>

    <%# Appearance %>
    <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
      <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-4">Appearance</h3>
      <%= render "app/ads/shared/appearance_fields", form: form, layouts: ::Ads::BrandAd::LAYOUTS %>
    </div>

    <%# Actions %>
    <%= render "app/ads/shared/form_actions", form: form, ad: @ad %>
  </div>
</div>
