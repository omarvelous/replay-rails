<%= render "app/shared/page_header", title: "New Ad", subtitle: "Choose an ad type", back_link: { label: "← Ads", path: ads_path } %>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
  <%= link_to new_ads_listing_ad_path, class: "rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 hover:shadow-md hover:ring-indigo-300 transition-all p-6 text-center" do %>
    <div class="w-12 h-12 rounded-xl bg-indigo-50 grid place-items-center mx-auto mb-3">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-6 h-6 text-indigo-600"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3H21"/></svg>
    </div>
    <p class="font-semibold text-sm text-gray-900">Listing Ad</p>
    <p class="text-xs text-gray-500 mt-1">Single property</p>
  <% end %>

  <%= link_to new_ads_collection_ad_path, class: "rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 hover:shadow-md hover:ring-emerald-300 transition-all p-6 text-center" do %>
    <div class="w-12 h-12 rounded-xl bg-emerald-50 grid place-items-center mx-auto mb-3">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-6 h-6 text-emerald-600"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"/></svg>
    </div>
    <p class="font-semibold text-sm text-gray-900">Collection</p>
    <p class="text-xs text-gray-500 mt-1">Multiple properties</p>
  <% end %>

  <%= link_to new_ads_agent_ad_path, class: "rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 hover:shadow-md hover:ring-amber-300 transition-all p-6 text-center" do %>
    <div class="w-12 h-12 rounded-xl bg-amber-50 grid place-items-center mx-auto mb-3">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-6 h-6 text-amber-600"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
    </div>
    <p class="font-semibold text-sm text-gray-900">Agent</p>
    <p class="text-xs text-gray-500 mt-1">Agent spotlight</p>
  <% end %>

  <%= link_to new_ads_brand_ad_path, class: "rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 hover:shadow-md hover:ring-purple-300 transition-all p-6 text-center" do %>
    <div class="w-12 h-12 rounded-xl bg-purple-50 grid place-items-center mx-auto mb-3">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-6 h-6 text-purple-600"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z"/></svg>
    </div>
    <p class="font-semibold text-sm text-gray-900">Brand</p>
    <p class="text-xs text-gray-500 mt-1">Freeform</p>
  <% end %>
</div>
