<% actions = capture do %>
  <%= link_to preview_ad_path(@ad), class: "rounded-md bg-white px-2.5 py-1.5 text-sm font-semibold text-gray-900 shadow-xs ring-1 ring-gray-300 ring-inset hover:bg-gray-50 inline-flex items-center gap-1.5", target: "_blank" do %>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
    Preview
  <% end %>
  <%= link_to edit_typed_ad_path(@ad), class: "rounded-md bg-white px-2.5 py-1.5 text-sm font-semibold text-gray-900 shadow-xs ring-1 ring-gray-300 ring-inset hover:bg-gray-50 inline-flex items-center gap-1.5" do %>
    Edit
  <% end %>
<% end %>
<%= render "app/shared/page_header", title: @ad.headline, subtitle: "Ad", actions: actions, back_link: { label: "← Ads", path: ads_path } %>

<div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-5 items-start">
  <%# Main column %>
  <div class="flex flex-col gap-5">
    <%# Live preview card %>
    <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 overflow-hidden">
      <%= render "app/ads/layouts/#{@ad.layout}", ad: @ad %>
      <div class="px-5 py-3 flex items-center justify-between border-t border-gray-100">
        <span class="inline-flex items-center rounded-md bg-gray-50 px-1.5 py-0.5 text-xs font-medium text-gray-500 ring-1 ring-gray-500/10 ring-inset">16:9 · 1920×1080</span>
        <span class="text-xs text-gray-400">Live preview</span>
      </div>
    </div>

    <%# Content card %>
    <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
      <h3 class="text-sm font-semibold mb-3">Content</h3>
      <div class="space-y-3">
        <div>
          <label class="text-xs font-medium text-gray-500 uppercase tracking-wider">Headline</label>
          <p class="text-sm font-semibold mt-0.5"><%= @ad.headline %></p>
        </div>
        <% if @ad.body.present? %>
          <div>
            <label class="text-xs font-medium text-gray-500 uppercase tracking-wider">Body</label>
            <p class="text-sm text-gray-700 mt-0.5"><%= @ad.body %></p>
          </div>
        <% end %>
      </div>
    </div>

    <%# Playlists section %>
    <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5">
      <div class="p-4 border-b border-gray-200">
        <h3 class="text-sm font-semibold">In playlists</h3>
      </div>
      <% if @playlists.any? %>
        <div class="divide-y divide-gray-100">
          <% @playlists.each do |playlist| %>
            <%= link_to playlist_path(playlist), class: "flex items-center gap-3 px-4 py-3 hover:bg-gray-50 transition-colors" do %>
              <div class="w-10 h-10 rounded-lg grid place-items-center shrink-0" style="background: #2f6bff14; color: #2f6bff;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 010 3.75H5.625a1.875 1.875 0 010-3.75z"/></svg>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium truncate"><%= playlist.name %></p>
                <p class="text-xs text-gray-400"><%= playlist.playlist_ads.size %> slides</p>
              </div>
              <% if playlist.status == "published" %>
                <span class="inline-flex items-center gap-1 rounded-full bg-green-50 px-2 py-0.5 text-xs font-medium text-green-700 ring-1 ring-green-600/20 ring-inset">
                  <span class="size-1.5 rounded-full bg-green-500"></span>
                  Live
                </span>
              <% else %>
                <span class="inline-flex items-center gap-1 rounded-full bg-yellow-50 px-2 py-0.5 text-xs font-medium text-yellow-800 ring-1 ring-yellow-600/20 ring-inset">
                  <span class="size-1.5 rounded-full bg-yellow-500"></span>
                  Draft
                </span>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="p-6 text-center">
          <p class="text-sm text-gray-500">This ad is not in any playlists yet.</p>
        </div>
      <% end %>
    </div>
  </div>

  <%# Sidebar %>
  <div class="flex flex-col gap-5">
    <%# Details card %>
    <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
      <h3 class="text-sm font-semibold mb-3">Details</h3>
      <div class="divide-y divide-gray-100">
        <div class="flex justify-between py-2 text-sm">
          <span class="text-gray-500">Type</span>
          <span class="inline-flex items-center rounded-md bg-gray-50 px-1.5 py-0.5 text-xs font-medium text-gray-500 ring-1 ring-gray-500/10 ring-inset"><%= @ad.adable_name.humanize %></span>
        </div>
        <div class="flex justify-between py-2 text-sm">
          <span class="text-gray-500">Layout</span>
          <span class="font-medium"><%= @ad.layout.humanize %></span>
        </div>
        <div class="flex justify-between py-2 text-sm">
          <span class="text-gray-500">Theme</span>
          <span class="font-medium"><%= @ad.theme.capitalize %></span>
        </div>
      </div>
    </div>

    <%# Linked listing card %>
    <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
      <h3 class="text-sm font-semibold mb-3">Linked listing</h3>
      <% if @ad.listing %>
        <%= link_to listing_path(@ad.listing), class: "flex items-center gap-3 p-3 -mx-1 rounded-lg border border-gray-200 hover:border-gray-300 hover:bg-gray-50 transition-colors" do %>
          <div class="w-12 h-9 rounded flex-none bg-indigo-50"></div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium truncate"><%= @ad.listing.address %></p>
            <p class="text-xs text-gray-400"><%= number_to_currency(@ad.listing.price, precision: 0) %> · <%= @ad.listing.beds %> bd · <%= @ad.listing.baths %> ba</p>
          </div>
        <% end %>
      <% else %>
        <p class="text-sm text-gray-500">No listing linked.</p>
      <% end %>
    </div>

    <%# Performance card (stubbed) %>
    <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
      <h3 class="text-sm font-semibold mb-3">Performance</h3>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <p class="text-2xl font-bold tabular-nums"><%= @scan_count %></p>
          <p class="text-xs text-gray-400">QR scans</p>
        </div>
        <div>
          <p class="text-2xl font-bold tabular-nums">0%</p>
          <p class="text-xs text-gray-400">Scan-through</p>
        </div>
      </div>
      <div class="h-10 bg-gray-100 rounded mt-3"></div>
    </div>

    <%# QR explainer %>
    <div class="rounded-lg bg-indigo-50 p-4 flex gap-3">
      <div class="w-8 h-8 bg-white rounded-md shrink-0 grid place-items-center">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-4 text-indigo-600"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 013.75 9.375v-4.5zM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 01-1.125-1.125v-4.5zM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0113.5 9.375v-4.5z"/></svg>
      </div>
      <div>
        <p class="text-sm text-indigo-900 font-medium">A tracked <strong>QR code</strong> is auto-generated and links to this listing's mobile page.</p>
      </div>
    </div>
  </div>
</div>

<%# Danger zone %>
<div class="mt-8 pt-4 border-t border-gray-200">
  <%= button_to "Delete ad", @ad, method: :delete,
      class: "rounded-md bg-white px-2.5 py-1.5 text-sm font-semibold text-red-600 shadow-xs ring-1 ring-red-300 ring-inset hover:bg-red-50",
      data: { turbo_confirm: "Are you sure you want to delete this ad?" } %>
</div>
