<%= render "app/shared/page_header", title: "Pair a player", subtitle: @screen.name, back_link: { label: "← Screen", path: screen_path(@screen) } %>

<div class="max-w-md">
  <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-6">
    <p class="text-sm text-gray-600 mb-5">
      Enter the 6-character code shown on the TV to pair it with this screen.
    </p>

    <%= form_with url: screen_screen_player_path(@screen), method: :post do |form| %>
      <div class="mb-4">
        <%= form.label :code, "Pairing code", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_field :code, autofocus: true, autocomplete: "off", spellcheck: false,
            placeholder: "e.g. A7B3K2",
            class: "block w-full rounded-md bg-white px-3 py-2 text-lg font-mono tracking-widest text-center text-gray-900 uppercase outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600",
            maxlength: 6 %>
      </div>

      <div class="flex items-center justify-between">
        <%= link_to "Cancel", screen_path(@screen), class: "text-sm font-semibold text-gray-600 hover:text-gray-900" %>
        <%= form.submit "Pair device", class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <div class="mt-5 rounded-lg bg-indigo-50 p-4 flex gap-3">
    <div class="w-7 h-7 bg-white rounded-md shrink-0 grid place-items-center">
      <svg viewBox="0 0 20 20" fill="currentColor" class="size-4 text-indigo-600"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd"/></svg>
    </div>
    <p class="text-xs text-indigo-800 leading-relaxed">
      On the TV, navigate to <strong>replay.com/player</strong> and the code will appear on screen.
      The code expires after 10 minutes.
    </p>
  </div>
</div>
