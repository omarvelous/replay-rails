<%= render "app/shared/page_header", title: "Settings", subtitle: "Manage your account settings." %>

<div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
  <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-3">Account</p>

  <%= form_with model: @account, url: settings_path, method: :patch do |form| %>
    <% if @account.errors.any? %>
      <div class="rounded-md bg-red-50 p-4 mb-4">
        <ul class="list-disc list-inside text-sm text-red-700">
          <% @account.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-4">
      <%= form.label :name, "Company / brokerage name", class: "block text-sm/6 font-medium text-gray-900" %>
      <%= form.text_field :name,
          disabled: !allowed_to?(:update?, @account, with: SettingsPolicy),
          class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6 disabled:bg-gray-50 disabled:text-gray-500" %>
    </div>

    <% if allowed_to?(:update?, @account, with: SettingsPolicy) %>
      <div class="flex items-center justify-end pt-4 border-t border-gray-200">
        <%= form.submit "Save changes", class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
      </div>
    <% end %>
  <% end %>
</div>
