<% actions = capture do %>
  <%= link_to preview_playlist_path(@playlist), class: "rounded-md bg-white px-2.5 py-1.5 text-sm font-semibold text-gray-900 shadow-xs ring-1 ring-gray-300 ring-inset hover:bg-gray-50 inline-flex items-center gap-1.5", target: "_blank" do %>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
    Preview
  <% end %>
  <%= link_to edit_playlist_path(@playlist), class: "rounded-md bg-white px-2.5 py-1.5 text-sm font-semibold text-gray-900 shadow-xs ring-1 ring-gray-300 ring-inset hover:bg-gray-50 inline-flex items-center gap-1.5", data: { turbo_frame: "modal" } do %>
    Edit
  <% end %>
<% end %>
<%= render "shared/page_header", title: @playlist.name, subtitle: "Playlist", actions: actions, back_link: { label: "← Playlists", path: playlists_path } %>

<% total_dur = @playlist.playlist_ads.sum(&:duration) %>
<% mmss = ->(s) { "#{s / 60}:#{(s % 60).to_s.rjust(2, '0')}" } %>

<%# Header card %>
<div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5 mb-5">
  <div class="flex items-start justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-lg grid place-items-center shrink-0" style="background: #2f6bff14; color: #2f6bff;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 010 3.75H5.625a1.875 1.875 0 010-3.75z"/></svg>
      </div>
      <div>
        <h2 class="text-lg font-bold tracking-tight"><%= @playlist.name %></h2>
        <p class="text-xs text-gray-400 mt-0.5">
          Assigned to <%= @playlist.screen_playlists.count %> screens ·
          <% if @playlist.status == "published" %>
            <span class="text-green-600">Published v1</span>
          <% else %>
            <span class="text-yellow-600">Draft</span>
          <% end %>
        </p>
      </div>
    </div>
    <span class="text-sm font-mono text-gray-500 flex items-center gap-1.5 shrink-0">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <%= mmss.call(total_dur) %> loop
    </span>
  </div>

  <%# Loop timeline %>
  <% if total_dur > 0 %>
    <div class="mt-4">
      <div class="flex justify-between mb-1.5">
        <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Loop timeline</span>
        <span class="text-xs font-mono text-gray-400"><%= @playlist.playlist_ads.size %> slides · <%= mmss.call(total_dur) %></span>
      </div>
      <div class="flex h-3 rounded-full overflow-hidden bg-gray-100 gap-0.5">
        <% @playlist.playlist_ads.order(:position).each do |pa| %>
          <% seg_tone = %w[#2f6bff #0fb5a6 #7c5cff #e8990f #1f9d57 #e5484d][pa.ad_id % 6] %>
          <div style="width: <%= (pa.duration.to_f / total_dur * 100).round(1) %>%; background: <%= seg_tone %>;"
               class="rounded-sm opacity-80 hover:opacity-100 transition-opacity"></div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<%# Sequence list %>
<div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5">
  <div class="flex items-center justify-between p-4 border-b border-gray-200">
    <h3 class="text-sm font-semibold">Sequence</h3>
    <%= link_to new_playlist_playlist_ad_path(@playlist), class: "rounded-md bg-indigo-600 px-2.5 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 inline-flex items-center gap-1.5", data: { turbo_frame: "modal" } do %>
      <svg viewBox="0 0 20 20" fill="currentColor" class="size-4"><path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z"/></svg>
      Add content
    <% end %>
  </div>

  <% playlist_ads = @playlist.playlist_ads.includes(:ad).order(:position) %>
  <% if playlist_ads.any? %>
    <div class="divide-y divide-gray-100">
      <% playlist_ads.each_with_index do |pa, i| %>
        <% tone = %w[#2f6bff #0fb5a6 #7c5cff #e8990f #1f9d57 #e5484d][pa.ad_id % 6] %>
        <div class="flex items-center gap-4 px-4 py-3 hover:bg-gray-50 transition-colors">
          <span class="text-xs font-mono text-gray-400 w-5 text-right shrink-0"><%= i + 1 %></span>
          <div class="w-14 h-9 rounded flex-none relative overflow-hidden" style="background: linear-gradient(135deg, #14171f, <%= tone %>);">
            <div class="absolute inset-0 flex items-end p-1">
              <span class="text-white text-[6px] font-bold leading-none truncate"><%= pa.ad.headline %></span>
            </div>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium truncate"><%= pa.ad.headline %></p>
            <p class="text-xs text-gray-400">Ad</p>
          </div>
          <span class="text-sm font-mono text-gray-500 shrink-0"><%= pa.duration %>s</span>
          <div class="flex items-center gap-1 shrink-0">
            <%= link_to edit_playlist_playlist_ad_path(@playlist, pa), class: "text-gray-400 hover:text-gray-600 p-1", data: { turbo_frame: "modal" } do %>
              <svg viewBox="0 0 20 20" fill="currentColor" class="size-4"><path d="m5.433 13.917 1.262-3.155A4 4 0 0 1 7.58 9.42l6.92-6.918a2.121 2.121 0 0 1 3 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 0 1-.65-.65Z"/><path d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0 0 10 3H4.75A2.75 2.75 0 0 0 2 5.75v9.5A2.75 2.75 0 0 0 4.75 18h9.5A2.75 2.75 0 0 0 17 15.25V10a.75.75 0 0 0-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5Z"/></svg>
            <% end %>
            <%= button_to playlist_playlist_ad_path(@playlist, pa), method: :delete, class: "text-gray-400 hover:text-red-500 p-1", data: { turbo_confirm: "Remove?" } do %>
              <svg viewBox="0 0 20 20" fill="currentColor" class="size-4"><path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"/></svg>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="p-8 text-center">
      <p class="text-sm text-gray-500">No content in this playlist yet.</p>
      <p class="text-xs text-gray-400 mt-1">Add ads to build your signage loop.</p>
    </div>
  <% end %>
</div>

<%# Assigned screens %>
<div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 mt-5">
  <div class="p-4 border-b border-gray-200">
    <h3 class="text-sm font-semibold">Assigned to screens</h3>
  </div>
  <% assigned = @playlist.screen_playlists.includes(screen: :site).where(active: true) %>
  <% if assigned.any? %>
    <div class="divide-y divide-gray-100">
      <% assigned.each do |sp| %>
        <div class="flex items-center gap-3 px-4 py-3">
          <div class="w-12 h-8 rounded bg-gray-900 flex-none flex items-center justify-center">
            <span class="text-white/20 text-[7px]">Preview</span>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium truncate"><%= sp.screen.name %></p>
            <p class="text-xs text-gray-400"><%= sp.screen.site.name %></p>
          </div>
          <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-0.5 text-xs font-medium text-green-700 ring-1 ring-green-600/20 ring-inset">Live</span>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="p-6 text-center">
      <p class="text-sm text-gray-500">Not assigned to any screens.</p>
    </div>
  <% end %>
</div>

<%# Danger zone %>
<div class="mt-8 pt-4 border-t border-gray-200">
  <%= button_to "Delete playlist", @playlist, method: :delete,
      class: "rounded-md bg-white px-2.5 py-1.5 text-sm font-semibold text-red-600 shadow-xs ring-1 ring-red-300 ring-inset hover:bg-red-50",
      data: { turbo_confirm: "Are you sure you want to delete this playlist?" } %>
</div>
