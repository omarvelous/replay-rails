<div class="mx-auto md:w-2/3 w-full">
  <div class="flex justify-between items-center mb-5">
    <h1 class="font-bold text-4xl"><%= @playlist.name %></h1>
    <div class="flex gap-2">
      <%= link_to "Preview", preview_playlist_path(@playlist), class: "btn btn-primary btn-sm", target: "_blank" %>
      <%= link_to "Edit", edit_playlist_path(@playlist), class: "btn btn-ghost btn-sm" %>
      <%= button_to "Delete", @playlist, method: :delete, class: "btn btn-error btn-sm",
          data: { turbo_confirm: "Are you sure?" } %>
    </div>
  </div>

  <p class="mb-5">
    <span class="badge <%= @playlist.status == 'published' ? 'badge-success' : 'badge-neutral' %>">
      <%= @playlist.status.capitalize %>
    </span>
  </p>

  <%= turbo_frame_tag "playlist_ads", src: playlist_playlist_ads_path(@playlist) do %>
  <% end %>
</div>
