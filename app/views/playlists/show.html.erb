<% actions = capture do %>
  <%= link_to preview_playlist_path(@playlist), class: "rounded-md bg-white px-2.5 py-1.5 text-sm font-semibold text-gray-900 shadow-xs ring-1 ring-gray-300 ring-inset hover:bg-gray-50 inline-flex items-center gap-1.5", target: "_blank" do %>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
    Preview
  <% end %>
  <%= link_to edit_playlist_path(@playlist), class: "rounded-md bg-white px-2.5 py-1.5 text-sm font-semibold text-gray-900 shadow-xs ring-1 ring-gray-300 ring-inset hover:bg-gray-50 inline-flex items-center gap-1.5", data: { turbo_frame: "modal" } do %>
    Edit
  <% end %>
<% end %>
<%= render "shared/page_header", title: @playlist.name, subtitle: "Playlist", actions: actions, back_link: { label: "← Playlists", path: playlists_path } %>

<%# Header card %>
<div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5 mb-5">
  <div class="flex items-start justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-lg grid place-items-center shrink-0" style="background: #2f6bff14; color: #2f6bff;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 010 3.75H5.625a1.875 1.875 0 010-3.75z"/></svg>
      </div>
      <div>
        <h2 class="text-lg font-bold tracking-tight"><%= @playlist.name %></h2>
        <p class="text-xs text-gray-400 mt-0.5">
          Assigned to <%= @playlist.screen_playlists.count %> screens ·
          <% if @playlist.status == "published" %>
            <span class="text-green-600">Published v1</span>
          <% else %>
            <span class="text-yellow-600">Draft</span>
          <% end %>
        </p>
      </div>
    </div>
  </div>
</div>

<%# Loop timeline — lazy-loaded from playlist_ads/timeline %>
<div class="mb-5">
  <%= turbo_frame_tag "playlist_timeline", src: timeline_playlist_playlist_ads_path(@playlist), loading: :lazy %>
</div>

<%# Sequence list — lazy-loaded from playlist_ads/index %>
<%= turbo_frame_tag "playlist_ads", src: playlist_playlist_ads_path(@playlist), loading: :lazy %>

<%# Assigned screens — lazy-loaded %>
<div class="mt-5">
  <%= turbo_frame_tag "playlist_screens", src: screens_playlist_path(@playlist), loading: :lazy %>
</div>

<%# Danger zone %>
<div class="mt-8 pt-4 border-t border-gray-200">
  <%= button_to "Delete playlist", @playlist, method: :delete,
      class: "rounded-md bg-white px-2.5 py-1.5 text-sm font-semibold text-red-600 shadow-xs ring-1 ring-red-300 ring-inset hover:bg-red-50",
      data: { turbo_confirm: "Are you sure you want to delete this playlist?" } %>
</div>
