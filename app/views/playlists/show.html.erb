<div class="mx-auto md:w-2/3 w-full">
  <div class="flex justify-between items-center mb-5">
    <h1 class="font-bold text-4xl"><%= @playlist.name %></h1>
    <div class="flex gap-2">
      <%= link_to "Preview", preview_playlist_path(@playlist), class: "rounded-md bg-indigo-600 px-2.5 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500", target: "_blank" %>
      <%= link_to "Edit", edit_playlist_path(@playlist), class: "text-sm font-semibold text-gray-600 hover:text-gray-900" %>
      <%= button_to "Delete", @playlist, method: :delete, class: "rounded-md bg-white px-2 py-1 text-xs font-semibold text-red-600 shadow-xs ring-1 ring-red-300 ring-inset hover:bg-red-50",
          data: { turbo_confirm: "Are you sure?" } %>
    </div>
  </div>

  <p class="mb-5">
    <% if @playlist.status == 'published' %>
      <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-green-600/20 ring-inset"><%= @playlist.status.capitalize %></span>
    <% else %>
      <span class="inline-flex items-center rounded-full bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-gray-500/10 ring-inset"><%= @playlist.status.capitalize %></span>
    <% end %>
  </p>

  <%= turbo_frame_tag "playlist_ads", src: playlist_playlist_ads_path(@playlist) do %>
  <% end %>
</div>
