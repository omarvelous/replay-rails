<div class="mx-auto md:w-2/3 w-full">
  <div class="flex justify-between items-center mb-5">
    <h1 class="font-bold text-4xl"><%= @playlist.name %></h1>
    <div class="flex gap-2">
      <%= link_to "Preview", preview_playlist_path(@playlist), class: "btn btn-primary btn-sm", target: "_blank" %>
      <%= link_to "Edit", edit_playlist_path(@playlist), class: "btn btn-ghost btn-sm" %>
      <%= button_to "Delete", @playlist, method: :delete, class: "btn btn-error btn-sm",
          data: { turbo_confirm: "Are you sure?" } %>
    </div>
  </div>

  <p class="mb-5">
    <span class="badge badge-<%= @playlist.status == 'published' ? 'success' : 'ghost' %>">
      <%= @playlist.status.capitalize %>
    </span>
  </p>

  <div class="flex justify-between items-center mb-3">
    <h2 class="font-bold text-2xl">Ads</h2>
    <%= link_to "Add Ad", new_playlist_ad_path(@playlist), class: "btn btn-primary btn-sm" %>
  </div>

  <% if @playlist.playlist_ads.any? %>
    <div class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th>#</th>
            <th>Headline</th>
            <th>Duration</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @playlist.playlist_ads.includes(:ad).each do |pa| %>
            <tr>
              <td><%= pa.position %></td>
              <td><%= link_to pa.ad.headline, ad_path(pa.ad), class: "link" %></td>
              <td><%= pa.duration %>s</td>
              <td class="text-right">
                <%= link_to "Edit", edit_playlist_ad_path(@playlist, pa), class: "link link-hover text-sm mr-2" %>
                <%= button_to "Remove", playlist_ad_path(@playlist, pa), method: :delete,
                    class: "btn btn-error btn-xs",
                    data: { turbo_confirm: "Remove this ad?" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-base-content/60">No ads in this playlist yet.</p>
  <% end %>
</div>
