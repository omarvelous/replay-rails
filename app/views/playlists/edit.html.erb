<% actions = capture do %>
  <%= link_to preview_playlist_path(@playlist), class: "rounded-md bg-white px-2.5 py-1.5 text-sm font-semibold text-gray-900 shadow-xs ring-1 ring-gray-300 ring-inset hover:bg-gray-50 inline-flex items-center gap-1.5", target: "_blank" do %>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
    Preview loop
  <% end %>
<% end %>
<%= render "shared/page_header", title: @playlist.name, subtitle: "Edit playlist", actions: actions, back_link: { label: "← Playlists", path: playlists_path } %>

<% playlist_ads = @playlist.playlist_ads.includes(:ad).order(:position) %>
<% total_dur = playlist_ads.sum(&:duration) %>
<% mmss = ->(s) { "#{s / 60}:#{(s % 60).to_s.rjust(2, '0')}" } %>

<%= form_with model: @playlist do |form| %>
  <% if @playlist.errors.any? %>
    <div class="rounded-md bg-red-50 p-4 mb-5">
      <div class="flex">
        <div class="shrink-0">
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5 text-red-400"><path d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM8.28 7.22a.75.75 0 0 0-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 1 0 1.06 1.06L10 11.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L11.06 10l1.72-1.72a.75.75 0 0 0-1.06-1.06L10 8.94 8.28 7.22Z" clip-rule="evenodd" fill-rule="evenodd" /></svg>
          </div>
        <div class="ml-3">
          <ul class="list-disc list-inside text-sm text-red-700">
            <% @playlist.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-[1fr_380px] gap-6 items-start">
    <%# Left — sequence editor %>
    <div class="flex flex-col gap-5">
      <%# Loop timeline %>
      <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
        <div class="flex justify-between mb-2">
          <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Loop timeline</span>
          <span class="text-xs font-mono text-gray-400"><%= playlist_ads.size %> slides · <%= mmss.call(total_dur) %></span>
        </div>
        <% if total_dur > 0 %>
          <div class="flex h-3 rounded-full overflow-hidden bg-gray-100 gap-0.5">
            <% playlist_ads.each do |pa| %>
              <% seg_tone = %w[#2f6bff #0fb5a6 #7c5cff #e8990f #1f9d57 #e5484d][pa.ad_id % 6] %>
              <div style="width: <%= (pa.duration.to_f / total_dur * 100).round(1) %>%; background: <%= seg_tone %>;"
                   class="rounded-sm opacity-80 hover:opacity-100 transition-opacity"></div>
            <% end %>
          </div>
        <% else %>
          <div class="h-3 rounded-full bg-gray-100"></div>
        <% end %>
      </div>

      <%# Sequence list %>
      <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5">
        <div class="flex items-center justify-between p-4 border-b border-gray-200">
          <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Sequence</h3>
          <%= link_to new_playlist_playlist_ad_path(@playlist), class: "rounded-md bg-indigo-600 px-2.5 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 inline-flex items-center gap-1.5", data: { turbo_frame: "modal" } do %>
            <svg viewBox="0 0 20 20" fill="currentColor" class="size-4"><path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z"/></svg>
            Add content
          <% end %>
        </div>

        <% if playlist_ads.any? %>
          <div class="divide-y divide-gray-100">
            <% playlist_ads.each_with_index do |pa, i| %>
              <% tone = %w[#2f6bff #0fb5a6 #7c5cff #e8990f #1f9d57 #e5484d][pa.ad_id % 6] %>
              <div class="flex items-center gap-3 px-4 py-3 hover:bg-gray-50 transition-colors">
                <%# Grip handle %>
                <span class="text-gray-300 text-sm cursor-grab shrink-0" title="Drag to reorder">⋮⋮</span>
                <%# Position %>
                <span class="text-xs font-mono text-gray-400 w-5 text-right shrink-0"><%= i + 1 %></span>
                <%# Thumbnail %>
                <div class="w-14 h-9 rounded flex-none relative overflow-hidden" style="background: linear-gradient(135deg, #14171f, <%= tone %>);">
                  <div class="absolute inset-0 flex items-end p-1">
                    <span class="text-white text-[6px] font-bold leading-none truncate"><%= pa.ad.headline %></span>
                  </div>
                </div>
                <%# Name + type %>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium truncate"><%= pa.ad.headline %></p>
                  <p class="text-xs text-gray-400">Ad</p>
                </div>
                <%# Duration %>
                <div class="flex items-center gap-1 shrink-0 rounded-md ring-1 ring-gray-200 bg-gray-50">
                  <span class="text-xs font-mono text-gray-600 px-2.5 py-1"><%= pa.duration %>s</span>
                </div>
                <%# Actions %>
                <div class="flex items-center gap-0.5 shrink-0">
                  <%= link_to edit_playlist_playlist_ad_path(@playlist, pa), class: "text-gray-400 hover:text-gray-600 p-1", data: { turbo_frame: "modal" }, title: "Edit slide" do %>
                    <svg viewBox="0 0 20 20" fill="currentColor" class="size-4"><path d="m5.433 13.917 1.262-3.155A4 4 0 0 1 7.58 9.42l6.92-6.918a2.121 2.121 0 0 1 3 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 0 1-.65-.65Z"/><path d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0 0 10 3H4.75A2.75 2.75 0 0 0 2 5.75v9.5A2.75 2.75 0 0 0 4.75 18h9.5A2.75 2.75 0 0 0 17 15.25V10a.75.75 0 0 0-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5Z"/></svg>
                  <% end %>
                  <%= button_to playlist_playlist_ad_path(@playlist, pa), method: :delete, class: "text-gray-400 hover:text-red-500 p-1", title: "Remove", data: { turbo_confirm: "Remove this slide?" } do %>
                    <svg viewBox="0 0 20 20" fill="currentColor" class="size-4"><path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"/></svg>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="p-8 text-center">
            <div class="w-10 h-10 rounded-lg grid place-items-center mx-auto mb-2" style="background: rgba(47,107,255,.1);">
              <svg viewBox="0 0 24 24" fill="none" stroke="#2f6bff" stroke-width="1.5" class="size-5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 010 3.75H5.625a1.875 1.875 0 010-3.75z"/></svg>
            </div>
            <p class="text-sm font-medium text-gray-700">No content yet</p>
            <p class="text-xs text-gray-400 mt-1">Add ads to build your signage loop.</p>
          </div>
        <% end %>
      </div>
    </div>

    <%# Right — details + preview %>
    <div class="flex flex-col gap-5">
      <%# Playlist details %>
      <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
        <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-4">Playlist details</h3>

        <div class="mb-4">
          <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.text_field :name, required: true, autofocus: true, placeholder: "e.g. Bushwick · Featured",
              class: "block w-full rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" %>
        </div>

        <div>
          <%= form.label :status, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.select :status, [["Draft", "draft"], ["Published", "published"], ["Archived", "archived"]],
              {}, class: "block w-full rounded-md bg-white py-2 pl-3 pr-8 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" %>
        </div>
      </div>

      <%# Preview panel %>
      <div class="rounded-lg overflow-hidden shadow-sm ring-1 ring-gray-900/5">
        <div class="px-5 py-3 bg-white border-b border-gray-100">
          <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Preview</span>
        </div>
        <div class="bg-gray-100 p-4 flex items-center justify-center">
          <% if playlist_ads.any? %>
            <% first_pa = playlist_ads.first %>
            <% preview_tone = %w[#2f6bff #0fb5a6 #7c5cff #e8990f #1f9d57 #e5484d][first_pa.ad_id % 6] %>
            <div class="w-full aspect-video rounded-lg overflow-hidden relative flex flex-col justify-end p-4"
                 style="background: linear-gradient(135deg, #0b0d12, <%= preview_tone %>);">
              <div class="text-white">
                <div class="text-[9px] font-bold tracking-wider" style="color: <%= preview_tone %>cc;">FOR SALE</div>
                <div class="text-xl font-extrabold tracking-tight leading-tight"><%= first_pa.ad.headline %></div>
                <% if first_pa.ad.body.present? %>
                  <div class="text-xs opacity-70 mt-1"><%= first_pa.ad.body.truncate(60) %></div>
                <% end %>
              </div>
              <div class="absolute right-4 bottom-4 w-8 h-8 bg-white rounded"></div>
            </div>
          <% else %>
            <div class="w-full aspect-video rounded-lg overflow-hidden relative flex flex-col items-center justify-center"
                 style="background: linear-gradient(135deg, #0b0d12, #1c2230);">
              <p class="text-white/40 text-xs">No slides to preview</p>
            </div>
          <% end %>
        </div>
        <% if playlist_ads.any? %>
          <div class="px-5 py-3 bg-white border-t border-gray-100 flex items-center justify-between">
            <span class="text-xs text-gray-400">Slide 1 of <%= playlist_ads.size %></span>
            <span class="text-xs font-mono text-gray-400"><%= mmss.call(total_dur) %> loop</span>
          </div>
        <% end %>
      </div>

      <%# Assigned screens %>
      <% assigned = @playlist.screen_playlists.includes(screen: :site).where(active: true) %>
      <% if assigned.any? %>
        <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
          <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">Assigned to <%= assigned.size %> screen<%= assigned.size == 1 ? "" : "s" %></h3>
          <div class="flex flex-col gap-2">
            <% assigned.each do |sp| %>
              <div class="flex items-center gap-2.5">
                <div class="w-8 h-5 rounded bg-gray-900 flex-none flex items-center justify-center">
                  <span class="text-white/20 text-[5px]">▶</span>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-xs font-medium truncate"><%= sp.screen.name %></p>
                  <p class="text-[11px] text-gray-400"><%= sp.screen.site.name %></p>
                </div>
                <span class="inline-flex items-center gap-1 rounded-full bg-green-50 px-1.5 py-0.5 text-[10px] font-medium text-green-700 ring-1 ring-green-600/20 ring-inset">
                  <span class="size-1 rounded-full bg-green-500"></span>
                  Live
                </span>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# Info note %>
      <div class="flex gap-3 p-3 rounded-lg bg-indigo-50">
        <div class="w-7 h-7 bg-white rounded-md shrink-0 grid place-items-center">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-3.5 text-indigo-600"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <p class="text-xs text-indigo-800 leading-relaxed">Changes save to a <strong>draft</strong> — publish to push live to all assigned screens.</p>
      </div>

      <%# Actions %>
      <div class="flex items-center justify-between pt-2">
        <%= link_to "Cancel", playlist_path(@playlist), class: "text-sm font-semibold text-gray-600 hover:text-gray-900" %>
        <%= form.submit "Save changes", class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500" %>
      </div>
    </div>
  </div>
<% end %>
