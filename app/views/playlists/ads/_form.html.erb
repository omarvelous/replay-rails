<%= form_with model: playlist_ad, url: url, class: "contents" do |form| %>
  <% if playlist_ad.errors.any? %>
    <div id="error_explanation" class="alert alert-error my-4">
      <div>
        <ul class="list-disc list-inside text-sm">
          <% playlist_ad.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <fieldset class="fieldset my-5">
    <%= form.label :ad_id, "Ad", class: "fieldset-label" %>
    <%= form.select :ad_id,
        Current.user.account.ads.order(:headline).map { |a| [a.headline, a.id] },
        { include_blank: "Select an ad" },
        required: true, class: "select select-bordered w-full" %>
  </fieldset>

  <div class="flex gap-4">
    <fieldset class="fieldset my-5 flex-1">
      <%= form.label :position, class: "fieldset-label" %>
      <%= form.number_field :position, min: 1, required: true,
          class: "input input-bordered w-full" %>
    </fieldset>

    <fieldset class="fieldset my-5 flex-1">
      <%= form.label :duration, "Duration (seconds)", class: "fieldset-label" %>
      <%= form.number_field :duration, min: 1, required: true,
          class: "input input-bordered w-full" %>
    </fieldset>
  </div>

  <div class="flex items-center gap-4">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", playlist_path(playlist_ad.playlist), class: "link link-hover text-sm" %>
  </div>
<% end %>
