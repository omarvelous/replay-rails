<tr id="<%= dom_id(pa) %>">
  <td class="px-3 py-4"><%= pa.position %></td>
  <td class="px-3 py-4"><%= link_to pa.ad.headline, ad_path(pa.ad), class: "font-semibold text-indigo-600 hover:text-indigo-500", data: { turbo_frame: "_top" } %></td>
  <td class="px-3 py-4"><%= pa.duration %>s</td>
  <td class="px-3 py-4 text-right">
    <%= link_to "Edit", edit_playlist_playlist_ad_path(pa.playlist, pa), class: "text-sm text-gray-600 hover:text-gray-900 mr-2", data: { turbo_frame: "modal" } %>
    <%= button_to "Remove", playlist_playlist_ad_path(pa.playlist, pa), method: :delete,
        class: "rounded-md bg-white px-2 py-1 text-xs font-semibold text-red-600 shadow-xs ring-1 ring-red-300 ring-inset hover:bg-red-50",
        data: { turbo_confirm: "Remove this ad?" } %>
  </td>
</tr>
