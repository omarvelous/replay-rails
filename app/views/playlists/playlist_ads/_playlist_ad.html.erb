<tr id="<%= dom_id(pa) %>">
  <td><%= pa.position %></td>
  <td><%= link_to pa.ad.headline, ad_path(pa.ad), class: "link", data: { turbo_frame: "_top" } %></td>
  <td><%= pa.duration %>s</td>
  <td class="text-right">
    <%= link_to "Edit", edit_playlist_playlist_ad_path(pa.playlist, pa), class: "link link-hover text-sm mr-2", data: { turbo_frame: "modal" } %>
    <%= button_to "Remove", playlist_playlist_ad_path(pa.playlist, pa), method: :delete,
        class: "btn btn-error btn-xs",
        data: { turbo_confirm: "Remove this ad?" } %>
  </td>
</tr>
