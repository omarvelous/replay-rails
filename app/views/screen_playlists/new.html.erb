<%= turbo_frame_tag "modal" do %>
  <div class="flex items-center justify-between mb-1">
    <h3 class="font-semibold text-lg">Assign playlist to <%= @screen.name %></h3>
    <button type="button" class="text-gray-400 hover:text-gray-600 p-1" data-action="click->modal#close">
      <svg viewBox="0 0 20 20" fill="currentColor" class="size-5"><path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"/></svg>
    </button>
  </div>

  <%= form_with url: screen_screen_playlist_path(@screen), method: :post do |form| %>
    <div class="my-4">
      <%= form.label :playlist_id, "Playlist", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.select :playlist_id,
          @playlists.map { |p| ["#{p.name} (#{p.playlist_ads.size} ads)", p.id] },
          { include_blank: "Select a playlist" },
          required: true, name: "screen_playlist[playlist_id]",
          class: "block w-full rounded-md bg-white py-2 pl-3 pr-8 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" %>
    </div>

    <div class="flex items-center justify-between">
      <button type="button" class="text-sm font-semibold text-gray-600 hover:text-gray-900" data-action="click->modal#close">Cancel</button>
      <%= form.submit "Assign playlist", class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500" %>
    </div>
  <% end %>
<% end %>
