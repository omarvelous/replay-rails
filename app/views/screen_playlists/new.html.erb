<%= render "shared/page_header", title: "Assign Playlist", subtitle: "Choose a playlist for #{@screen.name}", back_link: { label: "← Screen", path: screen_path(@screen) } %>

<div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
  <%= form_with url: screen_screen_playlist_path(@screen), method: :post do |form| %>
    <div class="mb-4">
      <%= form.label :playlist_id, "Playlist", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.select :playlist_id,
          @playlists.map { |p| ["#{p.name} (#{p.playlist_ads.size} ads)", p.id] },
          { include_blank: "Select a playlist" },
          required: true, name: "screen_playlist[playlist_id]",
          class: "block w-full rounded-md bg-white py-2 pl-3 pr-8 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" %>
    </div>

    <div class="flex items-center justify-between pt-4 border-t border-gray-200">
      <%= link_to "Cancel", screen_path(@screen), class: "text-sm font-semibold text-gray-600 hover:text-gray-900" %>
      <%= form.submit "Assign playlist", class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500" %>
    </div>
  <% end %>
</div>
