<nav class="space-y-6">
  <% Docs::Manifest.categories.each do |category| %>
    <div>
      <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2"><%= category["name"] %></h3>
      <ul class="space-y-1">
        <% category["pages"].each do |page| %>
          <li>
            <%= link_to page["title"], doc_path(page["slug"]),
                class: "block text-sm py-1 #{ request.path == "/docs/#{page['slug']}" ? 'text-indigo-600 font-semibold' : 'text-gray-600 hover:text-gray-900' }" %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</nav>
