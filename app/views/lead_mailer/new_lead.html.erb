<h1>New Lead Inquiry</h1>

<table class="info-table">
  <tr>
    <td class="label">Name</td>
    <td class="value"><%= @lead.name %></td>
  </tr>
  <% if @lead.email.present? %>
    <tr>
      <td class="label">Email</td>
      <td><a href="mailto:<%= @lead.email %>"><%= @lead.email %></a></td>
    </tr>
  <% end %>
  <% if @lead.phone.present? %>
    <tr>
      <td class="label">Phone</td>
      <td><a href="tel:<%= @lead.phone %>"><%= @lead.phone %></a></td>
    </tr>
  <% end %>
  <tr>
    <td class="label">Type</td>
    <td><%= @lead.lead_type.humanize %></td>
  </tr>
  <% if @lead.listing %>
    <tr>
      <td class="label">Listing</td>
      <td><%= @lead.listing.address %></td>
    </tr>
  <% end %>
</table>

<% if @lead.message.present? %>
  <div class="callout">
    <p class="callout-label">Message</p>
    <p style="margin: 0; white-space: pre-wrap;"><%= @lead.message %></p>
  </div>
<% end %>

<% if @lead.email.present? %>
  <p>
    <a href="mailto:<%= @lead.email %>?subject=Re: Your inquiry" class="btn">Reply to <%= @lead.name %></a>
  </p>
<% end %>

<p class="text-faint">
  This lead was submitted via RePlay on <%= @lead.created_at.strftime("%b %-d, %Y at %-I:%M %p") %>.
</p>
