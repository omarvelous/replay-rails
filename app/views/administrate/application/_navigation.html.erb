<nav class="navigation">
  <%= link_to "Dashboard", admin_root_path, class: "navigation__link navigation__link--#{controller_name == 'dashboard' ? 'active' : 'inactive'}" %>

  <% Administrate::Namespace.new(namespace).resources_with_index_route.each do |resource| %>
    <%= link_to(
      display_resource_name(resource),
      resource_index_route(resource),
      class: "navigation__link navigation__link--#{nav_link_state(resource)}"
    ) if accessible_action?(model_from_resource(resource), :index) %>
  <% end %>

  <hr class="navigation__divider" style="border: none; border-top: 1px solid rgba(0,0,0,0.1); margin: 1rem 0;">

  <%= link_to "← Back to App", app_root_url(subdomain: "app"), class: "navigation__link navigation__link--inactive" %>
  <small class="navigation__link" style="color: #999; font-size: 11px;"><%= Current.user&.email_address %></small>
</nav>
