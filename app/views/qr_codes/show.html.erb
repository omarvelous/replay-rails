<%= render "shared/page_header", title: @qr_code.label || "QR Code", subtitle: "#{@scan_count} scans", back_link: { label: "← QR Codes", path: qr_codes_path } %>

<div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-5 items-start">
  <%# Main column %>
  <div class="flex flex-col gap-5">
    <%# Scan history %>
    <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5">
      <div class="p-4 border-b border-gray-200">
        <h3 class="text-sm font-semibold">Recent scans</h3>
      </div>
      <% if @scans.any? %>
        <div class="divide-y divide-gray-100">
          <% @scans.each do |scan| %>
            <div class="px-4 py-3 flex items-center gap-4">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2">
                  <% if scan.ad && scan.screen %>
                    <span class="inline-flex items-center rounded-md bg-green-50 px-1.5 py-0.5 text-[10.5px] font-medium text-green-700 ring-1 ring-green-600/20 ring-inset">Qualified</span>
                    <span class="text-xs text-gray-400">Ad #<%= scan.ad_id %> &middot; Screen #<%= scan.screen_id %></span>
                  <% else %>
                    <span class="inline-flex items-center rounded-md bg-gray-50 px-1.5 py-0.5 text-[10.5px] font-medium text-gray-500 ring-1 ring-gray-500/10 ring-inset">Unqualified</span>
                  <% end %>
                  <span class="text-xs text-gray-400"><%= scan.ip_address %></span>
                </div>
              </div>
              <span class="text-xs text-gray-400 shrink-0"><%= time_ago_in_words(scan.created_at) %> ago</span>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="p-6 text-center">
          <p class="text-sm text-gray-500">No scans yet.</p>
        </div>
      <% end %>
    </div>
  </div>

  <%# Sidebar %>
  <div class="flex flex-col gap-5">
    <%# QR preview %>
    <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
      <h3 class="text-sm font-semibold mb-3">QR Code</h3>
      <div class="w-full aspect-square bg-white rounded-lg p-4">
        <%= qr_svg(@qr_code) %>
      </div>
      <p class="text-xs font-mono text-gray-400 text-center mt-2"><%= @qr_code.token %></p>
    </div>

    <%# Details %>
    <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
      <h3 class="text-sm font-semibold mb-3">Details</h3>
      <div class="divide-y divide-gray-100">
        <div class="flex justify-between py-2 text-sm">
          <span class="text-gray-500">Status</span>
          <% if @qr_code.active? %>
            <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-0.5 text-xs font-medium text-green-700 ring-1 ring-green-600/20 ring-inset">Active</span>
          <% else %>
            <span class="inline-flex items-center rounded-full bg-gray-50 px-2 py-0.5 text-xs font-medium text-gray-600 ring-1 ring-gray-500/10 ring-inset">Inactive</span>
          <% end %>
        </div>
        <div class="flex justify-between py-2 text-sm">
          <span class="text-gray-500">Destination</span>
          <% if @qr_code.destination_record %>
            <span class="font-medium"><%= @qr_code.destination_record_type %></span>
          <% elsif @qr_code.destination_url.present? %>
            <span class="font-mono text-xs"><%= @qr_code.destination_url.truncate(25) %></span>
          <% else %>
            <span class="text-gray-400">None</span>
          <% end %>
        </div>
        <div class="flex justify-between py-2 text-sm">
          <span class="text-gray-500">Total scans</span>
          <span class="font-semibold tabular-nums"><%= @scan_count %></span>
        </div>
        <div class="flex justify-between py-2 text-sm">
          <span class="text-gray-500">Created</span>
          <span><%= @qr_code.created_at.strftime("%b %-d, %Y") %></span>
        </div>
      </div>
    </div>

    <%# Destination link %>
    <% if @qr_code.destination_record %>
      <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
        <h3 class="text-sm font-semibold mb-3">Linked to</h3>
        <% record = @qr_code.destination_record %>
        <%= link_to polymorphic_path(record), class: "flex items-center gap-3 p-3 -mx-1 rounded-lg border border-gray-200 hover:bg-gray-50 transition-colors" do %>
          <div class="w-10 h-10 rounded-lg bg-indigo-50 grid place-items-center shrink-0">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-5 h-5 text-indigo-600"><path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244"/></svg>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium truncate"><%= record.try(:address) || record.try(:name) || record.class.name %></p>
            <p class="text-xs text-gray-400"><%= record.class.name %> #<%= record.id %></p>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
