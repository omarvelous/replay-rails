<div class="hero min-h-[60vh]">
  <div class="hero-content text-center">
    <div class="max-w-md">
      <h1 class="text-5xl font-bold">Welcome</h1>
      <p class="py-6 text-base-content/70">Your application is ready.</p>
      <% if authenticated? %>
        <p class="text-sm text-base-content/50">You are signed in.</p>
      <% else %>
        <%= link_to "Sign In", new_session_path, class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>
</div>
