<div class="flex justify-between items-center mb-3 mt-8">
  <h2 class="font-bold text-2xl">Agents</h2>
  <%= link_to "Add Agent", new_listing_agent_path(listing), class: "btn btn-primary btn-sm", data: { turbo_frame: "modal" } %>
</div>

<% listing_agents = listing.listing_agents.includes(:agent) %>
<% if listing_agents.any? %>
  <div class="overflow-x-auto">
    <table class="table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Role</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% listing_agents.each do |la| %>
          <tr>
            <td><%= link_to la.agent.name, agent_path(la.agent), class: "link", data: { turbo_frame: "_top" } %></td>
            <td><%= la.role.titleize %></td>
            <td class="text-right">
              <%= link_to "Edit", edit_listing_agent_path(listing, la), class: "link link-hover text-sm mr-2", data: { turbo_frame: "modal" } %>
              <%= button_to "Remove", listing_agent_path(listing, la), method: :delete,
                  class: "btn btn-error btn-xs",
                  data: { turbo_confirm: "Remove this agent?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-base-content/60">No agents assigned to this listing yet.</p>
<% end %>
