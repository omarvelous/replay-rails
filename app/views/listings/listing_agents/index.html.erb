<%= turbo_frame_tag "listing_agents" do %>
  <div class="flex justify-between items-center mb-3 mt-8">
    <h2 class="font-bold text-2xl">Agents</h2>
    <%= link_to "Add Agent", new_listing_listing_agent_path(parent), class: "btn btn-primary btn-sm", data: { turbo_frame: "modal" } %>
  </div>

  <% if @listing_agents.any? %>
    <div class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th>Agent</th>
            <th>Role</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="listing_agents_rows">
          <% @listing_agents.each do |la| %>
            <%= render "listings/listing_agents/listing_agent", la: la %>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-base-content/60">No agents assigned to this listing yet.</p>
  <% end %>
<% end %>
