<% content_for(:page_title) { "Listings" } %>
<% content_for(:page_subtitle) { "#{@listings.size} properties" } %>
<% content_for(:page_actions) do %>
  <%= link_to new_listing_path, class: "rounded-md bg-indigo-600 px-2.5 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500", data: { turbo_frame: "modal" } do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
    New listing
  <% end %>
<% end %>

<div data-controller="view-toggle">
  <%# Filter bar %>
  <div class="flex flex-wrap items-center gap-3 mb-5">
    <div class="flex-1 min-w-50 max-w-xs">
      <input type="text" placeholder="Search by address…" class="block w-full rounded-md bg-white px-3 py-1.5 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" />
    </div>

    <div class="flex gap-1">
      <button class="rounded-md bg-gray-100 px-2 py-1 text-xs font-semibold text-gray-900 shadow-xs ring-1 ring-gray-300 ring-inset hover:bg-gray-50">All</button>
      <button class="rounded-md bg-white px-2 py-1 text-xs font-semibold text-gray-900 shadow-xs ring-1 ring-gray-300 ring-inset hover:bg-gray-50">Active</button>
      <button class="rounded-md bg-white px-2 py-1 text-xs font-semibold text-gray-900 shadow-xs ring-1 ring-gray-300 ring-inset hover:bg-gray-50">Pending</button>
      <button class="rounded-md bg-white px-2 py-1 text-xs font-semibold text-gray-900 shadow-xs ring-1 ring-gray-300 ring-inset hover:bg-gray-50">Sold</button>
    </div>

    <span class="ml-auto isolate inline-flex rounded-md shadow-xs">
      <button class="relative inline-flex items-center rounded-l-md bg-white px-2 py-1.5 text-gray-400 ring-1 ring-gray-300 ring-inset hover:bg-gray-50" data-view-btn data-view="grid" data-action="click->view-toggle#switch">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"/></svg>
      </button>
      <button class="relative -ml-px inline-flex items-center rounded-r-md bg-white px-2 py-1.5 text-gray-400 ring-1 ring-gray-300 ring-inset hover:bg-gray-50" data-view-btn data-view="table" data-action="click->view-toggle#switch">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 5.25h16.5m-16.5 4.5h16.5m-16.5 4.5h16.5m-16.5 4.5h16.5"/></svg>
      </button>
    </span>
  </div>

  <%# Gallery view %>
  <div data-view-toggle-target="view" data-view="grid">
    <% if @listings.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        <% @listings.each do |listing| %>
          <%= render "listings/listing_card", listing: listing %>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 border-2 border-dashed border-gray-200 p-10 text-center">
        <div class="flex flex-col items-center gap-3">
          <div class="w-12 h-12 rounded-xl bg-indigo-50 grid place-items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
          </div>
          <p class="font-semibold">No listings yet</p>
          <p class="text-sm text-gray-500">Add your first property to get started.</p>
          <%= link_to "New listing", new_listing_path, class: "rounded-md bg-indigo-600 px-2.5 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500", data: { turbo_frame: "modal" } %>
        </div>
      </div>
    <% end %>
  </div>

  <%# Table view %>
  <div data-view-toggle-target="view" data-view="table" class="hidden">
    <% if @listings.any? %>
      <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-300">
            <thead>
              <tr>
                <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Property</th>
                <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Price</th>
                <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Beds</th>
                <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Baths</th>
                <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Sq ft</th>
                <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Status</th>
                <th class="px-3 py-3.5 text-right text-sm font-semibold text-gray-900"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <% @listings.each do |listing| %>
                <% tone = %w[#2f6bff #0fb5a6 #7c5cff #e8990f #1f9d57 #e5484d][listing.id % 6] %>
                <tr class="hover:bg-gray-50 cursor-pointer" onclick="Turbo.visit('<%= listing_path(listing) %>')">
                  <td class="px-3 py-4">
                    <div class="flex items-center gap-3">
                      <div class="w-12 h-9 rounded flex-none" style="background: <%= tone %>22;"></div>
                      <span class="font-medium text-sm"><%= listing.address %></span>
                    </div>
                  </td>
                  <td class="px-3 py-4 font-mono text-sm"><%= number_to_currency(listing.price, precision: 0) %></td>
                  <td class="px-3 py-4 font-mono text-sm"><%= listing.beds %></td>
                  <td class="px-3 py-4 font-mono text-sm"><%= listing.baths %></td>
                  <td class="px-3 py-4 font-mono text-sm"><%= number_with_delimiter(listing.sqft) %></td>
                  <td class="px-3 py-4">
                    <% if listing.status == 'active' %>
                      <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-green-600/20 ring-inset"><%= listing.status.capitalize %></span>
                    <% elsif listing.status == 'pending' %>
                      <span class="inline-flex items-center rounded-full bg-yellow-50 px-2 py-1 text-xs font-medium text-yellow-800 ring-1 ring-yellow-600/20 ring-inset"><%= listing.status.capitalize %></span>
                    <% else %>
                      <span class="inline-flex items-center rounded-full bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-gray-500/10 ring-inset"><%= listing.status.capitalize %></span>
                    <% end %>
                  </td>
                  <td class="px-3 py-4 text-right">
                    <%= link_to "Edit", edit_listing_path(listing), class: "text-sm font-semibold text-gray-600 hover:text-gray-900", onclick: "event.stopPropagation()" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  </div>
</div>
