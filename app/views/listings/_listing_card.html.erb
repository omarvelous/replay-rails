<%= link_to listing_path(listing), class: "card bg-base-100 shadow-sm hover:shadow-md transition-shadow cursor-pointer group", data: { turbo_frame: "_top" } do %>
  <%# Photo placeholder with tone tint %>
  <% tone = %w[#2f6bff #0fb5a6 #7c5cff #e8990f #1f9d57 #e5484d][listing.id % 6] %>
  <div class="h-36 rounded-t-[inherit] relative overflow-hidden" style="background: <%= tone %>22;">
    <div class="absolute inset-0" style="background: linear-gradient(150deg, <%= tone %>40, transparent 65%);"></div>
    <div class="absolute top-3 right-3">
      <span class="badge badge-sm <%= listing.status == 'active' ? 'badge-success' : listing.status == 'pending' ? 'badge-warning' : 'badge-neutral' %>">
        <%= listing.status.capitalize %>
      </span>
    </div>
  </div>

  <div class="card-body p-4 gap-1">
    <%# Price %>
    <p class="text-lg font-bold tabular-nums"><%= number_to_currency(listing.price, precision: 0) %></p>

    <%# Address %>
    <p class="text-sm text-base-content/70 truncate"><%= listing.address %></p>

    <%# Specs row %>
    <div class="flex items-center gap-3 mt-1 text-sm text-base-content/50">
      <% if listing.beds %>
        <span class="flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/></svg>
          <%= listing.beds %> bd
        </span>
      <% end %>
      <% if listing.baths %>
        <span class="flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <%= listing.baths %> ba
        </span>
      <% end %>
      <% if listing.sqft %>
        <span class="flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15"/></svg>
          <%= number_with_delimiter(listing.sqft) %>
        </span>
      <% end %>
    </div>
  </div>
<% end %>
