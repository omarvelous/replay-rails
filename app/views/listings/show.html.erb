<div class="mx-auto md:w-2/3 w-full">
  <div class="flex justify-between items-center mb-5">
    <h1 class="font-bold text-4xl"><%= @listing.address %></h1>
    <div class="flex gap-2">
      <%= link_to "Edit", edit_listing_path(@listing), class: "btn btn-ghost btn-sm" %>
      <%= button_to "Delete", @listing, method: :delete, class: "btn btn-error btn-sm",
          data: { turbo_confirm: "Are you sure?" } %>
    </div>
  </div>

  <div class="flex gap-6 text-base-content/60">
    <p><strong><%= number_to_currency(@listing.price, precision: 0) %></strong></p>
    <% if @listing.beds %><p><%= @listing.beds %> beds</p><% end %>
    <% if @listing.baths %><p><%= @listing.baths %> baths</p><% end %>
    <% if @listing.sqft %><p><%= number_with_delimiter(@listing.sqft) %> sq ft</p><% end %>
    <p>Status: <%= @listing.status.capitalize %></p>
  </div>

  <div class="flex justify-between items-center mb-3 mt-8">
    <h2 class="font-bold text-2xl">Agents</h2>
    <%= link_to "Add Agent", new_listing_agent_path(@listing), class: "btn btn-primary btn-sm" %>
  </div>

  <% if @listing.listing_agents.any? %>
    <div class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Role</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @listing.listing_agents.includes(:agent).each do |la| %>
            <tr>
              <td><%= link_to la.agent.name, agent_path(la.agent), class: "link" %></td>
              <td><%= la.role.titleize %></td>
              <td class="text-right">
                <%= link_to "Edit", edit_listing_agent_path(@listing, la), class: "link link-hover text-sm mr-2" %>
                <%= button_to "Remove", listing_agent_path(@listing, la), method: :delete,
                    class: "btn btn-error btn-xs",
                    data: { turbo_confirm: "Remove this agent?" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-base-content/60">No agents assigned to this listing yet.</p>
  <% end %>
</div>
