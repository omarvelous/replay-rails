<%= render "shared/page_header", title: "Add content", subtitle: @playlist.name, back_link: { label: "← Playlist", path: playlist_path(@playlist) } %>

<div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5" data-controller="content-picker">
  <p class="text-sm text-gray-500 mb-4">Pick an ad and set its duration, then add it to your loop.</p>

  <% ads = Current.account.ads.order(:headline) %>
  <% existing_ad_ids = @playlist.playlist_ads.pluck(:ad_id) %>

  <% if ads.any? %>
    <%# Card grid %>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-5">
      <% ads.each do |ad| %>
        <% tone = %w[#2f6bff #0fb5a6 #7c5cff #e8990f #1f9d57 #e5484d][ad.id % 6] %>
        <% in_playlist = existing_ad_ids.include?(ad.id) %>
        <button type="button"
                class="rounded-lg ring-1 ring-gray-200 hover:ring-indigo-300 transition-all text-left overflow-hidden cursor-pointer<%= in_playlist ? ' opacity-50' : '' %>"
                data-content-picker-target="card"
                data-ad-id="<%= ad.id %>"
                data-action="click->content-picker#select">
          <%# Gradient thumbnail %>
          <div class="aspect-video relative overflow-hidden"
               style="background: linear-gradient(135deg, #14171f, <%= tone %>);">
            <div class="absolute inset-0 flex flex-col justify-end p-2.5">
              <div class="text-white">
                <div class="text-[7px] font-bold tracking-wider" style="color: <%= tone %>cc;">FOR SALE</div>
                <div class="text-xs font-extrabold tracking-tight leading-tight truncate"><%= ad.headline %></div>
              </div>
              <div class="absolute right-2.5 bottom-2.5 w-4 h-4 bg-white rounded-sm"></div>
            </div>
            <% if in_playlist %>
              <div class="absolute top-1.5 right-1.5">
                <span class="inline-flex items-center rounded-full bg-white/90 px-1.5 py-0.5 text-[9px] font-semibold text-gray-500 shadow-sm">In playlist</span>
              </div>
            <% end %>
          </div>
          <%# Card body %>
          <div class="px-2.5 py-2">
            <p class="text-xs font-medium truncate"><%= ad.headline %></p>
            <span class="inline-flex items-center rounded-md bg-gray-50 px-1 py-0.5 text-[9px] font-medium text-gray-500 ring-1 ring-gray-500/10 ring-inset mt-1">Ad</span>
          </div>
        </button>
      <% end %>
    </div>

    <%# Duration slider + submit %>
    <%= form_with model: PlaylistAd.new, url: polymorphic_path([@playlist, PlaylistAd]) do |form| %>
      <%= form.hidden_field :ad_id, value: "", data: { content_picker_target: "adIdField" } %>
      <%= form.hidden_field :duration, value: 10, data: { content_picker_target: "durationField" } %>

      <div class="rounded-lg bg-gray-50 ring-1 ring-gray-200 p-4 mb-5">
        <div class="flex items-center justify-between mb-2">
          <label class="text-sm font-medium text-gray-700">Slide duration</label>
          <span class="text-sm font-mono font-semibold text-gray-900" data-content-picker-target="durationDisplay">10s</span>
        </div>
        <input type="range" min="3" max="60" value="10" step="1"
               class="w-full h-2 bg-gray-200 rounded-full appearance-none cursor-pointer accent-indigo-600"
               data-action="input->content-picker#updateDuration">
        <div class="flex justify-between mt-1">
          <span class="text-[10px] text-gray-400">3s</span>
          <span class="text-[10px] text-gray-400">60s</span>
        </div>
      </div>

      <div class="flex items-center justify-between">
        <%= link_to "Cancel", playlist_path(@playlist), class: "text-sm font-semibold text-gray-600 hover:text-gray-900" %>
        <%= form.submit "Add to playlist",
            disabled: true,
            data: { content_picker_target: "submitBtn" },
            class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 opacity-50 cursor-not-allowed disabled:opacity-50 disabled:cursor-not-allowed" %>
      </div>
    <% end %>
  <% else %>
    <div class="border-2 border-dashed border-gray-200 rounded-lg p-8 text-center">
      <div class="w-10 h-10 rounded-lg bg-indigo-50 grid place-items-center mx-auto mb-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
      </div>
      <p class="text-sm font-medium text-gray-700">No ads yet</p>
      <p class="text-xs text-gray-400 mt-1">Create an ad first, then add it to your playlist.</p>
      <%= link_to "Create ad", new_ad_path, class: "rounded-md bg-indigo-600 px-2.5 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 mt-3 inline-block" %>
    </div>
  <% end %>
</div>
