<%= turbo_frame_tag "modal" do %>
  <div class="flex items-center justify-between mb-1">
    <h3 class="font-semibold text-lg">Edit slide</h3>
    <button type="button" class="text-gray-400 hover:text-gray-600 p-1" data-action="click->modal#close">
      <svg viewBox="0 0 20 20" fill="currentColor" class="size-5"><path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"/></svg>
    </button>
  </div>

  <% tone = %w[#2f6bff #0fb5a6 #7c5cff #e8990f #1f9d57 #e5484d][@playlist_ad.ad_id % 6] %>

  <%# Preview of current ad %>
  <div class="rounded-lg overflow-hidden ring-1 ring-gray-200 mb-5">
    <div class="aspect-video relative overflow-hidden"
         style="background: linear-gradient(135deg, #14171f, <%= tone %>);">
      <div class="absolute inset-0 flex flex-col justify-end p-4">
        <div class="text-white">
          <div class="text-[9px] font-bold tracking-wider" style="color: <%= tone %>cc;">FOR SALE</div>
          <div class="text-lg font-extrabold tracking-tight leading-tight"><%= @playlist_ad.ad.headline %></div>
        </div>
        <div class="absolute right-4 bottom-4 w-6 h-6 bg-white rounded-sm"></div>
      </div>
    </div>
  </div>

  <%= form_with model: @playlist_ad, url: playlist_playlist_ad_path(@playlist, @playlist_ad) do |form| %>
    <% if @playlist_ad.errors.any? %>
      <div class="rounded-md bg-red-50 p-4 mb-4">
        <div class="flex">
          <div class="shrink-0">
            <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5 text-red-400"><path d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM8.28 7.22a.75.75 0 0 0-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 1 0 1.06 1.06L10 11.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L11.06 10l1.72-1.72a.75.75 0 0 0-1.06-1.06L10 8.94 8.28 7.22Z" clip-rule="evenodd" fill-rule="evenodd" /></svg>
          </div>
          <div class="ml-3">
            <ul class="list-disc list-inside text-sm text-red-700">
              <% @playlist_ad.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    <% end %>

    <div class="rounded-lg bg-gray-50 ring-1 ring-gray-200 p-4 mb-5" data-controller="content-picker">
      <div class="flex items-center justify-between mb-2">
        <label class="text-sm font-medium text-gray-700">Slide duration</label>
        <span class="text-sm font-mono font-semibold text-gray-900" data-content-picker-target="durationDisplay"><%= @playlist_ad.duration %>s</span>
      </div>
      <%= form.range_field :duration, min: 3, max: 60, step: 1,
          class: "w-full h-2 bg-gray-200 rounded-full appearance-none cursor-pointer accent-indigo-600",
          data: { action: "input->content-picker#updateDuration" } %>
      <div class="flex justify-between mt-1">
        <span class="text-[10px] text-gray-400">3s</span>
        <span class="text-[10px] text-gray-400">60s</span>
      </div>
    </div>

    <div class="flex items-center justify-between">
      <button type="button" class="text-sm font-semibold text-gray-600 hover:text-gray-900" data-action="click->modal#close">Cancel</button>
      <%= form.submit "Save changes", class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500" %>
    </div>
  <% end %>
<% end %>
