<div class="flex justify-between items-center mb-3 mt-8">
  <h2 class="font-bold text-2xl"><%= playlist ? "Ads" : "Playlists" %></h2>
  <% if playlist %>
    <%= link_to "Add Ad", new_playlist_ad_path(playlist_id: playlist.id), class: "btn btn-primary btn-sm", data: { turbo_frame: "modal" } %>
  <% end %>
</div>

<% if playlist_ads.any? %>
  <div class="overflow-x-auto">
    <table class="table">
      <thead>
        <tr>
          <% if playlist %>
            <th>#</th>
            <th>Headline</th>
            <th>Duration</th>
          <% else %>
            <th>Playlist</th>
            <th>Position</th>
            <th>Duration</th>
          <% end %>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% playlist_ads.each do |pa| %>
          <tr>
            <% if playlist %>
              <td><%= pa.position %></td>
              <td><%= link_to pa.ad.headline, ad_path(pa.ad), class: "link", data: { turbo_frame: "_top" } %></td>
              <td><%= pa.duration %>s</td>
            <% else %>
              <td><%= link_to pa.playlist.name, playlist_path(pa.playlist), class: "link", data: { turbo_frame: "_top" } %></td>
              <td><%= pa.position %></td>
              <td><%= pa.duration %>s</td>
            <% end %>
            <td class="text-right">
              <% if playlist %>
                <%= link_to "Edit", edit_playlist_ad_path(pa), class: "link link-hover text-sm mr-2", data: { turbo_frame: "modal" } %>
              <% end %>
              <%= button_to "Remove", playlist_ad_path(pa), method: :delete,
                  class: "btn btn-error btn-xs",
                  data: { turbo_confirm: "Remove this association?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-base-content/60">
    <%= playlist ? "No ads in this playlist yet." : "This ad is not in any playlists yet." %>
  </p>
<% end %>
