<div class="flex justify-between items-center mb-3 mt-8">
  <h2 class="font-bold text-2xl">Playlists</h2>
</div>

<% playlist_ads = ad.playlist_ads.includes(:playlist) %>
<% if playlist_ads.any? %>
  <div class="overflow-x-auto">
    <table class="table">
      <thead>
        <tr>
          <th>Playlist</th>
          <th>Position</th>
          <th>Duration</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% playlist_ads.each do |pa| %>
          <tr>
            <td><%= link_to pa.playlist.name, playlist_path(pa.playlist), class: "link", data: { turbo_frame: "_top" } %></td>
            <td><%= pa.position %></td>
            <td><%= pa.duration %>s</td>
            <td class="text-right">
              <%= button_to "Remove", ad_playlist_path(ad, pa), method: :delete,
                  class: "btn btn-error btn-xs",
                  data: { turbo_confirm: "Remove from this playlist?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-base-content/60">This ad is not in any playlists yet.</p>
<% end %>
