<%= render "ads/shared/errors", ad: @ad %>

<div class="grid grid-cols-1 lg:grid-cols-[1fr_380px] gap-6 items-start">
  <%# Left — Live preview %>
  <div>
    <%= render "ads/shared/preview_canvas", ad: @ad %>
  </div>

  <%# Right — Form fields %>
  <div class="flex flex-col gap-5">
    <%# Collection settings %>
    <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
      <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-4">Collection</h3>
      <%= fields_for :collection_ad, @collection_ad do |ca_form| %>
        <div class="mb-4">
          <%= ca_form.label :collection_title, "Title", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= ca_form.text_field :collection_title, required: true, placeholder: "e.g. Open Houses This Weekend",
              class: "block w-full rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" %>
        </div>

        <div class="mb-4">
          <%= ca_form.label :member_ad_ids, "Ads in this collection", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= ca_form.collection_check_boxes :member_ad_ids, @available_ads, :id, :headline do |b| %>
            <label class="flex items-center gap-2 py-1.5 cursor-pointer">
              <%= b.check_box class: "rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
              <span class="text-sm text-gray-700"><%= b.text %></span>
            </label>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# Content fields %>
    <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
      <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-4">Content</h3>
      <%= render "ads/shared/content_fields", form: form %>
    </div>

    <%# Image %>
    <%= render "ads/shared/image_field", form: form, ad: @ad %>

    <%# Appearance — theme only, layout is auto-set to grid %>
    <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
      <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-4">Appearance</h3>
      <%= form.hidden_field :layout, value: "grid" %>
      <%# Theme picker %>
      <div class="mb-4">
        <%= form.label :theme, class: "block text-sm font-medium text-gray-700 mb-2" %>
        <div class="flex gap-3">
          <% Ad::THEMES.each do |theme_name| %>
            <label class="cursor-pointer">
              <%= form.radio_button :theme, theme_name, class: "peer sr-only" %>
              <span class="peer-checked:ring-2 peer-checked:ring-indigo-600 flex items-center gap-2 rounded-lg px-3 py-2 ring-1 ring-gray-200 hover:bg-gray-50 transition-colors">
                <% bg = { "dark" => "#0b0d12", "light" => "#f9fafb", "brand" => "#2f6bff" }[theme_name] %>
                <span class="w-5 h-5 rounded-full border border-gray-300" style="background: <%= bg %>;"></span>
                <span class="text-sm font-medium text-gray-700"><%= theme_name.capitalize %></span>
              </span>
            </label>
          <% end %>
        </div>
      </div>
    </div>

    <%# Actions %>
    <%= render "ads/shared/form_actions", form: form, ad: @ad %>
  </div>
</div>
