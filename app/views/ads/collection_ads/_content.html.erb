<% collection_ad = ad.adable %>
<% count = collection_ad.member_ads.size %>

<div class="font-bold" style="font-size: var(--s-4xl); margin-bottom: var(--s-xs);"><%= collection_ad.collection_title %></div>
<div style="font-size: var(--s-xl); margin-bottom: var(--s-gap); color: var(--ad-text-faint);"><%= count %> properties</div>

<% cols = count <= 2 ? 2 : count <= 4 ? 2 : 3 %>
<div class="grid flex-1" style="grid-template-columns: repeat(<%= cols %>, 1fr); gap: var(--s-gap);">
  <% collection_ad.collection_ad_ads.order(:position).includes(ad: :adable).each do |item| %>
    <% member = item.ad %>
    <% listing = member.listing %>
    <div class="rounded-2xl overflow-hidden flex flex-col" style="background: var(--ad-surface);">
      <div class="flex-1 relative" style="background: color-mix(in srgb, var(--ad-accent) 15%, transparent); min-height: 45%;"></div>
      <div style="padding: var(--s-pad);">
        <% if listing %>
          <div class="font-extrabold tracking-tight" style="font-size: var(--s-3xl);"><%= number_to_currency(listing.price, precision: 0) %></div>
          <div style="font-size: var(--s-lg); margin-top: var(--s-xs); color: var(--ad-text-muted);"><%= listing.address %></div>
          <div style="font-size: var(--s-base); margin-top: var(--s-xs); color: var(--ad-text-faint);">
            <%= listing.beds %> bd &middot; <%= listing.baths %> ba
            <% if listing.sqft %> &middot; <%= number_with_delimiter(listing.sqft) %> sqft<% end %>
          </div>
        <% else %>
          <div class="font-bold" style="font-size: var(--s-2xl);"><%= member.headline %></div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
