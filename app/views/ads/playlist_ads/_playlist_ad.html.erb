<tr id="<%= dom_id(pa) %>">
  <td><%= link_to pa.playlist.name, playlist_path(pa.playlist), class: "link", data: { turbo_frame: "_top" } %></td>
  <td><%= pa.position %></td>
  <td><%= pa.duration %>s</td>
  <td class="text-right">
    <%= button_to "Remove", ad_playlist_ad_path(pa.ad, pa), method: :delete,
        class: "btn btn-error btn-xs",
        data: { turbo_confirm: "Remove from this playlist?" } %>
  </td>
</tr>
