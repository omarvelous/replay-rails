<%= turbo_frame_tag "playlist_ads" do %>
  <div class="flex justify-between items-center mb-3 mt-8">
    <h2 class="font-bold text-2xl">Playlists</h2>
    <%= link_to "Add to Playlist", new_ad_playlist_ad_path(parent), class: "btn btn-primary btn-sm", data: { turbo_frame: "modal" } %>
  </div>

  <% if @playlist_ads.any? %>
    <div class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th>Playlist</th>
            <th>Position</th>
            <th>Duration</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="playlist_ads_rows">
          <% @playlist_ads.each do |pa| %>
            <%= render "ads/playlist_ads/playlist_ad", pa: pa %>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-base-content/60">This ad is not in any playlists yet.</p>
  <% end %>
<% end %>
