<%= turbo_frame_tag "playlist_ads" do %>
  <div class="flex justify-between items-center mb-3 mt-8">
    <h2 class="font-bold text-2xl">Playlists</h2>
  </div>

  <% if @playlist_ads.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-300">
        <thead>
          <tr>
            <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Playlist</th>
            <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Position</th>
            <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Duration</th>
            <th class="px-3 py-3.5 text-right text-sm font-semibold text-gray-900"></th>
          </tr>
        </thead>
        <tbody id="playlist_ads_rows" class="divide-y divide-gray-200">
          <% @playlist_ads.each do |pa| %>
            <%= render "ads/playlist_ads/playlist_ad", pa: pa %>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-gray-500">This ad is not in any playlists yet.</p>
  <% end %>
<% end %>
