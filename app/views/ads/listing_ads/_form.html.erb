<%= render "ads/shared/errors", ad: @ad %>

<div class="grid grid-cols-1 lg:grid-cols-[1fr_380px] gap-6 items-start">
  <%# Left — Live preview %>
  <div>
    <%= render "ads/shared/preview_canvas", ad: @ad %>
  </div>

  <%# Right — Form fields %>
  <div class="flex flex-col gap-5">
    <%# Badge selector %>
    <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
      <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-4">Ad Type</h3>
      <%= fields_for :listing_ad, @listing_ad do |la_form| %>
        <div class="flex flex-wrap gap-2 mb-4">
          <% ListingAd::BADGES.each do |badge_val| %>
            <label class="cursor-pointer">
              <%= la_form.radio_button :badge, badge_val, class: "peer sr-only", data: { action: "change->badge-fields#toggle" } %>
              <span class="peer-checked:ring-2 peer-checked:ring-indigo-600 peer-checked:bg-indigo-50 peer-checked:text-indigo-700 inline-flex items-center rounded-md bg-white px-3 py-1.5 text-sm font-medium text-gray-600 ring-1 ring-gray-300 ring-inset hover:bg-gray-50 transition-colors">
                <%= ListingAd::BADGE_LABELS[badge_val] %>
              </span>
            </label>
          <% end %>
        </div>

        <%# Listing picker %>
        <div class="mb-4">
          <%= la_form.label :listing_id, "Listing", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= la_form.select :listing_id,
              Current.account.listings.order(:address).map { |l| ["#{l.address} — #{number_to_currency(l.price, precision: 0)}", l.id] },
              { include_blank: "Select a listing…" },
              class: "block w-full rounded-md bg-white py-2 pl-3 pr-8 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" %>
        </div>

        <%# Open house fields %>
        <div data-badge-fields-target="openHouse" class="<%= 'hidden' unless @listing_ad.open_house? %> space-y-3 mb-4 p-3 rounded-lg bg-amber-50 ring-1 ring-amber-200">
          <div>
            <%= la_form.label :event_date, "Event date", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= la_form.date_field :event_date, class: "block w-full rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" %>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <%= la_form.label :event_start_time, "Start time", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= la_form.time_field :event_start_time, class: "block w-full rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" %>
            </div>
            <div>
              <%= la_form.label :event_end_time, "End time", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= la_form.time_field :event_end_time, class: "block w-full rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" %>
            </div>
          </div>
        </div>

        <%# Price reduction fields %>
        <div data-badge-fields-target="priceReduction" class="<%= 'hidden' unless @listing_ad.price_reduction? %> mb-4 p-3 rounded-lg bg-orange-50 ring-1 ring-orange-200">
          <%= la_form.label :original_price, "Original price", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= la_form.number_field :original_price, class: "block w-full rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600", placeholder: "1250000" %>
        </div>

        <%# Just sold fields %>
        <div data-badge-fields-target="justSold" class="<%= 'hidden' unless @listing_ad.just_sold? %> space-y-3 mb-4 p-3 rounded-lg bg-red-50 ring-1 ring-red-200">
          <div>
            <%= la_form.label :sold_price, "Sold price", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= la_form.number_field :sold_price, class: "block w-full rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600", placeholder: "1180000" %>
          </div>
          <div>
            <%= la_form.label :sold_date, "Sold date", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= la_form.date_field :sold_date, class: "block w-full rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" %>
          </div>
        </div>
      <% end %>
    </div>

    <%# Content fields %>
    <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
      <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-4">Content</h3>
      <%= render "ads/shared/content_fields", form: form %>
    </div>

    <%# Appearance %>
    <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 p-5">
      <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-4">Appearance</h3>
      <%= render "ads/shared/appearance_fields", form: form, layouts: ListingAd::LAYOUTS %>
    </div>

    <%# Actions %>
    <%= render "ads/shared/form_actions", form: form, ad: @ad %>
  </div>
</div>
