<% content_for(:page_title) { "Ads" } %>
<% content_for(:page_subtitle) { "#{@ads.size} ads" } %>
<% content_for(:page_actions) do %>
  <%= link_to new_ad_path, class: "rounded-md bg-indigo-600 px-2.5 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
    New ad
  <% end %>
<% end %>

<div data-controller="view-toggle">
  <div class="flex flex-wrap items-center gap-3 mb-5">
    <div class="flex-1 min-w-50 max-w-xs">
      <input type="text" placeholder="Search ads…" class="block w-full rounded-md bg-white px-3 py-1.5 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" />
    </div>

    <span class="ml-auto isolate inline-flex rounded-md shadow-xs">
      <button class="relative inline-flex items-center rounded-l-md bg-white px-2 py-1.5 text-gray-400 ring-1 ring-gray-300 ring-inset hover:bg-gray-50" data-view-btn data-view="grid" data-action="click->view-toggle#switch">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"/></svg>
      </button>
      <button class="relative -ml-px inline-flex items-center rounded-r-md bg-white px-2 py-1.5 text-gray-400 ring-1 ring-gray-300 ring-inset hover:bg-gray-50" data-view-btn data-view="table" data-action="click->view-toggle#switch">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 5.25h16.5m-16.5 4.5h16.5m-16.5 4.5h16.5m-16.5 4.5h16.5"/></svg>
      </button>
    </span>
  </div>

  <%# Grid view %>
  <div data-view-toggle-target="view" data-view="grid">
    <% if @ads.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <% @ads.each do |ad| %>
          <% tone = %w[#2f6bff #0fb5a6 #7c5cff #e8990f #1f9d57 #e5484d][ad.id % 6] %>
          <%= link_to ad_path(ad), class: "rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 hover:shadow-md transition-shadow cursor-pointer", data: { turbo_frame: "_top" } do %>
            <%# Gradient thumbnail %>
            <div class="aspect-video rounded-t-lg relative overflow-hidden flex items-end p-4"
                 style="background: linear-gradient(135deg, #0b0d12, <%= tone %>cc);">
              <div class="text-white">
                <p class="text-xs font-semibold uppercase tracking-wider opacity-60">
                  <%= ad.listing ? "FOR SALE" : "AD" %>
                </p>
                <p class="text-lg font-bold leading-tight"><%= ad.headline %></p>
              </div>
            </div>
            <div class="p-4">
              <p class="font-semibold text-sm truncate"><%= ad.headline %></p>
              <p class="text-xs text-gray-400"><%= ad.listing&.address || "Standalone ad" %></p>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 border-2 border-dashed border-gray-200 p-10 text-center">
        <div class="flex flex-col items-center gap-3">
          <div class="w-12 h-12 rounded-xl bg-indigo-50 grid place-items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
          </div>
          <p class="font-semibold">No ads yet</p>
          <p class="text-sm text-gray-500">Create your first ad to get started.</p>
          <%= link_to "New ad", new_ad_path, class: "rounded-md bg-indigo-600 px-2.5 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500" %>
        </div>
      </div>
    <% end %>
  </div>

  <%# Table view %>
  <div data-view-toggle-target="view" data-view="table" class="hidden">
    <% if @ads.any? %>
      <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-300">
            <thead>
              <tr>
                <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Ad</th>
                <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Listing</th>
                <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Playlists</th>
                <th class="px-3 py-3.5 text-right text-sm font-semibold text-gray-900"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <% @ads.each do |ad| %>
                <% tone = %w[#2f6bff #0fb5a6 #7c5cff #e8990f #1f9d57 #e5484d][ad.id % 6] %>
                <tr class="hover:bg-gray-50 cursor-pointer" onclick="Turbo.visit('<%= ad_path(ad) %>')">
                  <td class="px-3 py-4">
                    <div class="flex items-center gap-3">
                      <div class="w-14 h-8 rounded flex-none flex items-end p-1"
                           style="background: linear-gradient(135deg, #0b0d12, <%= tone %>cc);">
                        <span class="text-white text-[8px] font-bold leading-none truncate"><%= ad.headline %></span>
                      </div>
                      <span class="font-medium text-sm"><%= ad.headline %></span>
                    </div>
                  </td>
                  <td class="px-3 py-4 text-sm text-gray-500"><%= ad.listing&.address || "—" %></td>
                  <td class="px-3 py-4 font-mono text-sm"><%= ad.playlist_ads.count %></td>
                  <td class="px-3 py-4 text-right">
                    <%= link_to "Edit", edit_ad_path(ad), class: "text-sm font-semibold text-gray-600 hover:text-gray-900", onclick: "event.stopPropagation()" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  </div>
</div>
