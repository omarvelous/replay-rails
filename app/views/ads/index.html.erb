<% actions = capture do %>
  <%= link_to new_ad_path, class: "rounded-md bg-indigo-600 px-2.5 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 inline-flex items-center gap-1.5" do %>
    <svg viewBox="0 0 20 20" fill="currentColor" class="size-4"><path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z"/></svg>
    New ad
  <% end %>
<% end %>
<%= render "shared/page_header", title: "Ads", subtitle: "#{@pagy.count} ads", actions: actions %>

<div data-controller="view-toggle">
  <%= form_with url: ads_path, method: :get do |f| %>
    <div class="flex flex-wrap items-center gap-3 mb-5">
      <div class="flex-1 min-w-50 max-w-xs">
        <%= f.search_field :q, value: params[:q], placeholder: "Search ads…",
            class: "block w-full rounded-md bg-white px-3 py-1.5 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600",
            oninput: "if (this.value === '') this.form.requestSubmit()" %>
      </div>

      <div class="grid grid-cols-1">
        <%= f.select :ad_type,
            [["All ads", ""], ["Listing", "ListingAd"], ["Collection", "CollectionAd"], ["Agent", "AgentAd"], ["Brand", "BrandAd"]],
            { selected: params[:ad_type].to_s },
            class: "col-start-1 row-start-1 w-full appearance-none rounded-md bg-white py-1.5 pr-8 pl-3 text-sm/6 text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-indigo-600",
            onchange: "this.form.requestSubmit()" %>
        <svg viewBox="0 0 16 16" fill="currentColor" data-slot="icon" aria-hidden="true" class="pointer-events-none col-start-1 row-start-1 mr-2 size-4 self-center justify-self-end text-gray-500">
          <path d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" fill-rule="evenodd" />
        </svg>
      </div>

      <span class="ml-auto isolate inline-flex rounded-md shadow-xs">
      <button class="relative inline-flex items-center rounded-l-md bg-white px-2 py-1.5 text-gray-400 ring-1 ring-gray-300 ring-inset hover:bg-gray-50" data-view-btn data-view="grid" data-action="click->view-toggle#switch">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"/></svg>
      </button>
      <button class="relative -ml-px inline-flex items-center rounded-r-md bg-white px-2 py-1.5 text-gray-400 ring-1 ring-gray-300 ring-inset hover:bg-gray-50" data-view-btn data-view="table" data-action="click->view-toggle#switch">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 5.25h16.5m-16.5 4.5h16.5m-16.5 4.5h16.5m-16.5 4.5h16.5"/></svg>
      </button>
      </span>
    </div>
  <% end %>

  <%# Grid view %>
  <div data-view-toggle-target="view" data-view="grid">
    <% if @ads.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <% @ads.each do |ad| %>
          <%= link_to ad_path(ad), class: "rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 hover:shadow-md transition-shadow cursor-pointer overflow-hidden" do %>
            <%# Theme-tinted card header %>
            <div class="ad-canvas aspect-video rounded-t-lg flex flex-col justify-end p-4"
                 style="background: var(--ad-bg); color: var(--ad-text); <%= ad_theme_style(ad.theme) %>">
              <div class="text-xs font-bold tracking-widest uppercase mb-1" style="color: var(--ad-accent);"><%= ad.adable_name.humanize %></div>
              <div class="text-lg font-extrabold tracking-tight leading-tight truncate"><%= ad.headline %></div>
              <% if ad.body.present? %>
                <div class="text-xs mt-1 truncate" style="color: var(--ad-text-muted);"><%= ad.body.truncate(60) %></div>
              <% end %>
            </div>
            <div class="p-4">
              <div class="flex items-center justify-between gap-2">
                <span class="font-semibold text-sm truncate"><%= ad.headline %></span>
                <span class="inline-flex items-center rounded-md bg-gray-50 px-1.5 py-0.5 text-[10.5px] font-medium text-gray-500 ring-1 ring-gray-500/10 ring-inset shrink-0"><%= ad.adable_name.humanize %></span>
              </div>
              <% if ad.listing %>
                <p class="text-xs text-gray-400 mt-1"><%= ad.listing.address %></p>
              <% end %>
              <div class="flex items-center gap-3 mt-2 text-xs text-gray-400">
                <span><%= ad.layout.humanize %></span>
                <span>&middot;</span>
                <span><%= ad.theme.capitalize %></span>
              </div>
            </div>
          <% end %>
        <% end %>

        <%# New ad dashed tile %>
        <%= link_to new_ad_path, class: "rounded-lg border-2 border-dashed border-gray-200 hover:border-gray-400 transition-colors cursor-pointer flex items-center justify-center", style: "min-height: 210px;" do %>
          <div class="flex flex-col items-center gap-2 text-gray-400">
            <div class="w-11 h-11 rounded-xl bg-white border border-gray-200 grid place-items-center text-indigo-500">
              <svg viewBox="0 0 20 20" fill="currentColor" class="size-5"><path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z"/></svg>
            </div>
            <div class="text-center">
              <p class="text-sm font-semibold text-gray-700">New ad</p>
              <p class="text-xs text-gray-400 mt-0.5">Start from a template</p>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-lg border-2 border-dashed border-gray-200 p-10 text-center">
        <div class="flex flex-col items-center gap-3">
          <div class="w-12 h-12 rounded-xl bg-indigo-50 grid place-items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
          </div>
          <p class="font-semibold">No ads yet</p>
          <p class="text-sm text-gray-500">Create your first ad to get started.</p>
          <%= link_to "New ad", new_ad_path, class: "rounded-md bg-indigo-600 px-2.5 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500" %>
        </div>
      </div>
    <% end %>
  </div>

  <%# Table view %>
  <div data-view-toggle-target="view" data-view="table" class="hidden">
    <% if @ads.any? %>
      <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-300">
            <thead>
              <tr>
                <th class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900">Ad</th>
                <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Campaign</th>
                <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Type</th>
                <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Layout</th>
                <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Theme</th>
                <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Updated</th>
                <th class="relative py-3.5 pl-3 pr-4"><span class="sr-only">Actions</span></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <% @ads.each do |ad| %>
                <tr class="hover:bg-gray-50 cursor-pointer" onclick="Turbo.visit('<%= ad_path(ad) %>')">
                  <td class="py-4 pl-4 pr-3">
                    <div class="flex items-center gap-3">
                      <div class="w-14 h-8 rounded flex-none overflow-hidden">
                        <div class="ad-canvas w-full h-full" style="background: var(--ad-bg); <%= ad_theme_style(ad.theme) %>"></div>
                      </div>
                      <span class="font-semibold text-sm"><%= ad.headline %></span>
                    </div>
                  </td>
                  <td class="px-3 py-4 text-sm text-gray-500">—</td>
                  <td class="px-3 py-4">
                    <span class="inline-flex items-center rounded-md bg-gray-50 px-1.5 py-0.5 text-[10.5px] font-medium text-gray-500 ring-1 ring-gray-500/10 ring-inset"><%= ad.adable_name.humanize %></span>
                  </td>
                  <td class="px-3 py-4 text-sm text-gray-500"><%= ad.layout.humanize %></td>
                  <td class="px-3 py-4 text-sm text-gray-500"><%= ad.theme.capitalize %></td>
                  <td class="px-3 py-4 text-xs text-gray-400"><%= time_ago_in_words(ad.updated_at) %> ago</td>
                  <td class="py-4 pl-3 pr-4 text-right">
                    <%= link_to edit_typed_ad_path(ad), class: "text-gray-400 hover:text-gray-600", onclick: "event.stopPropagation()" do %>
                      <svg viewBox="0 0 20 20" fill="currentColor" class="size-4"><path d="M2.695 14.763l-1.262 3.154a.5.5 0 00.65.65l3.155-1.262a4 4 0 001.343-.885L17.5 5.5a2.121 2.121 0 00-3-3L3.58 13.42a4 4 0 00-.885 1.343z"/></svg>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  </div>
</div>

<%= render "shared/pagination", pagy: @pagy %>
