<div class="mx-auto md:w-2/3 w-full">
  <div class="flex justify-between items-center mb-5">
    <h1 class="font-bold text-4xl"><%= @ad.headline %></h1>
    <div class="flex gap-2">
      <%= link_to "Preview", preview_ad_path(@ad), class: "rounded-md bg-indigo-600 px-2.5 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500", target: "_blank" %>
      <%= link_to "Edit", edit_ad_path(@ad), class: "text-sm font-semibold text-gray-600 hover:text-gray-900" %>
      <%= button_to "Delete", @ad, method: :delete, class: "rounded-md bg-white px-2 py-1 text-xs font-semibold text-red-600 shadow-xs ring-1 ring-red-300 ring-inset hover:bg-red-50",
          data: { turbo_confirm: "Are you sure?" } %>
    </div>
  </div>

  <% if @ad.body.present? %>
    <p class="text-gray-500 mb-4"><%= @ad.body %></p>
  <% end %>

  <% if @ad.listing %>
    <p class="text-gray-500">
      Listing: <%= link_to @ad.listing.address, listing_path(@ad.listing), class: "font-semibold text-indigo-600 hover:text-indigo-500" %>
    </p>
  <% end %>

  <%= turbo_frame_tag "playlist_ads", src: ad_playlist_ads_path(@ad) do %>
  <% end %>
</div>
