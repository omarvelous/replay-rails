<div class="mx-auto md:w-2/3 w-full">
  <div class="flex justify-between items-center mb-5">
    <h1 class="font-bold text-4xl"><%= @ad.headline %></h1>
    <div class="flex gap-2">
      <%= link_to "Preview", preview_ad_path(@ad), class: "btn btn-primary btn-sm", target: "_blank" %>
      <%= link_to "Edit", edit_ad_path(@ad), class: "btn btn-ghost btn-sm" %>
      <%= button_to "Delete", @ad, method: :delete, class: "btn btn-error btn-sm",
          data: { turbo_confirm: "Are you sure?" } %>
    </div>
  </div>

  <% if @ad.body.present? %>
    <p class="text-base-content/60 mb-4"><%= @ad.body %></p>
  <% end %>

  <% if @ad.listing %>
    <p class="text-base-content/60">
      Listing: <%= link_to @ad.listing.address, listing_path(@ad.listing), class: "link" %>
    </p>
  <% end %>

  <%= turbo_frame_tag "ad_playlists", src: playlist_ads_path(ad_id: @ad.id) do %>
  <% end %>
</div>
