<div class="ad-canvas aspect-video relative flex flex-col <%= ad.image.attached? ? 'justify-end' : 'justify-center' %>"
     style="background: var(--ad-bg); color: var(--ad-text); padding: var(--s-pad-lg); <%= ad_theme_style(ad.theme) %>">
  <% if ad.image.attached? %>
    <%= image_tag ad.image.variant(:preview), class: "absolute inset-0 w-full h-full object-cover" %>
    <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 60%);"></div>
  <% end %>
  <div class="relative">
    <%= render "ads/#{ad.adable_name.pluralize}/content", ad: ad %>
  </div>
  <div class="absolute rounded-xl grid place-items-center"
       style="right: var(--s-pad-lg); bottom: var(--s-pad-lg); width: var(--s-qr); height: var(--s-qr); background: var(--ad-surface); color: var(--ad-text-faint); font-size: var(--s-sm);">QR</div>
</div>
