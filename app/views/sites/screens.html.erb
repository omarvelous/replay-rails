<%= turbo_frame_tag "site_screens" do %>
  <h3 class="text-sm font-semibold mb-3">Screens at this site</h3>
  <% if @screens.any? %>
    <div class="flex flex-col gap-2.5">
      <% @screens.each do |screen| %>
        <% active_playlist = screen.screen_playlists.find { |sp| sp.active }&.playlist %>
        <div class="flex items-center gap-3 border border-gray-200 rounded-xl p-3 hover:border-gray-300 hover:bg-gray-50 transition-colors cursor-pointer">
          <div class="w-14 h-9 rounded-md bg-gray-900 flex-none flex items-center justify-center">
            <span class="text-white/20 text-[8px]">Preview</span>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold truncate"><%= screen.name %></p>
            <p class="text-xs text-gray-400"><%= active_playlist&.name || "No playlist" %></p>
          </div>
          <% if active_playlist %>
            <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-0.5 text-xs font-medium text-green-700 ring-1 ring-green-600/20 ring-inset">Live</span>
          <% else %>
            <span class="inline-flex items-center rounded-full bg-gray-50 px-2 py-0.5 text-xs font-medium text-gray-600 ring-1 ring-gray-500/10 ring-inset">Idle</span>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="border border-dashed border-gray-200 rounded-lg p-4 text-center text-sm text-gray-500">
      No screens at this site yet.
      <%= link_to "Add screen", new_screen_path(site_id: @site.id), class: "font-semibold text-indigo-600 hover:text-indigo-500", data: { turbo_frame: "modal" } %>
    </div>
  <% end %>
<% end %>
