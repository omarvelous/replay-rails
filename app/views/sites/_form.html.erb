<%= form_with model: site, class: "contents" do |form| %>
  <% if site.errors.any? %>
    <div role="alert" class="alert alert-error mb-4">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <div>
        <ul class="list-disc list-inside text-sm">
          <% site.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <fieldset class="fieldset mb-3">
    <%= form.label :name, "Site name", class: "fieldset-label" %>
    <%= form.text_field :name, required: true, autofocus: true, placeholder: "e.g. Main Office",
        class: "input input-bordered w-full" %>
  </fieldset>

  <fieldset class="fieldset mb-3">
    <%= form.label :address, "Street address", class: "fieldset-label" %>
    <%= form.text_field :address, placeholder: "123 Main St, New York, NY",
        class: "input input-bordered w-full" %>
  </fieldset>

  <div class="flex items-center justify-end gap-3 pt-4 mt-4 border-t border-base-200">
    <button type="button" class="btn" data-action="click->modal#close">Cancel</button>
    <%= form.submit site.persisted? ? "Save changes" : "Create site", class: "btn btn-primary" %>
  </div>
<% end %>
