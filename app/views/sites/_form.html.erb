<%= form_with model: site do |form| %>
  <% if site.errors.any? %>
    <div class="rounded-md bg-red-50 p-4 mb-4">
      <div class="flex">
        <div class="shrink-0">
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5 text-red-400"><path d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM8.28 7.22a.75.75 0 0 0-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 1 0 1.06 1.06L10 11.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L11.06 10l1.72-1.72a.75.75 0 0 0-1.06-1.06L10 8.94 8.28 7.22Z" clip-rule="evenodd" fill-rule="evenodd" /></svg>
        </div>
        <div class="ml-3">
          <ul class="list-disc list-inside text-sm text-red-700">
            <% site.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, "Site name", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :name, required: true, autofocus: true, placeholder: "e.g. Main Office",
        class: "block w-full rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" %>
  </div>

  <div class="mb-4">
    <%= form.label :address, "Street address", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :address, placeholder: "123 Main St, New York, NY",
        class: "block w-full rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" %>
  </div>

  <%# Photo %>
  <div class="mb-4">
    <%= form.label :photo, "Site photo", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <% if site.photo.attached? %>
      <div class="mb-2">
        <%= image_tag site.photo, class: "w-full h-32 object-cover rounded-lg" %>
      </div>
    <% end %>
    <label class="flex flex-col items-center justify-center gap-2 rounded-lg border-2 border-dashed border-gray-300 px-6 py-6 cursor-pointer hover:border-indigo-400 hover:bg-indigo-50 transition-colors">
      <%= form.file_field :photo, accept: "image/jpeg,image/png,image/webp", class: "sr-only" %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-6 text-gray-400"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0 0 22.5 18.75V5.25A2.25 2.25 0 0 0 20.25 3H3.75A2.25 2.25 0 0 0 1.5 5.25v13.5A2.25 2.25 0 0 0 3.75 21Z" /></svg>
      <span class="text-sm text-gray-500"><%= site.photo.attached? ? "Replace photo" : "Upload photo" %></span>
    </label>
  </div>

  <div class="flex items-center justify-between pt-4 border-t border-gray-200">
    <%= link_to "Cancel", site.persisted? ? site_path(site) : sites_path, class: "text-sm font-semibold text-gray-600 hover:text-gray-900" %>
    <%= form.submit site.persisted? ? "Save changes" : "Create site",
        class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500" %>
  </div>
<% end %>
