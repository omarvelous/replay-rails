<div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5">
  <div class="flex items-center justify-between p-4 border-b border-gray-200">
    <h3 class="text-sm font-semibold">Screens at this site</h3>
    <%= link_to new_screen_path(site_id: site.id), class: "rounded-md bg-indigo-600 px-2.5 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 inline-flex items-center gap-1.5" do %>
      <svg viewBox="0 0 20 20" fill="currentColor" class="size-4"><path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z"/></svg>
      Add screen
    <% end %>
  </div>

  <% if screens.any? %>
    <div class="divide-y divide-gray-100">
      <% screens.each do |screen| %>
        <% active_playlist = screen.screen_playlists.find { |sp| sp.active }&.playlist %>
        <%= link_to screen_path(screen), class: "flex items-center gap-3 px-4 py-3 hover:bg-gray-50 transition-colors" do %>
          <div class="w-14 h-9 rounded-md bg-gray-900 flex-none flex items-center justify-center">
            <span class="text-white/20 text-[8px]">Preview</span>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold truncate"><%= screen.name %></p>
            <p class="text-xs text-gray-400"><%= active_playlist&.name || "No playlist" %></p>
          </div>
          <% if active_playlist %>
            <span class="inline-flex items-center gap-1 rounded-full bg-green-50 px-2 py-0.5 text-xs font-medium text-green-700 ring-1 ring-green-600/20 ring-inset">
              <span class="size-1.5 rounded-full bg-green-500"></span>
              Live
            </span>
          <% else %>
            <span class="inline-flex items-center gap-1 rounded-full bg-gray-50 px-2 py-0.5 text-xs font-medium text-gray-600 ring-1 ring-gray-500/10 ring-inset">
              <span class="size-1.5 rounded-full bg-gray-400"></span>
              Idle
            </span>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="p-6 text-center">
      <p class="text-sm text-gray-500">No screens at this site yet.</p>
    </div>
  <% end %>
</div>
