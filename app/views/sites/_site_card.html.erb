<% tone = %w[#2f6bff #0fb5a6 #7c5cff #e8990f #1f9d57 #e5484d][site.id % 6] %>
<%= link_to site_path(site), class: "card bg-base-100 shadow-sm hover:shadow-md transition-shadow cursor-pointer group", data: { turbo_frame: "_top" } do %>
  <%# Tinted header %>
  <div class="h-28 rounded-t-[inherit] relative overflow-hidden" style="background: <%= tone %>14;">
    <div class="absolute inset-0" style="background: linear-gradient(150deg, <%= tone %>30, transparent 65%);"></div>
    <div class="absolute top-3 right-3">
      <span class="badge badge-sm badge-success"><%= site.screens.count %> screens</span>
    </div>
  </div>

  <div class="card-body p-4 gap-1">
    <h3 class="font-semibold text-base"><%= site.name %></h3>
    <% if site.address.present? %>
      <p class="text-xs text-base-content/50 flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
        <%= site.address %>
      </p>
    <% end %>

    <div class="flex items-center gap-4 mt-2 pt-2 border-t border-base-200 text-xs">
      <div>
        <span class="font-bold text-sm tabular-nums"><%= site.screens.count %></span>
        <span class="text-base-content/40 ml-1">Screens</span>
      </div>
    </div>
  </div>
<% end %>
