<%= turbo_frame_tag "drawer" do %>
<% tone = %w[#2f6bff #0fb5a6 #7c5cff #e8990f #1f9d57 #e5484d][@site.id % 6] %>

<%# Tinted hero header %>
<div class="flex-none relative overflow-hidden" style="min-height: 170px; background: <%= tone %>14;">
  <div class="absolute inset-0" style="background: linear-gradient(150deg, <%= tone %>30, transparent 65%);"></div>
  <div class="absolute top-3 left-3">
    <span class="badge badge-sm badge-neutral">Site</span>
  </div>
  <button class="absolute top-3 right-3 w-7 h-7 rounded-full grid place-items-center cursor-pointer bg-white/90"
          data-action="click->drawer#close">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
  </button>
</div>

<%# Head %>
<div class="flex-none px-6 pt-4 pb-4 border-b border-base-300">
  <h2 class="text-xl font-bold tracking-tight mb-0.5"><%= @site.name %></h2>
  <% if @site.address.present? %>
    <p class="text-xs text-base-content/40 flex items-center gap-1">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
      <%= @site.address %>
    </p>
  <% end %>
</div>

<%# Scrolling body %>
<div class="flex-1 overflow-y-auto min-h-0 px-6 py-5">
  <%# Stats %>
  <div class="grid grid-cols-3 gap-3 mb-5">
    <div class="bg-base-200/50 rounded-lg p-3 text-center">
      <p class="font-bold text-lg tabular-nums"><%= @site.screens.count %></p>
      <p class="text-xs text-base-content/40">Screens</p>
    </div>
    <div class="bg-base-200/50 rounded-lg p-3 text-center">
      <p class="font-bold text-lg tabular-nums text-success"><%= @site.screens.count %></p>
      <p class="text-xs text-base-content/40">Online</p>
    </div>
    <div class="bg-base-200/50 rounded-lg p-3 text-center">
      <p class="font-bold text-lg tabular-nums">0</p>
      <p class="text-xs text-base-content/40">Scans</p>
    </div>
  </div>

  <%# Screens at this site %>
  <h3 class="text-sm font-semibold mb-3">Screens at this site</h3>
  <% screens = @site.screens.includes(screen_playlists: :playlist).order(:name) %>
  <% if screens.any? %>
    <div class="flex flex-col gap-2">
      <% screens.each do |screen| %>
        <% active_playlist = screen.screen_playlists.find { |sp| sp.active }&.playlist %>
        <div class="flex items-center gap-3 p-2.5 rounded-lg border border-base-200 hover:border-base-300 hover:bg-base-200/50 transition-colors">
          <div class="w-14 h-9 rounded bg-neutral flex-none flex items-center justify-center">
            <span class="text-neutral-content/20 text-[8px]">Preview</span>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium truncate"><%= screen.name %></p>
            <p class="text-xs text-base-content/40"><%= active_playlist&.name || "No playlist" %></p>
          </div>
          <span class="badge badge-xs <%= active_playlist ? 'badge-success' : 'badge-neutral' %>">
            <%= active_playlist ? "Live" : "Idle" %>
          </span>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="border border-dashed border-base-300 rounded-lg p-4 text-center text-sm text-base-content/50">
      No screens at this site yet.
      <%= link_to "Add screen", new_screen_path(site_id: @site.id), class: "link link-primary", data: { turbo_frame: "modal" } %>
    </div>
  <% end %>
</div>

<%# Footer %>
<div class="flex-none px-6 py-3.5 border-t border-base-300 flex gap-3">
  <%= link_to screens_path(site_id: @site.id), class: "btn btn-sm flex-1", data: { turbo_frame: "_top" } do %>Manage screens<% end %>
  <%= link_to edit_site_path(@site), class: "btn btn-sm flex-1", data: { turbo_frame: "modal" } do %>Edit site<% end %>
</div>
<% end %>
