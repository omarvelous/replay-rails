<div class="mx-auto md:w-2/3 w-full">
  <div class="flex justify-between items-center mb-5">
    <h1 class="font-bold text-4xl"><%= @site.name %></h1>
    <div class="flex gap-2">
      <%= link_to "Edit", edit_site_path(@site), class: "btn btn-ghost btn-sm" %>
      <%= button_to "Delete", @site, method: :delete, class: "btn btn-error btn-sm",
          data: { turbo_confirm: "Are you sure?" } %>
    </div>
  </div>

  <% if @site.address.present? %>
    <p class="text-base-content/60 mb-5"><%= @site.address %></p>
  <% end %>

  <div class="flex justify-between items-center mb-3 mt-8">
    <h2 class="font-bold text-2xl">Screens</h2>
    <%= link_to "Add Screen", new_site_screen_path(@site), class: "btn btn-primary btn-sm" %>
  </div>

  <% if @site.screens.any? %>
    <div class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Orientation</th>
          </tr>
        </thead>
        <tbody>
          <% @site.screens.order(:name).each do |screen| %>
            <tr>
              <td><%= link_to screen.name, site_screen_path(@site, screen), class: "link" %></td>
              <td><%= screen.orientation.capitalize %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-base-content/60">No screens yet.</p>
  <% end %>
</div>
