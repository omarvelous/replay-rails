<%= turbo_frame_tag "drawer" do %>
<% tone = %w[#2f6bff #0fb5a6 #7c5cff #e8990f #1f9d57 #e5484d][@site.id % 6] %>
<% screen_count = @site.screens.count %>

<%# Tinted hero header — 170px per spec %>
<div class="flex-none relative overflow-hidden" style="height: 170px; background: <%= tone %>18;">
  <div class="absolute inset-0" style="background: linear-gradient(135deg, <%= tone %>30, transparent);"></div>
  <span class="absolute top-4 left-4 inline-flex items-center rounded-full bg-gray-900/8 px-2 py-0.5 text-xs font-medium text-gray-600 ring-1 ring-gray-500/10 ring-inset backdrop-blur-sm">Brokerage</span>
  <button class="absolute top-4 right-4 w-7 h-7 rounded-full grid place-items-center cursor-pointer bg-white/90 hover:bg-white transition-colors"
          data-action="click->drawer#close">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-4"><path d="M6 18 18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
</div>

<%# Head %>
<div class="flex-none px-6 pt-5 pb-5">
  <h2 class="text-[22px] font-bold tracking-tight mb-1"><%= @site.name %></h2>
  <% if @site.address.present? %>
    <p class="text-sm text-gray-400 flex items-center gap-1.5">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-3.5 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
      <%= @site.address %>
    </p>
  <% end %>
</div>

<%# Scrolling body %>
<div class="flex-1 overflow-y-auto min-h-0 px-6 pb-5">
  <%# StatCards with accent colors %>
  <div class="grid grid-cols-3 gap-3 mb-5">
    <div class="rounded-lg border border-gray-200 p-3">
      <div class="flex items-center gap-2 mb-2">
        <div class="size-7 rounded-md grid place-items-center" style="background: #2f6bff14; color: #2f6bff;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25h-13.5A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25"/></svg>
        </div>
      </div>
      <p class="text-xl font-bold tabular-nums"><%= screen_count %></p>
      <p class="text-xs text-gray-400">Screens</p>
    </div>
    <div class="rounded-lg border border-gray-200 p-3">
      <div class="flex items-center gap-2 mb-2">
        <div class="size-7 rounded-md grid place-items-center" style="background: #1f9d5714; color: #1f9d57;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M8.288 15.038a5.25 5.25 0 017.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M1.924 8.674c5.565-5.565 14.587-5.565 20.152 0M12.53 18.22l-.53.53-.53-.53a.75.75 0 011.06 0z"/></svg>
        </div>
      </div>
      <p class="text-xl font-bold tabular-nums text-green-600"><%= screen_count %>/<%= screen_count %></p>
      <p class="text-xs text-gray-400">Online</p>
    </div>
    <div class="rounded-lg border border-gray-200 p-3">
      <div class="flex items-center gap-2 mb-2">
        <div class="size-7 rounded-md grid place-items-center" style="background: #e8990f14; color: #e8990f;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 013.75 9.375v-4.5zM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 01-1.125-1.125v-4.5zM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0113.5 9.375v-4.5z"/></svg>
        </div>
      </div>
      <p class="text-xl font-bold tabular-nums">0</p>
      <p class="text-xs text-gray-400">Scans (mo)</p>
    </div>
  </div>

  <%# Screens at this site — lazy-loaded %>
  <%= turbo_frame_tag "site_screens", src: screens_site_path(@site), loading: :lazy %>
</div>

<%# Footer %>
<div class="flex-none px-6 py-3.5 border-t border-gray-200 flex gap-3">
  <%= link_to screens_path(site_id: @site.id), class: "rounded-md bg-white px-2.5 py-1.5 text-sm font-semibold text-gray-900 shadow-xs ring-1 ring-gray-300 ring-inset hover:bg-gray-50 flex-1 text-center", data: { turbo_frame: "_top" } do %>Manage screens<% end %>
  <%= link_to edit_site_path(@site), class: "rounded-md bg-white px-2.5 py-1.5 text-sm font-semibold text-gray-900 shadow-xs ring-1 ring-gray-300 ring-inset hover:bg-gray-50 flex-1 text-center", data: { turbo_frame: "modal" } do %>Edit site<% end %>
</div>
<% end %>
