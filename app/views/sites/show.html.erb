<div class="mx-auto md:w-2/3 w-full">
  <div class="flex justify-between items-center mb-5">
    <h1 class="font-bold text-4xl"><%= @site.name %></h1>
    <div class="flex gap-2">
      <%= link_to "Edit", edit_site_path(@site), class: "btn btn-ghost btn-sm" %>
      <%= button_to "Delete", @site, method: :delete, class: "btn btn-error btn-sm",
          data: { turbo_confirm: "Are you sure?" } %>
    </div>
  </div>

  <% if @site.address.present? %>
    <p class="text-base-content/60 mb-5"><%= @site.address %></p>
  <% end %>

  <%= turbo_frame_tag "site_screens", src: screens_path(site_id: @site.id) do %>
  <% end %>
</div>
