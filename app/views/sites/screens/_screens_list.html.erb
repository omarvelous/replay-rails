<div class="flex justify-between items-center mb-3 mt-8">
  <h2 class="font-bold text-2xl">Screens</h2>
  <%= link_to "Add Screen", new_site_screen_path(site), class: "btn btn-primary btn-sm", data: { turbo_frame: "modal" } %>
</div>

<% screens = site.screens.order(:name) %>
<% if screens.any? %>
  <div class="overflow-x-auto">
    <table class="table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Orientation</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% screens.each do |screen| %>
          <tr>
            <td><%= link_to screen.name, screen_path(screen), class: "link", data: { turbo_frame: "_top" } %></td>
            <td><%= screen.orientation.capitalize %></td>
            <td class="text-right">
              <%= link_to "Edit", edit_screen_path(screen), class: "link link-hover text-sm mr-2", data: { turbo_frame: "_top" } %>
              <%= button_to "Remove", screen_path(screen), method: :delete,
                  class: "btn btn-error btn-xs",
                  data: { turbo_confirm: "Remove this screen?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-base-content/60">No screens yet.</p>
<% end %>
