<% content_for(:page_title) { "Sites" } %>
<% content_for(:page_subtitle) { "#{@sites.size} locations · #{@sites.sum { |s| s.screens.count }} screens" } %>
<% content_for(:page_actions) do %>
  <%= link_to new_site_path, class: "rounded-md bg-indigo-600 px-2.5 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500", data: { turbo_frame: "modal" } do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
    New site
  <% end %>
<% end %>

<% if @sites.any? %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <% @sites.each do |site| %>
      <%= render "sites/site_card", site: site %>
    <% end %>

    <%= link_to new_site_path, class: "rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 border-2 border-dashed border-gray-200 hover:border-gray-400 transition-colors cursor-pointer flex items-center justify-center min-h-48", data: { turbo_frame: "modal" } do %>
      <div class="flex flex-col items-center gap-2 text-gray-400">
        <div class="w-10 h-10 rounded-lg bg-gray-100 grid place-items-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
        </div>
        <span class="text-sm font-medium">Add a site</span>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 border-2 border-dashed border-gray-200 p-10 text-center">
    <div class="flex flex-col items-center gap-3">
      <div class="w-12 h-12 rounded-xl bg-indigo-50 grid place-items-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
      </div>
      <p class="font-semibold">No sites yet</p>
      <p class="text-sm text-gray-500">Add your first location to get started.</p>
      <%= link_to "New site", new_site_path, class: "rounded-md bg-indigo-600 px-2.5 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500", data: { turbo_frame: "modal" } %>
    </div>
  </div>
<% end %>
