<div class="mx-auto md:w-2/3 w-full">
  <div class="flex justify-between items-center mb-5">
    <h1 class="font-bold text-4xl">Sites</h1>
    <%= link_to "New Site", new_site_path, class: "btn btn-primary btn-sm" %>
  </div>

  <% if @sites.any? %>
    <div class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Address</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @sites.each do |site| %>
            <tr>
              <td><%= link_to site.name, site, class: "link" %></td>
              <td><%= site.address %></td>
              <td class="text-right">
                <%= link_to "Edit", edit_site_path(site), class: "link link-hover text-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-base-content/60">No sites yet. Create your first site to get started.</p>
  <% end %>
</div>
