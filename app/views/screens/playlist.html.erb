<%= turbo_frame_tag "screen_playlist_info" do %>
  <h3 class="text-sm font-semibold mb-2">Playing now</h3>
  <% if @screen_playlist %>
    <% playlist = @screen_playlist.playlist %>
    <%= link_to playlist_path(playlist), class: "flex items-center gap-3 p-3 rounded-lg border border-gray-200 hover:bg-gray-50 transition-colors mb-4", data: { turbo_frame: "_top" } do %>
      <div class="w-9 h-9 rounded-lg flex-none grid place-items-center bg-indigo-50">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-4 text-indigo-600"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 010 3.75H5.625a1.875 1.875 0 010-3.75z"/></svg>
      </div>
      <div class="flex-1 min-w-0">
        <p class="font-semibold text-sm"><%= playlist.name %></p>
        <p class="text-xs text-gray-400"><%= playlist.playlist_ads.size %> items · <%= playlist.playlist_ads.sum(&:duration) %>s loop</p>
      </div>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-4 text-gray-400"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
    <% end %>
  <% else %>
    <div class="border border-dashed border-gray-200 rounded-lg p-4 text-center text-sm text-gray-500 mb-4">
      No playlist assigned. <%= link_to "Assign one", new_screen_screen_playlist_path(@screen), class: "font-semibold text-indigo-600 hover:text-indigo-500", data: { turbo_frame: "modal" } %>
    </div>
  <% end %>
<% end %>
