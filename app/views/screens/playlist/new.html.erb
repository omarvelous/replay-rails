<%= turbo_frame_tag "modal" do %>
  <h3 class="font-bold text-lg mb-4">Assign Playlist to <%= @screen.name %></h3>

  <%= form_with url: site_screen_playlist_path(@site, @screen), method: :post, class: "contents" do |form| %>
    <fieldset class="fieldset my-5">
      <%= form.label :playlist_id, "Playlist", class: "fieldset-label" %>
      <%= form.select :playlist_id,
          @playlists.map { |p| ["#{p.name} (#{p.playlist_ads.size} ads)", p.id] },
          { include_blank: "Select a playlist" },
          required: true, name: "screen_playlist[playlist_id]",
          class: "select select-bordered w-full" %>
    </fieldset>

    <div class="flex items-center gap-4">
      <%= form.submit "Assign Playlist", class: "btn btn-primary" %>
      <button type="button" class="link link-hover text-sm" data-action="click->modal#close">Cancel</button>
    </div>
  <% end %>
<% end %>
