<%= turbo_frame_tag "modal" do %>
  <h3 class="font-bold text-lg mb-4">Assign Playlist to <%= @screen.name %></h3>

  <%= form_with url: screen_playlist_path(@screen), method: :post do |form| %>
    <div class="my-5">
      <%= form.label :playlist_id, "Playlist", class: "block text-sm/6 font-medium text-gray-900" %>
      <%= form.select :playlist_id,
          @playlists.map { |p| ["#{p.name} (#{p.playlist_ads.size} ads)", p.id] },
          { include_blank: "Select a playlist" },
          required: true, name: "screen_playlist[playlist_id]",
          class: "block w-full rounded-md bg-white py-1.5 pl-3 pr-8 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
    </div>

    <div class="flex items-center gap-4">
      <%= form.submit "Assign Playlist", class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
      <button type="button" class="text-sm font-semibold text-gray-600 hover:text-gray-900" data-action="click->modal#close">Cancel</button>
    </div>
  <% end %>
<% end %>
