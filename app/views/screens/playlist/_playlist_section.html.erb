<% active_assignment = screen.screen_playlists.includes(:playlist).find_by(active: true) %>

<div class="flex justify-between items-center mb-3 mt-8">
  <h2 class="font-bold text-2xl">Playlist</h2>
  <% if active_assignment %>
    <%= link_to "Change", new_screen_playlist_path(screen), class: "text-sm font-semibold text-gray-600 hover:text-gray-900", data: { turbo_frame: "modal" } %>
  <% else %>
    <%= link_to "Assign Playlist", new_screen_playlist_path(screen), class: "rounded-md bg-indigo-600 px-2.5 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500", data: { turbo_frame: "modal" } %>
  <% end %>
</div>

<% if active_assignment %>
  <div class="flex items-center justify-between p-4 bg-gray-100 rounded-lg">
    <div>
      <p class="font-semibold"><%= link_to active_assignment.playlist.name, playlist_path(active_assignment.playlist), class: "font-semibold text-indigo-600 hover:text-indigo-500", data: { turbo_frame: "_top" } %></p>
      <p class="text-sm text-gray-500"><%= active_assignment.playlist.playlist_ads.size %> ads</p>
    </div>
    <%= button_to "Remove", screen_playlist_path(screen), method: :delete,
        class: "rounded-md bg-white px-2 py-1 text-xs font-semibold text-red-600 shadow-xs ring-1 ring-red-300 ring-inset hover:bg-red-50",
        data: { turbo_confirm: "Remove playlist from this screen?" } %>
  </div>
<% else %>
  <p class="text-gray-500">No playlist assigned to this screen.</p>
<% end %>
