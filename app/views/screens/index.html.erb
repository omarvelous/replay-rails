<% if current_site %>
  <%= turbo_frame_tag "site_screens" do %>
    <%= render "screens/screens_list", site: current_site %>
  <% end %>
<% else %>
  <% content_for(:page_title) { "Screens" } %>
  <% content_for(:page_subtitle) { "#{@screens.size} screens" } %>
  <% content_for(:page_actions) do %>
    <%= link_to new_screen_path, class: "rounded-md bg-indigo-600 px-2.5 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500", data: { turbo_frame: "modal" } do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
      Add screen
    <% end %>
  <% end %>

  <div data-controller="view-toggle">
    <div class="flex flex-wrap items-center gap-3 mb-5">
      <div class="flex-1 min-w-50 max-w-xs">
        <input type="text" placeholder="Search screens…" class="block w-full rounded-md bg-white px-3 py-1.5 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" />
      </div>

      <div class="flex gap-1">
        <button class="rounded-md bg-gray-100 px-2 py-1 text-xs font-semibold text-gray-900 shadow-xs ring-1 ring-gray-300 ring-inset hover:bg-gray-50">All</button>
        <button class="rounded-md bg-white px-2 py-1 text-xs font-semibold text-gray-900 shadow-xs ring-1 ring-gray-300 ring-inset hover:bg-gray-50">Live</button>
        <button class="rounded-md bg-white px-2 py-1 text-xs font-semibold text-gray-900 shadow-xs ring-1 ring-gray-300 ring-inset hover:bg-gray-50">Issues</button>
      </div>

      <span class="ml-auto isolate inline-flex rounded-md shadow-xs">
        <button class="relative inline-flex items-center rounded-l-md bg-white px-2 py-1.5 text-gray-400 ring-1 ring-gray-300 ring-inset hover:bg-gray-50" data-view-btn data-view="grid" data-action="click->view-toggle#switch">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"/></svg>
        </button>
        <button class="relative -ml-px inline-flex items-center rounded-r-md bg-white px-2 py-1.5 text-gray-400 ring-1 ring-gray-300 ring-inset hover:bg-gray-50" data-view-btn data-view="table" data-action="click->view-toggle#switch">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 5.25h16.5m-16.5 4.5h16.5m-16.5 4.5h16.5m-16.5 4.5h16.5"/></svg>
        </button>
      </span>
    </div>

    <%# Grid view %>
    <div data-view-toggle-target="view" data-view="grid">
      <% if @screens.any? %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
          <% @screens.includes(:site, screen_playlists: :playlist).each do |screen| %>
            <% active_playlist = screen.screen_playlists.find { |sp| sp.active }&.playlist %>
            <%= link_to screen_path(screen), class: "rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 hover:shadow-md transition-shadow cursor-pointer", data: { turbo_frame: "drawer" } do %>
              <%# Preview placeholder %>
              <div class="aspect-video bg-gray-900 rounded-t-lg flex items-center justify-center relative">
                <% if active_playlist %>
                  <span class="text-white/30 text-xs">Preview</span>
                  <div class="absolute top-2 right-2">
                    <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-green-600/20 ring-inset">Live</span>
                  </div>
                <% else %>
                  <span class="text-white/20 text-2xl">—</span>
                  <div class="absolute top-2 right-2">
                    <span class="inline-flex items-center rounded-full bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-gray-500/10 ring-inset">Idle</span>
                  </div>
                <% end %>
              </div>
              <div class="p-3">
                <div class="flex items-center gap-2">
                  <span class="font-semibold text-sm truncate"><%= screen.name %></span>
                  <span class="inline-flex items-center rounded-md bg-gray-50 px-1.5 py-0.5 text-xs font-medium text-gray-600 ring-1 ring-gray-500/10 ring-inset"><%= screen.orientation.capitalize %></span>
                </div>
                <p class="text-xs text-gray-400"><%= screen.site.name %></p>
                <% if active_playlist %>
                  <p class="text-xs text-gray-500 mt-1 flex items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 010 3.75H5.625a1.875 1.875 0 010-3.75z"/></svg>
                    <%= active_playlist.name %>
                  </p>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 border-2 border-dashed border-gray-200 p-10 text-center">
          <div class="flex flex-col items-center gap-3">
            <div class="w-12 h-12 rounded-xl bg-indigo-50 grid place-items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
            </div>
            <p class="font-semibold">No screens yet</p>
            <p class="text-sm text-gray-500">Add a screen to start displaying content.</p>
            <%= link_to "Add screen", new_screen_path, class: "rounded-md bg-indigo-600 px-2.5 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500", data: { turbo_frame: "modal" } %>
          </div>
        </div>
      <% end %>
    </div>

    <%# Table view %>
    <div data-view-toggle-target="view" data-view="table" class="hidden">
      <% if @screens.any? %>
        <div class="rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5">
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-300">
              <thead>
                <tr>
                  <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Screen</th>
                  <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Site</th>
                  <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Orientation</th>
                  <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Playlist</th>
                  <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Status</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200">
                <% @screens.includes(:site, screen_playlists: :playlist).each do |screen| %>
                  <% active_playlist = screen.screen_playlists.find { |sp| sp.active }&.playlist %>
                  <tr class="hover:bg-gray-50">
                    <td class="px-3 py-4 font-medium text-sm"><%= link_to screen.name, screen_path(screen), data: { turbo_frame: "drawer" }, class: "text-sm text-gray-600 hover:text-gray-900" %></td>
                    <td class="px-3 py-4 text-sm"><%= screen.site.name %></td>
                    <td class="px-3 py-4"><span class="inline-flex items-center rounded-md bg-gray-50 px-1.5 py-0.5 text-xs font-medium text-gray-600 ring-1 ring-gray-500/10 ring-inset"><%= screen.orientation.capitalize %></span></td>
                    <td class="px-3 py-4 text-sm text-gray-500"><%= active_playlist&.name || "—" %></td>
                    <td class="px-3 py-4">
                      <% if active_playlist %>
                        <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-green-600/20 ring-inset">Live</span>
                      <% else %>
                        <span class="inline-flex items-center rounded-full bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-gray-500/10 ring-inset">Idle</span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
