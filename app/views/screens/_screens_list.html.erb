<div class="flex justify-between items-center mb-3 mt-8">
  <h2 class="font-bold text-2xl">Screens</h2>
  <%= link_to "Add Screen", new_screen_path(site_id: site.id), class: "rounded-md bg-indigo-600 px-2.5 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500", data: { turbo_frame: "modal" } %>
</div>

<% screens = site.screens.order(:name) %>
<% if screens.any? %>
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-300">
      <thead>
        <tr>
          <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Name</th>
          <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Orientation</th>
          <th class="px-3 py-3.5 text-right text-sm font-semibold text-gray-900"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% screens.each do |screen| %>
          <tr>
            <td class="px-3 py-4"><%= link_to screen.name, screen_path(screen), class: "font-semibold text-indigo-600 hover:text-indigo-500", data: { turbo_frame: "_top" } %></td>
            <td class="px-3 py-4"><%= screen.orientation.capitalize %></td>
            <td class="px-3 py-4 text-right">
              <%= link_to "Edit", edit_screen_path(screen), class: "text-sm text-gray-600 hover:text-gray-900 mr-2", data: { turbo_frame: "_top" } %>
              <%= button_to "Remove", screen_path(screen), method: :delete,
                  class: "rounded-md bg-white px-2 py-1 text-xs font-semibold text-red-600 shadow-xs ring-1 ring-red-300 ring-inset hover:bg-red-50",
                  data: { turbo_confirm: "Remove this screen?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-gray-500">No screens yet.</p>
<% end %>
