<div class="mx-auto md:w-2/3 w-full">
  <div class="flex justify-between items-center mb-5">
    <h1 class="font-bold text-4xl"><%= @screen.name %></h1>
    <div class="flex gap-2">
      <%= link_to "Edit", edit_site_screen_path(@site, @screen), class: "btn btn-ghost btn-sm" %>
      <%= button_to "Delete", site_screen_path(@site, @screen), method: :delete, class: "btn btn-error btn-sm",
          data: { turbo_confirm: "Are you sure?" } %>
    </div>
  </div>

  <p class="text-base-content/60">Orientation: <%= @screen.orientation.capitalize %></p>
  <p class="text-base-content/60">Site: <%= link_to @site.name, site_path(@site), class: "link" %></p>

  <h2 class="font-bold text-2xl mb-3 mt-8">Assigned Playlists</h2>

  <% if @screen.playlists.any? %>
    <div class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Status</th>
            <th>Ads</th>
          </tr>
        </thead>
        <tbody>
          <% @screen.playlists.each do |playlist| %>
            <tr>
              <td><%= link_to playlist.name, playlist_path(playlist), class: "link" %></td>
              <td>
                <span class="badge badge-<%= playlist.status == 'published' ? 'success' : 'ghost' %>">
                  <%= playlist.status.capitalize %>
                </span>
              </td>
              <td><%= playlist.playlist_ads.size %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-base-content/60">No playlists assigned. Edit to assign playlists.</p>
  <% end %>
</div>
