<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <title><%= content_for?(:title) ? "#{content_for(:title)} — RePlay" : "RePlay — Digital Signage for Real Estate" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen" style="background: var(--m-bg);">
    <nav style="border-bottom: 1px solid var(--m-surface-border);">
      <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
          <span class="flex size-8 items-center justify-center rounded-lg bg-linear-to-br from-indigo-500 to-teal-400">
            <svg viewBox="0 0 24 24" fill="none" class="size-4"><path d="M8 6.5v11l9-5.5-9-5.5z" fill="#fff"/></svg>
          </span>
          <span class="text-lg font-bold tracking-tight" style="color: var(--m-text);">Re<b style="color: var(--m-accent);">Play</b></span>
        </a>
        <div class="hidden md:flex items-center gap-6">
          <%= link_to "Features", "/features", class: "text-sm font-medium hover:opacity-80", style: "color: var(--m-text-muted);" %>
          <%= link_to "Pricing", "/pricing", class: "text-sm font-medium hover:opacity-80", style: "color: var(--m-text-muted);" %>
          <%= link_to "About", "/about", class: "text-sm font-medium hover:opacity-80", style: "color: var(--m-text-muted);" %>
          <%= link_to "Log in", new_session_url(subdomain: "app"), class: "text-sm font-medium hover:opacity-80", style: "color: var(--m-text-muted);" %>
          <a href="/demo" style="background: var(--m-cta-bg); color: var(--m-cta-text); border-radius: var(--m-radius);"
             class="px-3.5 py-2 text-sm font-semibold shadow-xs hover:opacity-90 transition-opacity">Book a demo</a>
        </div>
      </div>
    </nav>

    <%= yield %>

    <footer style="border-top: 1px solid var(--m-surface-border); background: var(--m-bg-alt);" class="mt-20">
      <div class="max-w-6xl mx-auto px-6 py-12">
        <div class="flex items-center justify-between">
          <span class="text-lg font-bold tracking-tight" style="color: var(--m-text);">Re<b style="color: var(--m-accent);">Play</b></span>
          <p class="text-xs" style="color: var(--m-text-faint);">&copy; <%= Date.current.year %> RePlay. All rights reserved.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
