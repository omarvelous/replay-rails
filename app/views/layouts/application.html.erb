<!DOCTYPE html>
<html data-theme="light">
  <head>
    <title><%= content_for(:title) || "RePlay" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-base-200">
    <% if authenticated? %>
      <div class="drawer lg:drawer-open">
        <input id="app-drawer" type="checkbox" class="drawer-toggle" />

        <%# Main content area — wraps a right-side drawer for detail slide-overs %>
        <div class="drawer-content flex flex-col min-h-screen">
          <%= render "shared/topbar" %>

          <div class="drawer drawer-end flex-1" data-controller="drawer">
            <input id="detail-drawer" type="checkbox" class="drawer-toggle" data-drawer-target="toggle" />

            <main class="drawer-content p-6">
              <div id="flash">
                <%= render "shared/flash" %>
              </div>

              <div class="mx-auto max-w-5xl">
                <%= yield %>
              </div>
            </main>

            <div class="drawer-side z-20">
              <label for="detail-drawer" aria-label="close detail" class="drawer-overlay"></label>
              <div class="bg-base-100 min-h-full flex flex-col" style="width: min(580px, 100%);">
                <%= turbo_frame_tag "drawer" %>
              </div>
            </div>
          </div>
        </div>

        <%# Left sidebar %>
        <div class="drawer-side z-30">
          <%= render "shared/sidebar" %>
        </div>
      </div>
    <% else %>
      <main class="min-h-screen flex items-center justify-center p-5">
        <div class="w-full max-w-md">
          <div id="flash">
            <%= render "shared/flash" %>
          </div>

          <%= yield %>
        </div>
      </main>
    <% end %>

    <%# Centered modal %>
    <dialog class="modal" data-controller="modal" data-modal-target="dialog">
      <div class="modal-box max-w-2xl">
        <%= turbo_frame_tag "modal" %>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button>close</button>
      </form>
    </dialog>
  </body>
</html>
