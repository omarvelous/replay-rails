<!DOCTYPE html>
<html data-theme="light">
  <head>
    <title><%= content_for(:title) || "RePlay" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-base-200">
    <% if authenticated? %>
      <div class="drawer lg:drawer-open">
        <input id="app-drawer" type="checkbox" class="drawer-toggle" />

        <%# Main content area %>
        <div class="drawer-content flex flex-col min-h-screen">
          <%= render "shared/topbar" %>

          <main class="flex-1 p-6">
            <div id="flash">
              <%= render "shared/flash" %>
            </div>

            <div class="mx-auto max-w-5xl">
              <%= yield %>
            </div>
          </main>
        </div>

        <%# Left sidebar %>
        <div class="drawer-side z-30">
          <%= render "shared/sidebar" %>
        </div>
      </div>
    <% else %>
      <main class="min-h-screen flex items-center justify-center p-5">
        <div class="w-full max-w-md">
          <div id="flash">
            <%= render "shared/flash" %>
          </div>

          <%= yield %>
        </div>
      </main>
    <% end %>

    <%# Right slide-over drawer (detail panels) %>
    <div data-controller="drawer">
      <%# Backdrop %>
      <div class="fixed inset-0 bg-black/50 hidden" style="z-index: 9998;" data-drawer-target="backdrop" data-action="click->drawer#close"></div>
      <%# Panel %>
      <div class="fixed inset-y-0 right-0 w-full bg-base-100 shadow-2xl flex flex-col translate-x-full transition-transform duration-200 ease-out" style="z-index: 9999; max-width: 580px;" data-drawer-target="panel">
        <%= turbo_frame_tag "drawer" %>
      </div>
    </div>

    <%# Centered modal %>
    <dialog class="modal" data-controller="modal" data-modal-target="dialog">
      <div class="modal-box max-w-2xl">
        <%= turbo_frame_tag "modal" %>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button>close</button>
      </form>
    </dialog>
  </body>
</html>
