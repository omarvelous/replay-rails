<!DOCTYPE html>
<html class="h-full bg-gray-100">
  <head>
    <title><%= content_for(:title) || "RePlay" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <script src="https://cdn.jsdelivr.net/npm/@tailwindplus/elements@1" type="module"></script>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full">
    <% if authenticated? %>
      <%# Mobile sidebar dialog %>
      <el-dialog>
        <dialog id="mobile-sidebar" class="backdrop:bg-transparent lg:hidden">
          <el-dialog-backdrop class="fixed inset-0 bg-gray-900/80 transition-opacity duration-300 ease-linear data-closed:opacity-0"></el-dialog-backdrop>
          <div tabindex="0" class="fixed inset-0 flex focus:outline-none">
            <el-dialog-panel class="group/dialog-panel relative mr-16 flex w-full max-w-xs flex-1 transform transition duration-300 ease-in-out data-closed:-translate-x-full">
              <div class="absolute top-0 left-full flex w-16 justify-center pt-5 duration-300 ease-in-out group-data-closed/dialog-panel:opacity-0">
                <button type="button" command="close" commandfor="mobile-sidebar" class="-m-2.5 p-2.5">
                  <span class="sr-only">Close sidebar</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="size-6 text-white"><path d="M6 18 18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </button>
              </div>
              <%= render "shared/sidebar" %>
            </el-dialog-panel>
          </div>
        </dialog>
      </el-dialog>

      <%# Static sidebar for desktop %>
      <div class="hidden lg:fixed lg:inset-y-0 lg:z-50 lg:flex lg:w-72 lg:flex-col">
        <%= render "shared/sidebar" %>
      </div>

      <%# Mobile topbar %>
      <div class="sticky top-0 z-40 flex items-center gap-x-6 bg-gray-900 px-4 py-4 shadow-sm sm:px-6 lg:hidden">
        <button type="button" command="show-modal" commandfor="mobile-sidebar" class="-m-2.5 p-2.5 text-gray-400 hover:text-white">
          <span class="sr-only">Open sidebar</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="size-6"><path d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <div class="flex-1 text-sm/6 font-semibold text-white">
          <%= content_for?(:page_title) ? yield(:page_title) : controller_name.titleize %>
        </div>
      </div>

      <%# Main content %>
      <main class="lg:pl-72">
        <%# Desktop topbar %>
        <div class="sticky top-0 z-40 hidden lg:flex items-center justify-between border-b border-gray-200 bg-white/80 backdrop-blur-sm px-6 py-3">
          <div class="flex items-baseline gap-3 min-w-0">
            <h1 class="text-lg font-semibold text-gray-900 whitespace-nowrap">
              <%= content_for?(:page_title) ? yield(:page_title) : controller_name.titleize %>
            </h1>
            <% if content_for?(:page_subtitle) %>
              <span class="text-sm text-gray-500 whitespace-nowrap overflow-hidden text-ellipsis"><%= yield(:page_subtitle) %></span>
            <% end %>
          </div>
          <div class="flex items-center gap-3">
            <% if content_for?(:page_actions) %>
              <%= yield(:page_actions) %>
            <% end %>
          </div>
        </div>

        <div class="px-4 py-6 sm:px-6 lg:px-8">
          <div id="flash">
            <%= render "shared/flash" %>
          </div>
          <div class="mx-auto max-w-5xl">
            <%= yield %>
          </div>
        </div>
      </main>
    <% else %>
      <main class="min-h-screen flex items-center justify-center p-5 bg-gray-50">
        <div class="w-full max-w-md">
          <div id="flash">
            <%= render "shared/flash" %>
          </div>
          <%= yield %>
        </div>
      </main>
    <% end %>

    <%# Right slide-over drawer %>
    <el-dialog>
      <dialog id="detail-drawer" class="backdrop:bg-transparent" data-controller="drawer" data-drawer-target="dialog">
        <el-dialog-backdrop class="fixed inset-0 bg-gray-500/75 transition-opacity duration-500 ease-in-out data-closed:opacity-0"></el-dialog-backdrop>
        <div tabindex="0" class="fixed inset-0 overflow-hidden focus:outline-none">
          <el-dialog-panel class="ml-auto block size-full max-w-xl transform transition duration-500 ease-in-out data-closed:translate-x-full">
            <div class="relative flex h-full flex-col overflow-y-auto bg-white shadow-xl">
              <%= turbo_frame_tag "drawer" %>
            </div>
          </el-dialog-panel>
        </div>
      </dialog>
    </el-dialog>

    <%# Centered modal %>
    <el-dialog>
      <dialog id="app-modal" class="backdrop:bg-transparent" data-controller="modal" data-modal-target="dialog">
        <el-dialog-backdrop class="fixed inset-0 bg-gray-500/75 transition-opacity duration-300 ease-out data-closed:opacity-0 data-closed:ease-in"></el-dialog-backdrop>
        <div tabindex="0" class="fixed inset-0 z-10 overflow-y-auto focus:outline-none">
          <div class="flex min-h-full items-center justify-center p-4">
            <el-dialog-panel class="relative w-full max-w-2xl transform rounded-xl bg-white p-6 shadow-xl transition-all duration-300 ease-out data-closed:scale-95 data-closed:opacity-0">
              <%= turbo_frame_tag "modal" %>
            </el-dialog-panel>
          </div>
        </div>
      </dialog>
    </el-dialog>
  </body>
</html>
