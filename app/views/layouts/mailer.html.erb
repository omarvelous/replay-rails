<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
      /* Reset */
      body, table, td, p, a, li { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
      table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
      body { margin: 0; padding: 0; width: 100% !important; }

      /* Layout */
      .email-wrapper { background-color: #f4f4f5; padding: 32px 16px; }
      .email-container { max-width: 600px; margin: 0 auto; }
      .email-header { padding: 24px 32px 16px; text-align: left; }
      .email-body { background-color: #ffffff; border-radius: 8px; padding: 32px; }
      .email-footer { padding: 24px 32px; text-align: center; }

      /* Typography */
      body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; }
      h1 { font-size: 22px; font-weight: 700; color: #111827; margin: 0 0 16px; line-height: 1.3; }
      h2 { font-size: 18px; font-weight: 600; color: #111827; margin: 0 0 12px; line-height: 1.3; }
      p { font-size: 15px; line-height: 1.6; color: #374151; margin: 0 0 16px; }
      .text-sm { font-size: 13px; }
      .text-muted { color: #6b7280; }
      .text-faint { color: #9ca3af; font-size: 12px; }

      /* Logo */
      .logo { font-size: 18px; font-weight: 800; color: #111827; text-decoration: none; letter-spacing: -0.025em; }

      /* Buttons */
      .btn { display: inline-block; background-color: #4f46e5; color: #ffffff !important; padding: 12px 28px; border-radius: 6px; text-decoration: none; font-size: 14px; font-weight: 600; }

      /* Tables */
      .info-table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
      .info-table td { padding: 8px 0; font-size: 14px; vertical-align: top; }
      .info-table .label { color: #6b7280; font-size: 13px; width: 100px; }
      .info-table .value { font-weight: 600; color: #111827; }

      /* Utility */
      .callout { background-color: #f9fafb; border-radius: 8px; padding: 16px; margin-bottom: 20px; }
      .callout-label { margin: 0 0 4px; font-size: 12px; color: #6b7280; text-transform: uppercase; letter-spacing: 0.05em; }
      .divider { border: none; border-top: 1px solid #e5e7eb; margin: 24px 0; }
      a { color: #4f46e5; }

      /* Footer */
      .footer-text { font-size: 12px; color: #9ca3af; line-height: 1.5; margin: 0; }
      .footer-text a { color: #9ca3af; text-decoration: underline; }
    </style>
  </head>

  <body>
    <div class="email-wrapper">
      <div class="email-container">
        <div class="email-header">
          <a href="https://replaytv.co" class="logo">RePlay</a>
        </div>

        <div class="email-body">
          <%= yield %>
        </div>

        <div class="email-footer">
          <p class="footer-text">
            RePlay &mdash; Digital signage for real estate<br>
            <a href="https://replaytv.co">replaytv.co</a>
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
