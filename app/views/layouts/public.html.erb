<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <title>RePlay</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>

  <body class="bg-gray-50 min-h-screen">
    <div class="max-w-lg mx-auto px-4 py-8">
      <%= yield %>
    </div>

    <footer class="max-w-lg mx-auto px-4 pb-8 text-center">
      <p class="text-xs text-gray-400">Powered by <span class="font-semibold text-gray-500">RePlay</span></p>
    </footer>
  </body>
</html>
