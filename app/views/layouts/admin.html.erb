<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <title>RePlay Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 min-h-screen">
    <nav class="bg-gray-900 text-white">
      <div class="max-w-7xl mx-auto px-6 py-3 flex items-center justify-between">
        <div class="flex items-center gap-6">
          <a href="<%= admin_root_path %>" class="font-bold flex items-center gap-2">
            RePlay <span class="text-[10px] bg-red-500 px-1.5 py-0.5 rounded font-semibold uppercase tracking-wider">Admin</span>
          </a>
        </div>
        <div class="flex items-center gap-4">
          <%= link_to "App", app_root_url(subdomain: "app"), class: "text-sm text-gray-400 hover:text-white" %>
          <span class="text-sm text-gray-400"><%= Current.user&.email_address %></span>
        </div>
      </div>
      <div class="max-w-7xl mx-auto px-6 pb-2 flex items-center gap-1 text-sm overflow-x-auto">
        <% nav_items = [
          ["Dashboard", admin_root_path, "dashboard"],
          ["Accounts", admin_accounts_path, "accounts"],
          ["Users", admin_users_path, "users"],
          ["Sites", admin_sites_path, "sites"],
          ["Screens", admin_screens_path, "screens"],
          ["Players", admin_players_path, "players"],
          ["Listings", admin_listings_path, "listings"],
          ["Agents", admin_agents_path, "agents"],
          ["Ads", admin_ads_path, "ads"],
          ["Playlists", admin_playlists_path, "playlists"],
          ["QR Codes", admin_qr_codes_path, "qr_codes"],
          ["Scans", admin_qr_scans_path, "qr_scans"],
          ["Leads", admin_leads_path, "leads"],
          ["Invites", admin_invites_path, "invites"],
        ] %>
        <% nav_items.each do |label, path, cn| %>
          <%= link_to label, path, class: "px-2.5 py-1 rounded-md font-medium #{controller_name == cn ? 'bg-white/10 text-white' : 'text-gray-400 hover:text-white hover:bg-white/5'}" %>
        <% end %>
      </div>
    </nav>

    <div class="max-w-7xl mx-auto px-6 py-8">
      <%= yield %>
    </div>
  </body>
</html>
